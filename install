#!/usr/bin/env bash
# ============================================================
#  Gathm Enterprise - Universal Installer
#  Works on: Linux (all distros), macOS, WSL, Git Bash
#
#  Usage:
#    ./install              # Auto-detect platform & install
#    ./install --check      # Just verify environment
#    ./install --uninstall  # Remove symlinks & data
# ============================================================

set -euo pipefail
# ERR trap: print the exact line that caused set -e to fire.
# Helps diagnose silent aborts.  Printed to stderr so it shows even when
# stdout is redirected.
trap 'echo "[INSTALL ABORT] Line $LINENO exited with code $?" >&2' ERR

VERSION="3.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$LOCAL_BIN" 2>/dev/null || true
export PATH="$LOCAL_BIN:$PATH"

# --- Colors (skip on dumb terminals) ---
if [[ "${TERM:-dumb}" != "dumb" ]]; then
    RED="\033[31m"; GREEN="\033[32m"; YELLOW="\033[33m"
    BLUE="\033[34m"; CYAN="\033[36m"; BOLD="\033[1m"; RESET="\033[0m"
else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""; BOLD=""; RESET=""
fi

info()  { echo -e "${BLUE}[*]${RESET} $1"; }
ok()    { echo -e "${GREEN}[+]${RESET} $1"; }
warn()  { echo -e "${YELLOW}[!]${RESET} $1"; }
fail()  { echo -e "${RED}[-]${RESET} $1"; }

# ── Progress reporting ───────────────────────────────────────────────
# Each top-level install phase calls `step_begin LABEL` and ends with
# step_done / step_skip / step_fail. We track every step so we can
# print a summary at the end and show the user where they are in the
# overall flow ("[Step 6/11] Installing Ollama..."). Without this,
# long silent steps (Ollama download, apt update) look frozen.
#
# Indexed arrays only — macOS still ships bash 3.2 without assoc arrays.
_GATHM_TOTAL_STEPS=11
_GATHM_STEP_IDX=0
_GATHM_STEP_LABELS=()
_GATHM_STEP_STATES=()
_GATHM_STEP_ELAPSED=()
_GATHM_STEP_T0=0

# Optional components that are missing or degraded. verify() fills this and
# prints a "Still missing" section so nothing important is lost in scrollback
# (e.g. a numpy compile failure or an un-pulled Ollama model on Termux).
# Each entry is "component|how to fix".
_GATHM_MISSING=()
note_missing() { _GATHM_MISSING+=("$1|$2"); }

# Format integer seconds as "Xm YYs" or "Ys"
_format_elapsed() {
    local s=$1
    if (( s >= 60 )); then
        printf '%dm %02ds' $(( s / 60 )) $(( s % 60 ))
    else
        printf '%ds' "$s"
    fi
}

# Mark a step as starting and print a clear header. Always print a
# header so even silent steps reveal where the script is currently working.
step_begin() {
    local label="$1"
    _GATHM_STEP_IDX=$((_GATHM_STEP_IDX + 1))
    _GATHM_STEP_LABELS[$((_GATHM_STEP_IDX - 1))]="$label"
    _GATHM_STEP_STATES[$((_GATHM_STEP_IDX - 1))]="running"
    _GATHM_STEP_ELAPSED[$((_GATHM_STEP_IDX - 1))]=""
    _GATHM_STEP_T0=$SECONDS
    echo ""
    echo -e "${BOLD}${CYAN}━━ [Step ${_GATHM_STEP_IDX}/${_GATHM_TOTAL_STEPS}] ${label} ━━${RESET}"
}

_step_finalize() {
    local state="$1"
    local idx=$(( _GATHM_STEP_IDX - 1 ))
    local elapsed=$(( SECONDS - _GATHM_STEP_T0 ))
    _GATHM_STEP_STATES[$idx]="$state"
    _GATHM_STEP_ELAPSED[$idx]=$(_format_elapsed "$elapsed")
}

step_done() {
    _step_finalize "done"
    local idx=$(( _GATHM_STEP_IDX - 1 ))
    ok "${1:-Done} ${YELLOW}(${_GATHM_STEP_ELAPSED[$idx]})${RESET}"
}
step_skip() {
    _step_finalize "skipped"
    warn "${1:-Skipped}"
}
step_fail() {
    _step_finalize "failed"
    local idx=$(( _GATHM_STEP_IDX - 1 ))
    fail "${1:-Failed} ${YELLOW}(${_GATHM_STEP_ELAPSED[$idx]})${RESET}"
}

# Print a final summary table of every step run.
step_summary() {
    local n=${#_GATHM_STEP_LABELS[@]}
    (( n == 0 )) && return 0
    echo ""
    echo -e "${BOLD}Install summary${RESET}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    local i icon color
    for (( i = 0; i < n; i++ )); do
        case "${_GATHM_STEP_STATES[$i]}" in
            done)    icon="✓"; color="$GREEN" ;;
            failed)  icon="✗"; color="$RED" ;;
            skipped) icon="–"; color="$YELLOW" ;;
            *)       icon="?"; color="$RESET" ;;
        esac
        printf '  %b%s%b  %-44s  %b%s%b\n' \
            "$color" "$icon" "$RESET" \
            "${_GATHM_STEP_LABELS[$i]}" \
            "$YELLOW" "${_GATHM_STEP_ELAPSED[$i]:-—}" "$RESET"
    done
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

# Run a command with a live spinner that shows elapsed time + the
# latest log line. Useful for silent operations (apt update, pip install)
# where suppressing output otherwise makes the script look frozen.
#
# Usage:  run_with_spinner "Installing pilot deps" -- pip install -r req.txt
# Returns the command's exit status. On failure, prints the last 10 log lines.
# Falls back to plain `info; cmd` when stdout is not a TTY.
_SPINNER_FRAMES='|/-\'
run_with_spinner() {
    local label="$1"; shift
    [[ "${1:-}" == "--" ]] && shift

    if [[ ! -t 1 ]] || [[ "${TERM:-dumb}" == "dumb" ]]; then
        info "$label..."
        "$@"
        return $?
    fi

    local log_file
    log_file=$(mktemp 2>/dev/null) || log_file="/tmp/gathm-spinner.$$"

    ( "$@" ) >"$log_file" 2>&1 &
    local cmd_pid=$!

    local t0=$SECONDS frame_i=0 frame_count=${#_SPINNER_FRAMES}
    while kill -0 "$cmd_pid" 2>/dev/null; do
        local frame=${_SPINNER_FRAMES:$(( frame_i % frame_count )):1}
        local elapsed=$(( SECONDS - t0 ))
        local last_line
        last_line=$(tail -n 1 "$log_file" 2>/dev/null \
            | tr -cd '\11\12\15\40-\176' | tr '\r' ' ' | head -c 70)
        printf '\r\033[2K  %b%s%b %s %b[%s]%b %b%s%b' \
            "$CYAN" "$frame" "$RESET" \
            "$label" \
            "$YELLOW" "$(_format_elapsed $elapsed)" "$RESET" \
            "$BLUE" "${last_line:- }" "$RESET"
        sleep 0.2
        frame_i=$((frame_i + 1))
    done

    wait "$cmd_pid" 2>/dev/null
    local rc=$?
    printf '\r\033[2K'

    if (( rc != 0 )); then
        echo -e "    ${RED}Last 10 lines of output:${RESET}"
        tail -n 10 "$log_file" 2>/dev/null | sed 's/^/    /'
    fi

    rm -f "$log_file" 2>/dev/null
    return $rc
}

# ── Python version gate ──────────────────────────────────────────────
# Pilot, api/server.py, and engineer all require Python 3.8+.
# We check (and optionally auto-install) Python early, before touching
# the venv or pip, so failures surface with a clear message.
MIN_PYTHON_MAJOR=3
MIN_PYTHON_MINOR=8

# Returns 0 if $1 points to a python binary >= MIN_PYTHON_MAJOR.MINOR
_python_version_ok() {
    local cmd="$1"
    command -v "$cmd" &>/dev/null || return 1
    "$cmd" -c "
import sys
ok = sys.version_info >= ($MIN_PYTHON_MAJOR, $MIN_PYTHON_MINOR)
sys.exit(0 if ok else 1)
" 2>/dev/null
}

# Returns the first working python command, or empty string
_python_cmd() {
    if _python_version_ok python3; then echo "python3"
    elif _python_version_ok python; then echo "python"
    else echo ""
    fi
}

# Check Python is available; try to install it for the given platform if not.
# Exits with an error if Python still can't be found after the install attempt.
check_and_install_python() {
    local platform="$1"

    # ── fast path: already have a good Python ────────────────────────
    if _python_version_ok python3 || _python_version_ok python; then
        local pcmd; pcmd=$(_python_cmd)
        ok "Python: $($pcmd --version 2>&1)"
        return 0
    fi

    warn "Python ${MIN_PYTHON_MAJOR}.${MIN_PYTHON_MINOR}+ not found — attempting automatic install..."

    case "$platform" in
        termux)
            pkg install -y python 2>/dev/null || true
            ;;
        debian|wsl)
            sudo apt-get update -y 2>/dev/null || true
            sudo apt-get install -y python3 python3-pip python3-venv 2>/dev/null || true
            ;;
        fedora)
            sudo dnf install -y python3 python3-pip 2>/dev/null || true
            ;;
        arch)
            sudo pacman -Sy --noconfirm python python-pip 2>/dev/null || true
            ;;
        alpine)
            apk add --no-cache python3 py3-pip 2>/dev/null || true
            ;;
        opensuse)
            sudo zypper install -y python3 python3-pip 2>/dev/null || true
            ;;
        macos)
            if command -v brew &>/dev/null; then
                # See _brew_install: without these two, asking brew for one
                # package can trigger an upgrade of everything that depends on
                # it, and a full formula-index refresh first.
                HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 \
                    brew install python3 2>/dev/null || true
            else
                fail "Python ${MIN_PYTHON_MAJOR}.${MIN_PYTHON_MINOR}+ is required but not installed."
                fail "Install Homebrew first: https://brew.sh"
                fail "Then run: brew install python3 && ./install"
                exit 1
            fi
            ;;
        windows)
            if command -v scoop &>/dev/null; then
                scoop install python 2>/dev/null || true
            elif command -v choco &>/dev/null; then
                choco install python3 -y 2>/dev/null || true
            else
                fail "Python ${MIN_PYTHON_MAJOR}.${MIN_PYTHON_MINOR}+ is required but not installed."
                fail "Download from: https://www.python.org/downloads/"
                fail "After installing, re-run: ./install"
                exit 1
            fi
            ;;
        *)
            warn "Unknown platform — cannot auto-install Python. Install it manually."
            ;;
    esac

    # ── verify the install worked ─────────────────────────────────────
    if _python_version_ok python3 || _python_version_ok python; then
        local pcmd; pcmd=$(_python_cmd)
        ok "Python installed: $($pcmd --version 2>&1)"
    else
        fail "Python ${MIN_PYTHON_MAJOR}.${MIN_PYTHON_MINOR}+ could not be installed automatically."
        fail "Please install it manually and re-run: ./install"
        exit 1
    fi
}

# ── Python venvs ─────────────────────────────────────────────────────
# Pilot gets its own venv at pilot/venv  (langchain, langgraph, etc.)
# Engineer gets a separate venv at engineer/venv  (autogen, etc.)
# Keeping them separate avoids dependency conflicts between the two
# very different AI frameworks.
GATHM_VENV=""      # pilot venv — set by _init_venv
ENGINEER_VENV=""   # engineer venv — set by _init_engineer_venv

# ── Pilot venv ──
_init_venv() {
    GATHM_VENV="$SCRIPT_DIR/pilot/venv"
}

# Install a Bionic-native Pydantic pair when the Termux package is unavailable.
# PyPI's manylinux and musllinux wheels target glibc and musl respectively; a
# renamed extension or copied libgcc cannot turn either into an Android binary.
# The Termux User Repository publishes Android wheels.  Pin this compatible
# pair so pip cannot resolve a newer PyPI pydantic-core wheel over it.
_termux_install_android_pydantic() {
    local venv="$1" python_cmd="$2"
    local _py_majmin
    _py_majmin=$("$python_cmd" -c "import sys; print(f'{sys.version_info.major}{sys.version_info.minor}')" 2>/dev/null)
    case "$_py_majmin" in
        313|314) ;;
        *)
            warn "No Android pydantic-core wheel is configured for Python ${_py_majmin:-unknown}"
            return 1
            ;;
    esac

    local _tur_index="https://termux-user-repository.github.io/pypi/"
    info "Installing Android-native pydantic-core from the Termux User Repository..."
    # pydantic 2.12.5 and pydantic-core 2.41.5 are version-locked.  The latter
    # has CPython 3.13/3.14 Android wheels, unlike the current PyPI release.
    "$venv/bin/pip" install -q --no-deps --upgrade "pydantic==2.12.5" || return 1
    "$venv/bin/pip" install -q --no-deps --upgrade \
        --index-url "$_tur_index" --only-binary=:all: "pydantic-core==2.41.5" || return 1
    # The rest of Pydantic's pure-Python dependencies are resolved with the
    # Pilot requirements immediately after this pre-install step.
    "$python_cmd" -c "import pydantic_core" 2>/dev/null
}

# Switch the venv over to Termux's Bionic-native pydantic / pydantic-core.
# This is the reliable path on Termux: PyPI's manylinux/musllinux pydantic-core
# wheels are glibc/musl binaries that Android's Bionic linker cannot load
# (it reports the bundled glibc libgcc_s as "not found"). Termux packages a
# native build, so we install it and remove any broken wheel-installed copy
# from the venv so the pkg version (visible via --system-site-packages) wins.
# Returns 0 only if pydantic + pydantic_core import cleanly afterwards.
_termux_use_native_pydantic_core() {
    command -v pkg >/dev/null 2>&1 || return 1
    info "Using Termux-native pydantic-core (Bionic build)..."
    pkg install -y python-pydantic python-pydantic-core >/dev/null 2>&1 || true

    # Only proceed if the native build actually IMPORTS on the system Python —
    # otherwise we'd strip the venv's copies for nothing. (A native Bionic build
    # loads fine; a missing/again-glibc one would not.)
    python3 -c "import pydantic_core" 2>/dev/null || return 1

    # Remove the venv's own (broken, glibc) pydantic + pydantic-core so the
    # system-site-packages native build is the one that gets imported. pydantic
    # and pydantic-core are version-locked, so replace them as a pair.
    local sp
    sp=$("$GATHM_VENV/bin/python3" -c "import site; print(site.getsitepackages()[0])" 2>/dev/null)
    if [[ -n "$sp" ]]; then
        rm -rf "$sp"/pydantic_core "$sp"/pydantic_core-*.dist-info "$sp"/pydantic_core.libs \
               "$sp"/pydantic "$sp"/pydantic-*.dist-info 2>/dev/null || true
    fi
    "$GATHM_VENV/bin/python3" -c "import pydantic, pydantic_core" 2>/dev/null
}

# Create pure-Python stubs for Rust-based packages that can't compile on
# Android/aarch64 (Termux).  Each stub satisfies pip's dependency resolver
# and provides the stdlib fallback that the actual package would use anyway.
#
# Currently stubbed:
#   uuid-utils   — langchain-core uses it for faster UUID generation. NOTE: it
#                  does NOT fall back gracefully. langchain_core.runnables
#                  resolves names through a lazy module __getattr__, so a
#                  missing piece surfaces as a bare ImportError at first use:
#                  "module 'langchain_core.runnables'.'base' not found
#                  (No module named 'uuid_utils.compat')". The stub therefore
#                  has to cover every submodule that is imported, not just the
#                  top-level package.
_create_termux_native_stubs() {
    local venv="$1"
    local python_cmd="$venv/bin/python3"
    [[ -x "$python_cmd" ]] || return 0

    local site_packages
    site_packages=$("$python_cmd" -c "import site; print(site.getsitepackages()[0])" 2>/dev/null) || return 0
    [[ -n "$site_packages" ]] || return 0

    # Helper: write a minimal dist-info directory so pip sees the package as installed.
    # Usage: _write_stub_distinfo <site-packages> <name> <version> <module>
    _write_stub_distinfo() {
        local sp="$1" name="$2" ver="$3" mod="$4"
        local d="$sp/${name//-/_}-${ver}.dist-info"
        mkdir -p "$d"
        printf 'Metadata-Version: 2.1\nName: %s\nVersion: %s\nSummary: Termux pure-Python stub\n' \
            "$name" "$ver" > "$d/METADATA"
        printf 'Wheel-Version: 1.0\nGenerator: termux-stub\nRoot-Is-Purelib: true\nTag: py3-none-any\n' \
            > "$d/WHEEL"
        echo "stub" > "$d/INSTALLER"
        printf '%s/__init__.py,,\n%s-stub/METADATA,,\n%s-stub/WHEEL,,\n%s-stub/INSTALLER,,\n%s-stub/RECORD,,\n' \
            "$mod" "$name" "$name" "$name" "$name" > "$d/RECORD"
    }

    # uuid-utils stub --------------------------------------------------------
    # Backed by stdlib `uuid`. Must provide the uuid_utils.compat submodule as
    # well: langchain-core imports `uuid_utils.compat`, and a stub with only
    # __init__.py made langchain_core.runnables fail to import entirely.
    #
    # `compat` is the real package's stdlib-compatible surface — it returns
    # uuid.UUID instances rather than the Rust type — so a stdlib-backed stub
    # matches its semantics exactly.
    #
    # Rewritten unconditionally when compat.py is absent, so a phone carrying
    # the older incomplete stub is repaired instead of skipped by the
    # directory-exists check.
    if [[ ! -f "$site_packages/uuid_utils/compat.py" ]]; then
        mkdir -p "$site_packages/uuid_utils"
        cat > "$site_packages/uuid_utils/_stub_impl.py" << 'PYEOF'
"""Termux stub for uuid-utils (Rust extension, no Android/aarch64 wheel).

Backed by the standard library. uuid1/3/4/5 and the NAMESPACE_* constants come
straight from `uuid`; uuid6/7/8 do not exist in stdlib before 3.14, so they are
provided here.
"""
import os as _os
import time as _time
from uuid import (  # noqa: F401
    UUID,
    NAMESPACE_DNS,
    NAMESPACE_OID,
    NAMESPACE_URL,
    NAMESPACE_X500,
    getnode,
    uuid1,
    uuid3,
    uuid4,
    uuid5,
)

try:  # Python 3.14+ ships these.
    from uuid import uuid6, uuid7, uuid8  # noqa: F401
except ImportError:
    def uuid7() -> UUID:
        """Time-ordered UUIDv7: 48-bit big-endian millisecond timestamp, then
        random bits, with the version and variant fields set per RFC 9562."""
        ms = int(_time.time() * 1000) & ((1 << 48) - 1)
        rand = int.from_bytes(_os.urandom(10), "big")
        value = (ms << 80) | (rand & ((1 << 80) - 1))
        value &= ~(0xF << 76)          # clear version nibble
        value |= 0x7 << 76             # version 7
        value &= ~(0x3 << 62)          # clear variant bits
        value |= 0x2 << 62             # RFC 4122 variant
        return UUID(int=value)

    def uuid6() -> UUID:
        # Also time-ordered; uuid7 is a valid stand-in for a stub's purposes.
        return uuid7()

    def uuid8() -> UUID:
        # v8 is "custom layout" by definition; random is a legitimate choice.
        return uuid4()
PYEOF
        cat > "$site_packages/uuid_utils/__init__.py" << 'PYEOF'
from uuid_utils._stub_impl import *  # noqa: F401,F403
from uuid_utils._stub_impl import (  # noqa: F401
    UUID, getnode, uuid1, uuid3, uuid4, uuid5, uuid6, uuid7, uuid8,
    NAMESPACE_DNS, NAMESPACE_OID, NAMESPACE_URL, NAMESPACE_X500,
)
PYEOF
        cat > "$site_packages/uuid_utils/compat.py" << 'PYEOF'
# uuid_utils.compat — the real package's stdlib-compatible API, which returns
# uuid.UUID instances. This stub is stdlib-backed, so it already matches.
from uuid_utils._stub_impl import *  # noqa: F401,F403
from uuid_utils._stub_impl import (  # noqa: F401
    UUID, getnode, uuid1, uuid3, uuid4, uuid5, uuid6, uuid7, uuid8,
    NAMESPACE_DNS, NAMESPACE_OID, NAMESPACE_URL, NAMESPACE_X500,
)
PYEOF
        _write_stub_distinfo "$site_packages" "uuid-utils" "0.14.1" "uuid_utils"
        ok "uuid-utils stub created (stdlib-backed, includes uuid_utils.compat)"
    fi

    # ormsgpack stub ---------------------------------------------------------
    # langgraph-checkpoint uses ormsgpack for checkpoint serialization; pickle
    # gives consistent serialization within a session.
    #
    # The OPT_* constants are the fragile part. An earlier version of this stub
    # listed the ones that seemed to be in use, and langgraph then reached for
    # one that was not there:
    #
    #   AttributeError: module 'ormsgpack' has no attribute
    #                   'OPT_PASSTHROUGH_DATACLASS'
    #
    # Enumerating them is a losing game — any langgraph release can reference a
    # new flag. A module-level __getattr__ now mints any unknown OPT_* on
    # demand. That is safe precisely because packb ignores `option` entirely
    # (it pickles), so the values only need to exist and be OR-able ints.
    #
    # Guarded on the marker file rather than on the directory: a phone carrying
    # the older constant-listing stub has to be repaired, not skipped.
    if [[ ! -f "$site_packages/ormsgpack/_gathm_stub_marker" ]]; then
        mkdir -p "$site_packages/ormsgpack"
        cat > "$site_packages/ormsgpack/__init__.py" << 'PYEOF'
# Termux stub: ormsgpack Rust extension cannot compile on Android/aarch64.
# Uses pickle for in-session checkpoint serialization.
import itertools as _itertools
import pickle as _pickle

# Known flags keep their documented bit positions, for anything that inspects
# them. Values are otherwise irrelevant here: packb ignores `option`.
OPT_NON_STR_KEYS           = 1
OPT_SERIALIZE_UUID         = 2
OPT_OMIT_MICROSECONDS      = 4
OPT_NAIVE_DATETIME         = 8
OPT_UTC_Z                  = 16
OPT_PASSTHROUGH_DATETIME   = 32
OPT_PASSTHROUGH_SUBCLASS   = 64
OPT_INDENT_2               = 128
OPT_SORT_KEYS              = 256
OPT_PASSTHROUGH_BIG_INT    = 512
OPT_PASSTHROUGH_DATACLASS  = 1024
OPT_PASSTHROUGH_TUPLE      = 2048
OPT_SERIALIZE_NUMPY        = 4096
OPT_SERIALIZE_PYDANTIC     = 8192

# Any OPT_* this stub has not heard of gets a fresh distinct bit on first
# access, so a newer langgraph cannot break the import with an AttributeError.
_next_bit = _itertools.count(14)   # first free bit above the constants above


def __getattr__(name):
    if name.startswith("OPT_"):
        value = 1 << next(_next_bit)
        globals()[name] = value
        return value
    raise AttributeError("module 'ormsgpack' has no attribute %r" % name)


def packb(obj, *, option=None, default=None):
    return _pickle.dumps(obj, protocol=_pickle.HIGHEST_PROTOCOL)


def unpackb(data, *, option=None):
    return _pickle.loads(data)


class MsgpackEncodeError(TypeError):
    pass


class MsgpackDecodeError(ValueError):
    pass
PYEOF
        : > "$site_packages/ormsgpack/_gathm_stub_marker"
        _write_stub_distinfo "$site_packages" "ormsgpack" "1.12.2" "ormsgpack"
        ok "ormsgpack stub created (pickle-backed, tolerates unknown OPT_* flags)"
    fi

    # orjson stub ------------------------------------------------------------
    # langgraph-sdk requires orjson for JSON serialization.
    # stdlib json provides the same interface; orjson.dumps returns bytes so
    # we encode accordingly.
    # Same OPT_* fragility and the same marker-file guard as the ormsgpack stub
    # above, for the same reason: an unknown flag must not raise AttributeError.
    if [[ ! -f "$site_packages/orjson/_gathm_stub_marker" ]]; then
        mkdir -p "$site_packages/orjson"
        cat > "$site_packages/orjson/__init__.py" << 'PYEOF'
# Termux stub: orjson Rust extension cannot compile on Android/aarch64.
# Wraps stdlib json with the same bytes-oriented API.
import itertools as _itertools
import json as _json

OPT_NON_STR_KEYS    = 1
OPT_INDENT_2        = 2
OPT_SORT_KEYS       = 4
OPT_SERIALIZE_UUID  = 8
OPT_SERIALIZE_NUMPY = 16
OPT_STRICT_INTEGER  = 32
OPT_NAIVE_DATETIME  = 64
OPT_UTC_Z           = 128
OPT_PASSTHROUGH_DATETIME   = 256
OPT_PASSTHROUGH_SUBCLASS   = 512
OPT_OMIT_MICROSECONDS      = 1024
OPT_SERIALIZE_DATACLASS    = 2048
OPT_APPEND_NEWLINE         = 4096
OPT_PASSTHROUGH_BIG_INT    = 8192

# Mint any unknown OPT_* on demand rather than raising AttributeError. Only
# OPT_INDENT_2 and OPT_SORT_KEYS change behaviour below, so an unrecognised
# flag is harmless as long as it exists.
_next_bit = _itertools.count(14)


def __getattr__(name):
    if name.startswith("OPT_"):
        value = 1 << next(_next_bit)
        globals()[name] = value
        return value
    raise AttributeError("module 'orjson' has no attribute %r" % name)


class JSONDecodeError(ValueError):
    pass


class JSONEncodeError(TypeError):
    pass

def dumps(obj, default=None, option=None) -> bytes:
    indent = 2 if (option and option & OPT_INDENT_2) else None
    sort_keys = bool(option and option & OPT_SORT_KEYS)
    return _json.dumps(obj, default=default, indent=indent,
                       sort_keys=sort_keys).encode("utf-8")

def loads(data) -> object:
    if isinstance(data, (bytes, bytearray, memoryview)):
        data = data.decode("utf-8")
    try:
        return _json.loads(data)
    except _json.JSONDecodeError as exc:
        raise JSONDecodeError(str(exc)) from exc
PYEOF
        : > "$site_packages/orjson/_gathm_stub_marker"
        _write_stub_distinfo "$site_packages" "orjson" "3.11.7" "orjson"
        ok "orjson stub created (json-backed, tolerates unknown OPT_* flags)"
    fi

    # zstandard stub ---------------------------------------------------------
    # zstandard is a C extension pulled in transitively by langsmith (a
    # langchain-core dependency). It has no Android/aarch64 wheel on PyPI, so
    # pip falls back to compiling libzstd from source on-device, which is very
    # slow and appears to hang. langsmith only uses it to compress trace
    # uploads to LangSmith — a feature Pilot leaves disabled (no API key) — so
    # a stub that imports cleanly is fully compatible in practice.
    #
    # Guarded on an import check: if Termux's real prebuilt zstandard is
    # already importable (e.g. `pkg install python-zstandard`), we use that
    # and skip the stub rather than shadowing it.
    if ! "$python_cmd" -c "import zstandard" 2>/dev/null; then
        mkdir -p "$site_packages/zstandard"
        cat > "$site_packages/zstandard/__init__.py" << 'PYEOF'
# Termux stub: the `zstandard` C extension has no Android/aarch64 wheel and
# building libzstd from source on-device is prohibitively slow. It is pulled
# in only by `langsmith` to compress trace uploads, which Pilot leaves
# disabled, so this stub is never exercised in normal use. It imports cleanly;
# the compression methods raise (rather than silently emit malformed data) if
# something ever does try to use them.
__version__ = "0.23.0"

MAX_COMPRESSION_LEVEL = 22
FRAME_HEADER = b"\x28\xb5\x2f\xfd"

class ZstdError(Exception):
    pass

_MSG = ("zstandard is stubbed on this Termux build; "
        "LangSmith trace compression is unavailable.")

class ZstdCompressor:
    def __init__(self, *args, **kwargs):
        pass
    def compress(self, data):
        raise ZstdError(_MSG)
    def compressobj(self, *args, **kwargs):
        raise ZstdError(_MSG)
    def stream_writer(self, *args, **kwargs):
        raise ZstdError(_MSG)
    def stream_reader(self, *args, **kwargs):
        raise ZstdError(_MSG)

class ZstdDecompressor:
    def __init__(self, *args, **kwargs):
        pass
    def decompress(self, data, *args, **kwargs):
        raise ZstdError(_MSG)
    def decompressobj(self, *args, **kwargs):
        raise ZstdError(_MSG)
    def stream_reader(self, *args, **kwargs):
        raise ZstdError(_MSG)
    def stream_writer(self, *args, **kwargs):
        raise ZstdError(_MSG)

def compress(data, level=3):
    raise ZstdError(_MSG)

def decompress(data, *args, **kwargs):
    raise ZstdError(_MSG)

def open(*args, **kwargs):
    raise ZstdError(_MSG)

def __getattr__(name):
    # Any other symbol langsmith probes → a placeholder that only errors if
    # actually called, so the import itself never fails.
    def _placeholder(*args, **kwargs):
        raise ZstdError(_MSG)
    return _placeholder
PYEOF
        _write_stub_distinfo "$site_packages" "zstandard" "0.23.0" "zstandard"
        ok "zstandard stub created (Termux-compatible; trace compression disabled)"
    fi

    # pydantic-core: use an Android/Bionic wheel --------------------------
    # pydantic v2 has no pure-Python fallback, and PyPI only publishes Linux
    # (glibc/musl) wheels.  Install a matching Android-native pair before
    # resolving Pilot's requirements so pip does not replace it with a Linux
    # build or attempt a Rust source build.
    if ! "$python_cmd" -c "import pydantic_core" 2>/dev/null; then
        _termux_install_android_pydantic "$venv" "$python_cmd" || \
            warn "Android-native pydantic-core install failed; Pilot dependencies may be unavailable"
    fi
}

_ensure_venv() {
    _init_venv
    if [[ ! -d "$GATHM_VENV" ]]; then
        local python_cmd; python_cmd=$(_python_cmd)
        if [[ -z "$python_cmd" ]]; then
            warn "Python not found — cannot create pilot venv"
            GATHM_VENV=""
            return 1
        fi
        info "Creating Pilot Python venv at $GATHM_VENV..."
        # On Termux, use --system-site-packages so the venv inherits any
        # pkg-installed native packages that can't be compiled from source
        # on Android/aarch64.
        local venv_opts=""
        [[ "${_GATHM_PLATFORM:-}" == "termux" ]] && venv_opts="--system-site-packages"
        "$python_cmd" -m venv $venv_opts "$GATHM_VENV" || {
            warn "Pilot venv creation failed — falling back to system pip"
            GATHM_VENV=""
            return 1
        }
        ok "Pilot Python venv created"
    fi
}

_venv_pip() {
    _ensure_venv
    if [[ -n "$GATHM_VENV" && -x "$GATHM_VENV/bin/pip" ]]; then
        "$GATHM_VENV/bin/pip" install "$@"
    else
        pip3 install "$@" 2>/dev/null || pip install "$@" 2>/dev/null || return 1
    fi
}

# ── Engineer venv ──
_init_engineer_venv() {
    ENGINEER_VENV="$SCRIPT_DIR/engineer/venv"
}

_ensure_engineer_venv() {
    _init_engineer_venv
    if [[ ! -d "$ENGINEER_VENV" ]]; then
        local python_cmd; python_cmd=$(_python_cmd)
        if [[ -z "$python_cmd" ]]; then
            warn "Python not found — cannot create engineer venv"
            ENGINEER_VENV=""
            return 1
        fi
        info "Creating Engineer Python venv at $ENGINEER_VENV..."
        "$python_cmd" -m venv "$ENGINEER_VENV" || {
            warn "Engineer venv creation failed — will share pilot venv as fallback"
            ENGINEER_VENV=""
            return 1
        }
        ok "Engineer Python venv created"
    fi
}

_engineer_venv_pip() {
    _ensure_engineer_venv
    if [[ -n "$ENGINEER_VENV" && -x "$ENGINEER_VENV/bin/pip" ]]; then
        "$ENGINEER_VENV/bin/pip" install -q "$@"
    else
        # Fall back to the pilot venv or system pip
        _venv_pip "$@"
    fi
}

# --- Cleanup on interrupt ---
_setup_cleanup() {
    echo ""
    warn "Setup interrupted. Partial installation may exist."
    warn "Re-run './install' to resume, or './install --uninstall' to clean up."
    exit 130
}
trap _setup_cleanup INT TERM

# Run a command with a time limit, portably.
#
# macOS has no GNU `timeout` unless coreutils is installed, so a bare
# `timeout ...` silently means "no limit at all" there — which is how a failing
# clone was allowed to run for 21 minutes under a "15 minute" limit. Same
# ladder as lib/utils.bash's run_bounded, defined locally because this file
# must not source that one: it has a detect_platform() that answers "darwin"
# where this one answers "macos".
_bounded() {
    local seconds="$1"; shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$seconds" "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout "$seconds" "$@"
    elif command -v perl >/dev/null 2>&1; then
        perl -e 'alarm shift; exec @ARGV' "$seconds" "$@"
    else
        "$@"
    fi
}

# --- Internet connectivity check ---
GATHM_ONLINE="false"
check_internet() {
    info "Checking internet connectivity..."
    if curl -s --connect-timeout 5 --max-time 10 https://github.com > /dev/null 2>&1; then
        GATHM_ONLINE="true"
        ok "Network: ${GREEN}Online${RESET}"
    elif wget -q --spider --timeout=5 https://github.com 2>/dev/null; then
        GATHM_ONLINE="true"
        ok "Network: ${GREEN}Online${RESET}"
    else
        GATHM_ONLINE="false"
        warn "Network: ${RED}Offline${RESET} — skipping online-only steps (Ollama)"
    fi
}

# --- Platform detection ---
detect_platform() {
    local kernel
    kernel=$(uname -s 2>/dev/null || echo "unknown")
    case "$kernel" in
        Darwin)       echo "macos" ;;
        MINGW*|MSYS*) echo "windows" ;;
        CYGWIN*)      echo "windows" ;;
        Linux)
            if command -v termux-setup-storage &>/dev/null; then
                echo "termux"
            elif grep -qi microsoft /proc/version 2>/dev/null; then
                echo "wsl"
            elif command -v apt-get &>/dev/null; then
                echo "debian"
            elif command -v dnf &>/dev/null; then
                echo "fedora"
            elif command -v pacman &>/dev/null; then
                echo "arch"
            elif command -v apk &>/dev/null; then
                echo "alpine"
            elif command -v zypper &>/dev/null; then
                echo "opensuse"
            else
                echo "linux"
            fi
            ;;
        *) echo "unknown" ;;
    esac
}

# --- Install dependencies by platform ---
install_deps() {
    local platform="$1"

    # Core packages every platform needs.
    # openssl is intentionally excluded: macOS ships LibreSSL as 'openssl',
    # and Linux distros pre-install it.  It is only added for Termux and
    # any platform where it is genuinely absent.
    local core="bash curl jq git"

    info "Platform detected: $platform"
    info "Installing dependencies..."

    case "$platform" in
        termux)
            pkg update -y 2>/dev/null || true
            pkg install -y $core python rust pv wget dnsutils iproute2 net-tools libxml2 2>/dev/null || true
            # pydantic-core is a Rust extension. PyPI only ships manylinux/musl
            # wheels (glibc/musl) which Android's Bionic linker cannot load at
            # all — so we MUST use Termux's own Bionic-native build. Installing
            # python-pydantic pulls in the matching python-pydantic-core; the
            # pilot venv (created with --system-site-packages) then imports them
            # directly and pip never touches pydantic-core. Best-effort.
            pkg install -y python-pydantic python-pydantic-core 2>/dev/null || true
            # Note: python-numpy used to be installed here to satisfy
            # langchain-community, but Pilot no longer depends on it (see
            # pilot/requirements.txt), so we skip it — building/compiling numpy
            # on Android was the slow, noisy step and it is no longer needed.
            # Best-effort real zstandard: langsmith (a langchain-core dep) pulls
            # it in, and building it from source on-device is very slow. If
            # Termux ships a prebuilt binding we use it; otherwise the venv gets
            # a pure-Python stub in _create_termux_native_stubs. (zstd = C lib.)
            pkg install -y zstd python-zstandard 2>/dev/null || true
            pip install pyyaml 2>/dev/null || true
            ;;
        debian|wsl)
            sudo apt-get update -y 2>/dev/null || true
            sudo apt-get install -y $core python3 python3-pip python3-venv pv wget dnsutils iproute2 net-tools libxml2-utils 2>/dev/null || true
            pip3 install pyyaml 2>/dev/null || pip install pyyaml 2>/dev/null || true
            ;;
        fedora)
            sudo dnf install -y $core python3 python3-pip pv wget bind-utils iproute net-tools libxml2 2>/dev/null || true
            pip3 install pyyaml 2>/dev/null || true
            ;;
        arch)
            sudo pacman -Sy --noconfirm $core python python-pip pv wget bind-tools iproute2 net-tools libxml2 2>/dev/null || true
            pip install pyyaml 2>/dev/null || true
            ;;
        alpine)
            apk update 2>/dev/null || true
            apk add $core python3 py3-pip pv wget bind-tools iproute2 net-tools libxml2-utils 2>/dev/null || true
            pip3 install pyyaml 2>/dev/null || true
            ;;
        opensuse)
            sudo zypper install -y $core python3 python3-pip pv wget bind-utils iproute2 net-tools libxml2-tools 2>/dev/null || true
            pip3 install pyyaml 2>/dev/null || true
            ;;
        macos)
            if command -v brew &>/dev/null; then
                # openssl omitted: macOS ships LibreSSL as /usr/bin/openssl
                HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 \
                    brew install bash curl jq git python3 pv wget 2>/dev/null || true
                pip3 install pyyaml 2>/dev/null || true
            else
                warn "Homebrew not found. Install it from https://brew.sh"
                warn "Then run: brew install bash curl jq git python3 pv wget"
            fi
            ;;
        windows)
            if command -v scoop &>/dev/null; then
                scoop install git curl jq python 2>/dev/null || true
            elif command -v choco &>/dev/null; then
                choco install git curl jq python3 -y 2>/dev/null || true
            elif command -v pacman &>/dev/null; then
                # MSYS2
                pacman -Sy --noconfirm $core python python-pip 2>/dev/null || true
            else
                warn "No package manager found (try installing scoop, choco, or MSYS2)"
            fi
            pip install pyyaml 2>/dev/null || pip3 install pyyaml 2>/dev/null || true
            ;;
        *)
            warn "Unknown platform. Please install manually: $core python3 pv jq"
            ;;
    esac

    ok "Dependencies installed"
}

# --- Termux storage permissions (no-op on non-Termux) ---
#
# Granting the Android storage permission can make Termux kill and restart
# its session, which aborts this installer. To keep that from costing the
# user any real work, this step runs FIRST (before any heavy install) and is
# fully idempotent: once $HOME/storage exists it returns instantly, so a
# post-restart re-run of ./install sails straight past it.
setup_termux_storage() {
    local platform="$1"
    [[ "$platform" != "termux" ]] && return 0

    if ! command -v termux-setup-storage >/dev/null 2>&1; then
        warn "termux-setup-storage not found; skipping storage permission setup"
        return 0
    fi

    # Already granted → nothing to do. This is the fast path that makes a
    # re-run after a Termux restart smooth.
    if [[ -d "$HOME/storage" ]]; then
        ok "Termux storage already configured"
        return 0
    fi

    warn "Termux is about to ask for the storage permission."
    warn "Granting it may restart Termux and interrupt this installer."
    warn "If that happens, just run ${BOLD}./install${RESET}${YELLOW} again — it resumes and"
    warn "skips every step that already finished (including this one)."
    # Give the user a few seconds to read this before the Android dialog pops.
    sleep 4

    info "Requesting Termux storage permission..."
    termux-setup-storage 2>/dev/null || true
    sleep 2

    if [[ -d "$HOME/storage" ]]; then
        ok "Termux storage configured"
    else
        warn "Storage folder not detected yet."
        warn "If Termux restarted, re-run ./install — it will pick up from here."
    fi
}

# --- Install Ollama (local LLM runtime) ---
install_ollama() {
    if [[ "$GATHM_ONLINE" != "true" ]]; then
        step_skip "Ollama install skipped (offline)"
        return 0
    fi

    if command -v ollama &>/dev/null; then
        step_done "Ollama already installed ($(ollama --version 2>&1 | head -1))"
        start_ollama_serve
        return 0
    fi

    local platform="$1"

    # Pre-cache sudo credentials. The official Ollama installer calls sudo
    # several times (writing /usr/local/bin, registering systemd units). If
    # sudo prompts mid-download the install can sit waiting for a password
    # behind a wall of curl output — looking exactly like a hung script.
    if [[ "$platform" != "windows" && "$platform" != "termux" ]] \
            && command -v sudo &>/dev/null \
            && ! sudo -n true 2>/dev/null; then
        info "Caching sudo credentials so the Ollama installer doesn't pause for a password later..."
        sudo -v 2>/dev/null || warn "sudo credential cache failed — installer may prompt mid-run"
    fi

    info "Downloads ~700MB (plus GPU drivers if a GPU is detected)."
    info "Typical time: 3-15 min depending on your connection. Live progress below."
    echo ""

    local t0=$SECONDS
    local install_rc=0

    case "$platform" in
        macos)
            if command -v brew &>/dev/null; then
                run_with_spinner "Installing Ollama via Homebrew" -- \
                    env HOMEBREW_NO_AUTO_UPDATE=1 \
                        HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 \
                        brew install ollama || install_rc=$?
            else
                # Foreground so user sees curl + install.sh progress directly.
                curl -fsSL https://ollama.com/install.sh | sh || install_rc=$?
            fi
            ;;
        termux)
            run_with_spinner "Installing Ollama via pkg" -- \
                pkg install -y ollama || install_rc=$?
            ;;
        windows)
            # Try package managers first, then fall back to the official installer exe
            if command -v winget &>/dev/null; then
                run_with_spinner "Installing Ollama via winget" -- \
                    winget install --id Ollama.Ollama --accept-source-agreements \
                        --accept-package-agreements --silent || install_rc=$?
            elif command -v scoop &>/dev/null; then
                info "Installing Ollama via scoop..."
                scoop bucket add extras 2>/dev/null || true
                run_with_spinner "scoop install ollama" -- \
                    scoop install extras/ollama || install_rc=$?
            elif command -v choco &>/dev/null; then
                run_with_spinner "Installing Ollama via Chocolatey" -- \
                    choco install ollama -y || install_rc=$?
            else
                # Download and run the official silent installer
                info "Downloading OllamaSetup.exe (official installer)..."
                local _tmp_dir; _tmp_dir=$(mktemp -d 2>/dev/null || echo "$TEMP/gathm_$$")
                mkdir -p "$_tmp_dir" 2>/dev/null || true
                local _setup_exe="$_tmp_dir/OllamaSetup.exe"
                if curl -fL --progress-bar "https://ollama.com/download/OllamaSetup.exe" \
                        -o "$_setup_exe"; then
                    info "Running OllamaSetup.exe /SILENT..."
                    "$_setup_exe" /SILENT || install_rc=$?
                    rm -f "$_setup_exe" 2>/dev/null || true
                else
                    install_rc=1
                    warn "Could not download Ollama installer."
                    warn "Install manually from: https://ollama.com/download/windows"
                fi
            fi
            ;;
        *)
            # Linux (all distros), WSL — keep install.sh in the foreground so the
            # user sees its real-time progress messages (downloading bundle, setting
            # up systemd, etc.) instead of staring at a silent screen.
            curl -fsSL https://ollama.com/install.sh | sh || install_rc=$?
            ;;
    esac

    local elapsed=$(( SECONDS - t0 ))

    if command -v ollama &>/dev/null; then
        step_done "Ollama installed in $(_format_elapsed $elapsed)"
        start_ollama_serve
    else
        step_fail "Ollama installation failed after $(_format_elapsed $elapsed) — install manually from https://ollama.com"
    fi
}

# --- Ensure ollama serve is running in the background ---
start_ollama_serve() {
    if ! command -v ollama &>/dev/null; then
        return 0
    fi

    # Check if already serving (port 11434)
    if curl -s --max-time 2 http://127.0.0.1:11434/ &>/dev/null; then
        ok "Ollama server already running"
        return 0
    fi

    info "Starting Ollama server (ollama serve)..."
    local _log_dir="${PREFIX:+$PREFIX/tmp}"; _log_dir="${_log_dir:-${TMPDIR:-/tmp}}"
    nohup ollama serve &>"$_log_dir/ollama-serve.log" &
    disown $! 2>/dev/null || true

    # Wait up to 10 s for it to come up
    local i=0
    while (( i < 10 )); do
        sleep 1
        if curl -s --max-time 2 http://127.0.0.1:11434/ &>/dev/null; then
            ok "Ollama server started"
            return 0
        fi
        i=$((i + 1))
    done

    warn "Ollama server did not respond in time — it may still be starting up"
}

# --- Open URL in default browser (best-effort) ---
open_url() {
    local url="$1"
    local platform="${2:-linux}"
    case "$platform" in
        macos)   open "$url" 2>/dev/null || true ;;
        termux)  termux-open-url "$url" 2>/dev/null || true ;;
        wsl)     cmd.exe /c start "" "$url" 2>/dev/null || xdg-open "$url" 2>/dev/null || true ;;
        *)       xdg-open "$url" 2>/dev/null || sensible-browser "$url" 2>/dev/null || true ;;
    esac
}

# --- Google Gemini free-tier fallback (when Ollama is unavailable) ---
setup_gemini_fallback() {
    local platform="${1:-linux}"

    echo ""
    info "Setting up Google Gemini (free tier) as the Pilot AI backend."
    echo ""
    echo -e "  ${CYAN}Google Gemini${RESET} gives you free access to powerful LLMs."
    echo "  You only need a Google account — no credit card required."
    echo ""
    echo "  Steps:"
    echo "    1. We'll open Google AI Studio in your browser."
    echo "    2. Sign in with your Google account."
    echo "    3. Click 'Create API key' and copy it."
    echo "    4. Paste it here."
    echo ""
    read -r -p "  Press [Enter] to open AI Studio (or Ctrl+C to skip): " _dummy </dev/tty || true
    open_url "https://aistudio.google.com/apikey" "$platform"
    echo ""
    echo "  (If the browser didn't open, visit: https://aistudio.google.com/apikey)"
    echo ""

    local gemini_key=""
    while [[ -z "$gemini_key" ]]; do
        read -r -p "  Paste your Gemini API key: " gemini_key </dev/tty || true
        if [[ -z "$gemini_key" ]]; then
            local skip_ans=""
            read -r -p "  No key entered. Skip Gemini setup? [y/N]: " skip_ans </dev/tty || true
            if [[ "$skip_ans" =~ ^[Yy]$ ]]; then
                warn "Gemini setup skipped — Pilot AI will not be available."
                return 0
            fi
        fi
    done

    # Write API key + backend config to .env (preserving other vars)
    local env_file="$SCRIPT_DIR/.env"
    local preserved=""
    if [[ -f "$env_file" ]]; then
        preserved=$(grep -v '^GOOGLE_API_KEY=\|^GEMINI_API_KEY=\|^GATHM_LLM_BACKEND=\|^GATHM_GEMINI_MODEL=' "$env_file" 2>/dev/null || true)
    fi
    {
        [[ -n "$preserved" ]] && echo "$preserved"
        echo "GOOGLE_API_KEY=$gemini_key"
        echo "GATHM_LLM_BACKEND=gemini"
        echo "GATHM_GEMINI_MODEL=gemini-2.0-flash-lite"
    } > "$env_file"
    chmod 600 "$env_file" 2>/dev/null || true

    # Save backend + model to ~/.gathm/
    mkdir -p "$HOME/.gathm" 2>/dev/null || true
    echo "gemini" > "$HOME/.gathm/llm_backend"
    _save_model_config "gemini-2.0-flash-lite"

    # Install the Python SDK for Gemini
    info "Installing langchain-google-genai..."
    _venv_pip langchain-google-genai && \
        ok "langchain-google-genai installed" || \
        warn "Run manually: pip install langchain-google-genai"

    ok "Gemini configured! Model: gemini-2.0-flash-lite (free tier)"
}

# Detect total system RAM in MB.  Prints the value on stdout; prints 0
# and returns 1 if it can't determine.  Reads /proc/meminfo on Linux,
# WSL and Termux; falls back to `sysctl` on macOS.
_detect_total_ram_mb() {
    local mem_kb
    if [[ -r /proc/meminfo ]]; then
        mem_kb=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null)
        if [[ -n "$mem_kb" && "$mem_kb" -gt 0 ]]; then
            echo $(( mem_kb / 1024 ))
            return 0
        fi
    fi
    if command -v sysctl &>/dev/null; then
        local mem_bytes
        mem_bytes=$(sysctl -n hw.memsize 2>/dev/null)
        if [[ -n "$mem_bytes" && "$mem_bytes" -gt 0 ]]; then
            echo $(( mem_bytes / 1024 / 1024 ))
            return 0
        fi
    fi
    echo 0
    return 1
}

# The Ollama models Gathm will use on Termux.
#
# Android inference is pure CPU, thermal throttling starts within a minute, and
# the low-memory killer reaps the Ollama server mid-response — so the desktop
# RAM tiers below are far too generous here. Termux gets its own two-step
# ladder: gemma3:1b everywhere, and gemma3:4b only on a genuinely large phone.
GATHM_TERMUX_MODEL_SMALL="gemma3:1b"
GATHM_TERMUX_MODEL_LARGE="gemma3:4b"

# RAM floor for the 4b model, in MB. Deliberately 11000 and not 12288: MemTotal
# reports what the kernel can allocate, not the marketed capacity, so a phone
# sold as 12 GB reads back around 11.0-11.7 GB once firmware and kernel
# reservations are taken out. Comparing against a strict 12288 would never match
# a 12 GB device. 11000 still sits well clear of an 8 GB phone (~7.2-7.6 GB) and
# a 10 GB one (~9.3 GB).
GATHM_TERMUX_LARGE_MIN_RAM_MB="${GATHM_TERMUX_LARGE_MIN_RAM_MB:-11000}"

# Echo the Termux model appropriate to this phone's RAM.
# Unknown RAM deliberately falls to the small model — on a phone the cost of
# guessing high is an unusable install, and guessing low is a smaller download.
_termux_model_for_ram() {
    local ram_mb
    ram_mb=$(_detect_total_ram_mb) || true
    if [[ "$ram_mb" =~ ^[0-9]+$ ]] \
            && (( ram_mb >= GATHM_TERMUX_LARGE_MIN_RAM_MB )); then
        echo "$GATHM_TERMUX_MODEL_LARGE"
    else
        echo "$GATHM_TERMUX_MODEL_SMALL"
    fi
}

# True when this phone qualifies for the larger Termux model.
_termux_wants_large_model() {
    [[ "$(_termux_model_for_ram)" == "$GATHM_TERMUX_MODEL_LARGE" ]]
}

# Pick an Ollama model tag based on system RAM.
# Conservative tiers — assumes pure CPU inference and leaves headroom
# for the OS.  Override at any time by writing $HOME/.gathm/model or
# setting GATHM_OLLAMA_MODEL in the env before running ./install.
_recommend_model_for_hardware() {
    # Termux uses its own ladder, not these tiers — see above.
    if _is_termux; then
        _termux_model_for_ram
        return 0
    fi

    local ram_mb
    # `|| true`: the detector returns non-zero when it cannot tell, and under
    # `set -e` a bare assignment from it would abort the installer.
    ram_mb=$(_detect_total_ram_mb) || true
    if   (( ram_mb < 1 ));     then echo "gemma3:4b"      # detection failed
    elif (( ram_mb < 4096 ));  then echo "gemma3:1b"      # phone / small VM
    elif (( ram_mb < 8192 ));  then echo "gemma3:4b"      # ≤8 GB
    elif (( ram_mb < 16384 )); then echo "llama3.1:8b"    # 8–16 GB
    elif (( ram_mb < 32768 )); then echo "qwen2.5:14b"    # 16–32 GB
    else                            echo "qwen2.5:32b"    # 32 GB+
    fi
}

# Free space (MB) on the filesystem holding $1. The target dir may not exist
# yet (Ollama creates it on first pull), so we walk up to the nearest existing
# parent. Uses `df -Pk` (POSIX 1K blocks, single line per fs). 0 = unknown.
_detect_free_disk_mb() {
    local path="$1"
    while [[ -n "$path" && "$path" != "/" && ! -d "$path" ]]; do
        path=$(dirname "$path")
    done
    [[ -d "$path" ]] || path="$HOME"
    local avail_k
    avail_k=$(df -Pk "$path" 2>/dev/null | awk 'NR==2 {print $4; exit}')
    if [[ -n "$avail_k" && "$avail_k" =~ ^[0-9]+$ ]]; then
        echo $(( avail_k / 1024 ))
        return 0
    fi
    echo 0
    return 1
}

# Approximate on-disk size (MB) of an Ollama model, keyed off the parameter
# suffix (Q4 quantisation). Estimates run a little high on purpose so the
# storage gate errs toward caution. Unknown tags get a conservative default.
_model_size_mb() {
    case "$1" in
        *:1b|*:2b)          echo 1200  ;;
        *:3b|*:4b)          echo 3800  ;;
        *:7b|*:8b|*:9b)     echo 5500  ;;
        *:12b|*:13b|*:14b)  echo 9500  ;;
        *:27b|*:30b|*:32b)  echo 21000 ;;
        *:70b|*:72b)        echo 43000 ;;
        *)                  echo 6000  ;;
    esac
}

# Given a preferred model and free disk (MB), return the model to actually pull:
#   - the preferred one if it fits (size + headroom),
#   - else the largest model from the ladder that fits (a downgrade),
#   - else empty (nothing fits).
_largest_model_that_fits() {
    local preferred="$1" free_mb="$2" headroom=1024
    if (( free_mb >= $(_model_size_mb "$preferred") + headroom )); then
        echo "$preferred"; return 0
    fi
    local m
    for m in "qwen2.5:32b" "qwen2.5:14b" "llama3.1:8b" "gemma3:4b" "gemma3:1b"; do
        if (( free_mb >= $(_model_size_mb "$m") + headroom )); then
            echo "$m"; return 0
        fi
    done
    echo ""; return 1
}

# Run `ollama pull` with its download progress visible.
#
# ollama writes its progress bar to STDERR, so the previous `2>/dev/null` threw
# away the only feedback a multi-hundred-MB download produces. The install just
# sat there for minutes looking hung — which is exactly what it looked like.
#
# Deliberately NOT wrapped in run_with_spinner: that captures output to a file
# and shows only the last line, which mangles a \r-driven progress bar. Run it
# in the foreground and unredirected instead, the same way install_ollama keeps
# the official installer in the foreground. ollama draws a real bar (percent,
# size, rate, ETA) when stderr is a TTY and falls back to periodic plain lines
# when it is not, so piped installs stay readable too.
_ollama_pull_with_progress() {
    local model="$1"
    local est_mb; est_mb=$(_model_size_mb "$model")

    info "Pulling ${BOLD}${model}${RESET} — roughly ${est_mb} MB."
    info "Live progress from ollama follows. This is a download, not a hang."
    echo ""

    local t0=$SECONDS rc=0
    ollama pull "$model" || rc=$?
    echo ""

    if (( rc == 0 )); then
        ok "Pulled $model in $(_format_elapsed $(( SECONDS - t0 )))"
        return 0
    fi
    warn "ollama pull $model failed after $(_format_elapsed $(( SECONDS - t0 ))) (exit $rc)"
    return "$rc"
}

# Pull the best ollama model.
#   $1 (optional) — preferred model tag (e.g. "llama3.1:8b")
#
# Logic:
#   1. If $1 is set and already in `ollama list` → use it immediately, no download.
#   2. If $1 is set but not yet pulled → attempt download.
#   3. On download failure (or no $1 given) → scan `ollama list` for anything
#      already present and pick the best match from a priority list.
#   4. If nothing is pulled at all → pull the minimal default (gemma3:4b,
#      or GATHM_TERMUX_MODEL on Termux).
_pull_ollama_model() {
    local requested_model="${1:-}"

    if ! command -v ollama &>/dev/null; then
        warn "ollama not available — skipping model pull"
        return 1
    fi

    # ── 1. Inventory already-pulled models ───────────────────────────
    local pulled_models
    pulled_models=$(ollama list 2>/dev/null | tail -n +2 | awk '{print $1}' | grep -v '^$' || true)

    # ── 2. Requested model: check list before downloading ─────────────
    if [[ -n "$requested_model" ]]; then
        if echo "$pulled_models" | grep -qF "$requested_model"; then
            ok "Model '$requested_model' already pulled — no download needed"
            _save_model_config "$requested_model"
            return 0
        fi
        if _ollama_pull_with_progress "$requested_model"; then
            _save_model_config "$requested_model"
            return 0
        fi
        warn "Could not pull '$requested_model' — checking for already-pulled alternatives..."
    fi

    # ── 3. Pick the best model from what is already on disk ───────────
    # The priority list below leads with llama3.x, so without this filter a
    # phone that still has an 8b model from an older install would "fall back"
    # to the very thing that gets OOM-killed mid-response. What counts as
    # acceptable tracks the same RAM rule as a fresh pull: 4b only on a large
    # phone, 1b-class otherwise.
    if [[ -n "$pulled_models" ]] && _is_termux; then
        local ok_sizes=':(0\.5b|1b|1\.5b|2b)$'
        if _termux_wants_large_model; then
            ok_sizes=':(0\.5b|1b|1\.5b|2b|3b|4b)$'
        fi
        local small_models
        small_models=$(echo "$pulled_models" | grep -iE "$ok_sizes" || true)
        if [[ -n "$small_models" ]]; then
            local small_match
            small_match=$(echo "$small_models" | head -1)
            ok "Using already-pulled model: $small_match"
            _save_model_config "$small_match"
            return 0
        fi
        warn "Already-pulled models are all too large for this phone — ignoring them"
        pulled_models=""
    fi

    if [[ -n "$pulled_models" ]]; then
        local preferred=(
            "llama3.3" "llama3.2" "llama3.1" "llama3"
            "mistral-nemo" "mistral"
            "gemma3" "gemma2" "gemma"
            "phi4" "phi3.5" "phi3"
            "qwen2.5" "qwen2"
            "deepseek-r1" "deepseek"
        )
        for pref in "${preferred[@]}"; do
            local match
            match=$(echo "$pulled_models" | grep -i "^${pref}" | head -1 || true)
            if [[ -n "$match" ]]; then
                ok "Using already-pulled model: $match"
                _save_model_config "$match"
                return 0
            fi
        done
        # Nothing matched the priority list — just use whatever is there
        local first_model
        first_model=$(echo "$pulled_models" | head -1)
        if [[ -n "$first_model" ]]; then
            ok "Using already-pulled model: $first_model"
            _save_model_config "$first_model"
            return 0
        fi
    fi

    # ── 4. Nothing available — pull the minimal default ──
    # Termux picks by RAM; gemma3:4b is the desktop default.
    local default_model="gemma3:4b"
    if _is_termux; then
        default_model=$(_termux_model_for_ram)
    fi
    info "No local models found — falling back to the default model."
    if _ollama_pull_with_progress "$default_model"; then
        _save_model_config "$default_model"
    else
        warn "Could not pull $default_model — run manually: ollama pull $default_model"
        _save_model_config "$default_model"
    fi
}

# --- Pick a local model and pull it ---
# Selection priority (highest wins):
#   1. GATHM_OLLAMA_MODEL env var (explicit override)
#   2. Termux RAM ladder         (1b, or 4b only on an 11 GB+ phone)
#   3. $HOME/.gathm/model        (sticky choice from a previous run)
#   4. _recommend_model_for_hardware (RAM-tier heuristic)
select_and_pull_llm_model() {
    if [[ "$GATHM_ONLINE" != "true" ]]; then
        warn "Offline — checking for already-pulled local models"
        _pull_ollama_model ""
        return 0
    fi

    if ! command -v ollama &>/dev/null; then
        warn "Ollama not available — attempting Gemini fallback"
        setup_gemini_fallback "${_GATHM_PLATFORM:-linux}"
        return 0
    fi

    local recommended=""

    if [[ -n "${GATHM_OLLAMA_MODEL:-}" ]]; then
        # An explicit env override is a deliberate choice; honour it everywhere.
        recommended="$GATHM_OLLAMA_MODEL"
        info "Using model from GATHM_OLLAMA_MODEL: $recommended"
    elif _is_termux; then
        # Chosen here, deliberately ahead of the saved-model check: an install
        # from before this rule existed may have left a 4b/8b tag in
        # ~/.gathm/model, and reusing that is the thing we are preventing.
        recommended=$(_termux_model_for_ram)
        local _ram_mb; _ram_mb=$(_detect_total_ram_mb) || true
        # State the decision and its inputs out loud: when this picks the
        # "wrong" model, the RAM reading is the first thing worth seeing.
        info "Termux: ${_ram_mb:-?} MB RAM (4b needs ${GATHM_TERMUX_LARGE_MIN_RAM_MB}+) → $recommended"
        local _prev=""
        [[ -s "$HOME/.gathm/model" ]] && \
            _prev=$(head -n 1 "$HOME/.gathm/model" 2>/dev/null | tr -d '\r\n[:space:]')
        if [[ -n "$_prev" && "$_prev" != "$recommended" ]]; then
            warn "Replacing previously-selected '$_prev' with $recommended"
        fi
    elif [[ -s "$HOME/.gathm/model" ]]; then
        recommended=$(head -n 1 "$HOME/.gathm/model" 2>/dev/null | tr -d '\r\n[:space:]')
        [[ -n "$recommended" ]] && info "Using previously-selected model: $recommended"
    fi

    if [[ -z "$recommended" ]]; then
        local ram_mb
        ram_mb=$(_detect_total_ram_mb)
        recommended=$(_recommend_model_for_hardware)
        if (( ram_mb > 0 )); then
            info "Hardware: ${ram_mb} MB RAM detected → ${recommended}"
        else
            info "Could not detect RAM — defaulting to ${recommended}"
        fi
    fi

    # ── Storage gate ─────────────────────────────────────────────────
    # An Ollama model is 1–20+ GB. If the chosen model is already pulled we
    # need no space; otherwise make sure it fits before starting a long
    # download — downgrading to the largest model that fits, or skipping the
    # pull entirely when there isn't room for even the smallest.
    local pulled_models
    pulled_models=$(ollama list 2>/dev/null | tail -n +2 | awk '{print $1}' | grep -v '^$' || true)

    if [[ -n "$recommended" ]] && echo "$pulled_models" | grep -qF "$recommended"; then
        _pull_ollama_model "$recommended"   # already on disk — no space needed
        return 0
    fi

    local models_dir="${OLLAMA_MODELS:-$HOME/.ollama/models}"
    local free_mb; free_mb=$(_detect_free_disk_mb "$models_dir")
    if (( free_mb > 0 )); then
        local fitted; fitted=$(_largest_model_that_fits "$recommended" "$free_mb")
        if [[ -z "$fitted" ]]; then
            local smallest_mb; smallest_mb=$(_model_size_mb "gemma3:1b")
            if [[ -n "$pulled_models" ]]; then
                warn "Only ${free_mb} MB free — too little to download a model; using one already on disk."
                _pull_ollama_model ""        # reuse whatever is present
            else
                warn "Only ${free_mb} MB free — not enough for any model (smallest ≈ ${smallest_mb} MB)."
                warn "Skipping model download. Free up space, then run: ollama pull gemma3:1b"
                _save_model_config "$recommended"   # record intent; verify() will flag it
            fi
            return 0
        fi
        if [[ "$fitted" != "$recommended" ]]; then
            warn "Only ${free_mb} MB free — choosing ${fitted} instead of ${recommended} to fit storage"
            recommended="$fitted"
        else
            info "Storage: ${free_mb} MB free — room for ${recommended} (≈ $(_model_size_mb "$recommended") MB + headroom)"
        fi
    fi

    _pull_ollama_model "$recommended"
}

# Save selected model to config
# Usage: _save_model_config <model> [backend]   backend defaults to "ollama"
_save_model_config() {
    local model="$1"
    local backend="${2:-ollama}"
    local config_dir="$HOME/.gathm"
    mkdir -p "$config_dir" 2>/dev/null || true
    echo "$model"   > "$config_dir/model"
    echo "$backend" > "$config_dir/llm_backend"
    ok "LLM config saved: backend=$backend model=$model"

    # Also write to .env for Pilot to pick up
    local env_file="$SCRIPT_DIR/.env"
    if [[ -f "$env_file" ]]; then
        if grep -q '^GATHM_OLLAMA_MODEL=' "$env_file" 2>/dev/null; then
            sed -i "s|^GATHM_OLLAMA_MODEL=.*|GATHM_OLLAMA_MODEL=$model|" "$env_file" 2>/dev/null || \
                sed -i '' "s|^GATHM_OLLAMA_MODEL=.*|GATHM_OLLAMA_MODEL=$model|" "$env_file" 2>/dev/null || true
        else
            echo "GATHM_OLLAMA_MODEL=$model" >> "$env_file"
        fi
        if grep -q '^GATHM_LLM_BACKEND=' "$env_file" 2>/dev/null; then
            sed -i "s|^GATHM_LLM_BACKEND=.*|GATHM_LLM_BACKEND=$backend|" "$env_file" 2>/dev/null || \
                sed -i '' "s|^GATHM_LLM_BACKEND=.*|GATHM_LLM_BACKEND=$backend|" "$env_file" 2>/dev/null || true
        else
            echo "GATHM_LLM_BACKEND=$backend" >> "$env_file"
        fi
    else
        printf 'GATHM_OLLAMA_MODEL=%s\nGATHM_LLM_BACKEND=%s\n' "$model" "$backend" > "$env_file"
    fi
}

# --- Setup files and permissions ---
setup_files() {
    info "Setting up files..."

    # Data directories
    mkdir -p "$HOME/.gathm"/{logs,health,agent/plans} 2>/dev/null || true

    # Make scripts executable
    chmod +x "$SCRIPT_DIR/gathm" 2>/dev/null || true
    chmod +x "$SCRIPT_DIR/agent/"*.sh 2>/dev/null || true
    for dir in "$SCRIPT_DIR"/tools/*/; do
        local name
        name=$(basename "$dir")
        [[ -f "$dir/$name" ]] && chmod +x "$dir/$name"
    done

    ok "Files ready"
}

# --- Install engineer Python requirements (optional) ---
install_engineer_deps() {
    if [[ "$_GATHM_PLATFORM" == "termux" ]]; then
        warn "Skipping engineer deps (not supported on Termux)"
        return 0
    fi

    local req_file="$SCRIPT_DIR/engineer/requirements.txt"
    if [[ ! -f "$req_file" ]]; then
        return 0
    fi

    info "Installing engineer AI dependencies into engineer/venv (autogen-agentchat, autogen-ext)..."
    _engineer_venv_pip -r "$req_file" && \
        ok "Engineer dependencies installed" || \
        warn "Engineer dependency install failed — run manually: pip install -r engineer/requirements.txt"
}

# --- Install Pilot Python requirements ---
install_pilot_deps() {
    local req_file="$SCRIPT_DIR/pilot/requirements.txt"
    if [[ ! -f "$req_file" ]]; then
        return 0
    fi

    info "Installing Pilot AI dependencies (this may take a few minutes)..."

    if [[ "$_GATHM_PLATFORM" == "termux" ]]; then
        # Pre-populate the venv with stubs for packages that require Rust/native
        # compilation (patchelf/ninja/maturin) which can't build on Android/aarch64.
        _ensure_venv
        _create_termux_native_stubs "$GATHM_VENV"

        # playwright has no PyPI wheel for Android/aarch64; skip it and
        # use the pkg-installed Chromium instead.
        local tmp_req
        tmp_req=$(mktemp)
        grep -vE "^playwright" "$req_file" > "$tmp_req"
        # Keep pip from upgrading the Android-native pair selected above to a
        # newer PyPI Pydantic release whose core wheel is Linux-only.
        printf '\npydantic==2.12.5\n' >> "$tmp_req"
        if _venv_pip -r "$tmp_req"; then
            ok "Pilot dependencies installed (playwright skipped on Termux)"
        else
            warn "Pilot dependency install failed — run manually: pip install -r pilot/requirements.txt"
        fi
        rm -f "$tmp_req"

        # pydantic-core must be a Bionic-native build.  PyPI's manylinux and
        # musllinux wheels cannot be repaired by copying their libgcc payload:
        # they target different C libraries from Android's linker.
        if ! "$GATHM_VENV/bin/python3" -c "import pydantic_core" 2>/dev/null; then
            warn "pydantic-core not loading — switching to Termux-native build..."
            if _termux_use_native_pydantic_core; then
                ok "pydantic-core now loads (Termux-native build)"
            else
                warn "Termux-native pydantic unavailable — installing Android wheel..."
                _termux_install_android_pydantic "$GATHM_VENV" "$GATHM_VENV/bin/python3" || true
                if "$GATHM_VENV/bin/python3" -c "import pydantic, pydantic_core" 2>/dev/null; then
                    ok "pydantic-core now loads (Android-native wheel)"
                else
                    warn "pydantic-core still cannot load:"
                    "$GATHM_VENV/bin/python3" -c "import pydantic_core" 2>&1 | tail -3 | sed 's/^/    /'
                    warn "Fix manually: pip install --index-url https://termux-user-repository.github.io/pypi/ --only-binary=:all: --no-deps pydantic-core==2.41.5"
                fi
            fi
        elif "$GATHM_VENV/bin/python3" -c "import pydantic, pydantic_core" 2>/dev/null; then
            ok "pydantic-core loads"
        else
            warn "pydantic is incomplete after dependency installation"
        fi

        # selenium drives the system Chromium on Termux (pure Python, works on aarch64)
        # NB: _venv_pip already prepends `pip install`, so pass only the package.
        _venv_pip selenium 2>/dev/null && \
            ok "selenium installed (Termux browser backend)" || \
            warn "selenium install failed — browser control limited to open/fetch"
    else
        if _venv_pip -r "$req_file"; then
            ok "Pilot dependencies installed"
        else
            warn "Pilot dependency install failed — run manually: pip install -r pilot/requirements.txt"
        fi
    fi

    # The GUI/API server (api/server.py) needs FastAPI + uvicorn. Install them
    # into the same venv Pilot uses so the GUI actually starts.
    _install_gui_deps
}

# Install the FastAPI + uvicorn stack the GUI/API server needs, into the pilot
# venv. On Termux we install plain uvicorn (NOT uvicorn[standard]) because the
# [standard] extras pull in uvloop + httptools (C extensions) and watchfiles
# (Rust) — none of which have Android/aarch64 wheels, so they'd try to compile
# from source and stall the install. Plain uvicorn is pure Python and works.
_install_gui_deps() {
    _ensure_venv
    # NB: _venv_pip already runs `pip install`, so pass only packages/flags.
    if [[ "$_GATHM_PLATFORM" == "termux" ]]; then
        if _venv_pip fastapi uvicorn; then
            ok "GUI dependencies installed (fastapi, uvicorn)"
        else
            warn "GUI dependency install failed — GUI won't start. Retry: pip install fastapi uvicorn"
        fi
    else
        local api_req="$SCRIPT_DIR/api/requirements.txt"
        if [[ -f "$api_req" ]] && _venv_pip -r "$api_req"; then
            ok "GUI dependencies installed (fastapi, uvicorn[standard])"
        elif _venv_pip fastapi uvicorn; then
            ok "GUI dependencies installed (fastapi, uvicorn)"
        else
            warn "GUI dependency install failed — GUI won't start. Retry: pip install -r api/requirements.txt"
        fi
    fi
}

# --- Install browser engine for Pilot's browser control feature ---
#
# Desktop (Linux/macOS/Windows/WSL):
#   `playwright install chromium` downloads Playwright's bundled Chromium.
#   On Linux, --with-deps also installs the required OS packages.
#
# Termux (Android):
#   `playwright install chromium` reports "unsupported platform: android" and
#   refuses to run.  Instead, we install the ARM64 Chromium that is distributed
#   through Termux's community repository (tur-repo + x11-repo).  Pilot's
#   browser.py detects the system binary automatically via `executable_path`.
install_playwright_browser() {
    if [[ "$GATHM_ONLINE" != "true" ]]; then
        warn "Skipping browser engine install (offline)"
        return 0
    fi

    # ── Termux path: install system Chromium via pkg ──────────────────
    if [[ "$_GATHM_PLATFORM" == "termux" ]]; then
        info "Installing Chromium for Termux (tur-repo)..."
        # tur-repo provides community-built packages; x11-repo provides
        # display-related libraries needed by the Chromium binary.
        pkg install -y tur-repo x11-repo 2>/dev/null || true
        if pkg install -y chromium 2>/dev/null; then
            ok "Chromium installed via pkg — full browser control enabled on Termux"
        else
            warn "Chromium pkg install failed — browser control limited to open/fetch"
            warn "Retry manually: pkg install tur-repo x11-repo && pkg install chromium"
        fi
        return 0
    fi

    # ── Desktop path: download Playwright's bundled Chromium ──────────
    local pw_cmd=""
    if [[ -x "$GATHM_VENV/bin/playwright" ]]; then
        pw_cmd="$GATHM_VENV/bin/playwright"
    elif command -v playwright &>/dev/null; then
        pw_cmd="playwright"
    else
        warn "playwright CLI not found — skipping Chromium download"
        warn "Run manually: playwright install chromium"
        return 0
    fi

    info "Installing Playwright Chromium (browser engine for Pilot)..."
    # --with-deps installs required OS libraries on Linux (harmless on macOS/Win)
    if "$pw_cmd" install chromium --with-deps 2>/dev/null; then
        ok "Playwright Chromium ready"
    elif "$pw_cmd" install chromium 2>/dev/null; then
        ok "Playwright Chromium ready"
    else
        warn "Playwright Chromium download failed — browser control will be limited"
        warn "Retry manually: playwright install chromium"
    fi
}

# ── audio.cpp — native speech runtime (lets Pilot talk) ──────────────────
#
# audio.cpp is a C++/ggml audio runtime (TTS + ASR):
#   https://github.com/0xShug0/audio.cpp
#
# Why a native build instead of a Python TTS stack:
#   On Termux there is no working Python option. The usual speech wheels are
#   either glibc-only native builds that Android's Bionic linker refuses to
#   load — the same class of breakage we already fight with pydantic-core,
#   see _termux_use_native_pydantic_core — or Rust extensions with no
#   aarch64 wheel at all. audio.cpp compiles on-device with clang and needs
#   no Python at runtime, so the Termux voice path adds ZERO pip packages.
#   Do not "fix" a failure here by pip-installing pydantic-core or a Python
#   TTS library; that is the exact trap this path exists to avoid.
#
# Why macOS builds it too:
#   `say` covers speaking there, but the OS exposes no command line for
#   LISTENING — dictation is a GUI feature — so audio.cpp is the only
#   speech-to-text path a terminal app can use. Darwin is a first-class ggml
#   target, the sentencepiece patch below is Bionic-specific, and a Mac
#   compiles in minutes rather than the hour a phone takes.
#
#   Linux and Windows are still left exactly as they were, keeping whatever
#   Python/audio dependencies they already use.
#
# The flow (Termux is the one verified on-device):
#   build deps: pkg on Termux, brew + Xcode CLT on macOS
#        ↓
#   clone/update audio.cpp
#        ↓
#   patch vendored sentencepiece (Termux only: -U__ANDROID__, or it fails)
#        ↓
#   CMake CPU-only build of the audiocpp_cli target
#        ↓
#   ~/.local/bin/audiocpp_cli   (+ ~/.gathm/audiocpp_path for Pilot)
#        ↓
#   voice model weights — a separate download, reported not forced
#
# Environment knobs (all optional):
#   GATHM_INSTALL_AUDIO_CPP=0      skip the build (fast install, no voice)
#   GATHM_AUDIOCPP_SRC=DIR         clone/build location
#   GATHM_AUDIOCPP_MODEL_SET=SET   full | core | custom   (default: custom)
#   GATHM_AUDIOCPP_MODELS=a,b,c    families to compile when MODEL_SET=custom
#   GATHM_AUDIOCPP_JOBS=N          compile parallelism
#   GATHM_AUDIOCPP_FORCE=1         rebuild even if audiocpp_cli already exists
AUDIOCPP_REPO="https://github.com/0xShug0/audio.cpp.git"

# Speech-only default. Upstream defaults to AUDIOCPP_MODEL_SET=full, which
# compiles every model family it ships (music generation, voice conversion,
# separation, …). Pilot only needs to speak, and on a phone that difference is
# the difference between a build that finishes and one that does not.
#
# pocket_tts specifically: this is the configuration that has actually been
# built and verified on Termux. Add families here via GATHM_AUDIOCPP_MODELS —
# each one costs build time.
#
# sense_asr is the listening half: SenseVoice-Small, ~250 MB at q8_0, 23
# languages, offline. The Qwen3 ASR models are the obvious alternative and are
# 3-7x larger (0.6B ≈ 700 MB, 1.7B ≈ 1.8 GB) for nothing Gathm needs, which is
# a bad trade on a phone that is already hosting the LLM.
AUDIOCPP_DEFAULT_MODELS="pocket_tts,sense_asr"

# The voice weights, and how the CLI is invoked to use them. These are the
# values verified end-to-end on-device:
#
#   audiocpp_cli --task tts --family pocket_tts \
#       --model models/PocketTTS-GGUF/english --backend cpu \
#       --voice-id alba --text "..." --out hello.wav
#
# All four values come from upstream's model_specs/pocket_tts.json:
# pocket_tts_english_q8_0 is the family's default package, its target
# directory is PocketTTS-GGUF/english, and `alba` is the declared default
# voice. That package ships the .gguf *plus* embeddings/alba.safetensors —
# which is exactly why the weights must come from the model manager and not a
# hand-picked .gguf: without the embedding the model loads and has no voice.
#
# Voice cloning uses --voice-ref <wav> in place of --voice-id.
#
# Overriding the package: the spec also offers bf16, and german/italian/
# portuguese/spanish variants — but those language packages ship a model file
# only, with no voice embedding, so --voice-id alba will not resolve against
# them. pocket_tts_english_safetensors carries 26 voices (alba..vera) if you
# want a choice of voice later.
AUDIOCPP_TTS_PACKAGE="${GATHM_AUDIOCPP_TTS_PACKAGE:-pocket_tts_english_q8_0}"
AUDIOCPP_TTS_FAMILY="pocket_tts"
AUDIOCPP_TTS_VOICE="${GATHM_AUDIOCPP_TTS_VOICE:-alba}"
# Where model_manager_v2.py lands the default package, relative to the source
# tree. Only a hint — _audiocpp_model_dir falls back to locating the .gguf, so
# an overridden package in a different target directory still resolves.
AUDIOCPP_TTS_MODEL_REL="models/PocketTTS-GGUF/english"

# The transcription weights. sensevoice_small_q8 is the sense_asr family's
# default package in upstream's model_specs/sense_asr.json; it lands in
# SenseVoice-Small-GGUF and covers 23 languages with auto-detection, offline
# and streaming. Invoked as:
#
#   audiocpp_cli --task asr --family sense_asr \
#       --model models/SenseVoice-Small-GGUF --backend cpu --audio clip.wav
AUDIOCPP_ASR_PACKAGE="${GATHM_AUDIOCPP_ASR_PACKAGE:-sensevoice_small_q8}"
AUDIOCPP_ASR_FAMILY="${GATHM_AUDIOCPP_ASR_FAMILY:-sense_asr}"
AUDIOCPP_ASR_MODEL_REL="models/SenseVoice-Small-GGUF"

# Set by the TTS smoke test so the ASR smoke test can transcribe it back —
# turning two separate "it ran" checks into one real round trip.
_AUDIOCPP_SMOKE_WAV=""

# Compiling audio.cpp costs 20-60 minutes on a phone, so a binary that already
# works is worth keeping. The cache lives outside ~/.gathm on purpose: uninstall
# removes that directory, and a reinstall should not mean another hour of clang.
# Delete it by hand (or with --purge-audio-cache) to force a rebuild.
AUDIOCPP_CACHE_DIR="${GATHM_AUDIOCPP_CACHE:-$HOME/.cache/gathm/audiocpp}"

# A prebuilt binary can also come from elsewhere entirely: build once, publish
# it (e.g. as a GitHub release asset), then point every other device at it.
#   GATHM_AUDIOCPP_BIN_URL=https://…/audiocpp_cli-aarch64
#   GATHM_AUDIOCPP_BIN_SHA256=<sha256>   (optional but recommended)
AUDIOCPP_BIN_URL="${GATHM_AUDIOCPP_BIN_URL:-}"
AUDIOCPP_BIN_SHA256="${GATHM_AUDIOCPP_BIN_SHA256:-}"

# True on Termux/Android. Prefers the platform detected by main(), falling
# back to detection so this is also correct when called from `--check`.
_is_termux() {
    local p="${_GATHM_PLATFORM:-}"
    [[ -z "$p" ]] && p=$(detect_platform)
    [[ "$p" == "termux" ]]
}

# True on macOS. audio.cpp builds there too — Darwin is a first-class ggml
# target and the sentencepiece patch below is Bionic-specific, so the only
# real differences are the package manager and OpenMP.
#
# Both spellings on purpose: this installer's own detect_platform says "macos"
# (line ~794) while lib/utils.bash's says "darwin", and whichever one is in
# scope decides. Matching only one silently skipped the whole audio.cpp step on
# a Mac, with a message claiming macOS was supported.
_is_darwin() {
    local p="${_GATHM_PLATFORM:-}"
    [[ -z "$p" ]] && p=$(detect_platform)
    [[ "$p" == "macos" || "$p" == "darwin" ]]
}

# Homebrew, with its two most destructive habits disabled.
#
# NO_INSTALLED_DEPENDENTS_CHECK is the important one: asking for `ffmpeg` on a
# machine that has openai-whisper installed makes brew decide to upgrade
# whisper too, which pulls in llvm, pytorch, onnx and gcc — hundreds of
# megabytes of toolchain that has nothing to do with speaking a sentence, and
# one flaky bottle download then strands the install behind a lock. Gathm asks
# for a package; it does not ask to re-tool the user's machine.
#
# NO_AUTO_UPDATE keeps a routine dependency install from turning into a full
# formula-index refresh on a slow connection.
_brew_install() {
    HOMEBREW_NO_AUTO_UPDATE=1 \
    HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 \
    _bounded 900 brew install "$@" &>/dev/null
}

# Platforms Gathm builds the speech runtime on. Everywhere else keeps whatever
# Python/audio dependencies it already had — see the section comment above.
_audiocpp_supported() {
    _is_termux || _is_darwin
}

# Where audio.cpp is checked out and built.
# Defaults under ~/.gathm so uninstall knows where to look, but an existing
# ~/audio.cpp checkout (how this was first done by hand) is reused as-is so
# nobody re-clones a tree they already have.
_audiocpp_src_dir() {
    if [[ -n "${GATHM_AUDIOCPP_SRC:-}" ]]; then
        echo "$GATHM_AUDIOCPP_SRC"
    elif [[ -d "$HOME/audio.cpp/.git" ]]; then
        echo "$HOME/audio.cpp"
    else
        echo "$HOME/.gathm/audio.cpp"
    fi
}

# Echo a usable audiocpp_cli path, preferring the copy Gathm controls.
# Returns 1 (and echoes nothing) when there is no binary anywhere.
_audiocpp_bin() {
    if [[ -x "$LOCAL_BIN/audiocpp_cli" ]]; then
        echo "$LOCAL_BIN/audiocpp_cli"; return 0
    fi
    if command -v audiocpp_cli &>/dev/null; then
        command -v audiocpp_cli; return 0
    fi
    local built; built="$(_audiocpp_src_dir)/build/bin/audiocpp_cli"
    if [[ -x "$built" ]]; then
        echo "$built"; return 0
    fi
    echo ""
    return 1
}

# Compile parallelism. `nproc` alone is the wrong answer on a phone: ggml's
# translation units are large, and 8 concurrent clang processes on a 4 GB
# device get OOM-killed partway through — which surfaces as a random,
# confusing build failure. Budget ~1.5 GB per job and never exceed the core
# count.
_audiocpp_jobs() {
    if [[ -n "${GATHM_AUDIOCPP_JOBS:-}" ]]; then
        echo "$GATHM_AUDIOCPP_JOBS"; return 0
    fi

    local cores jobs ram_mb by_ram
    cores=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)
    [[ "$cores" =~ ^[0-9]+$ ]] || cores=2
    jobs="$cores"

    # `|| true`: the detector returns non-zero when it cannot tell, and under
    # `set -e` a bare assignment from it would abort the whole installer.
    ram_mb=$(_detect_total_ram_mb) || true
    if [[ "$ram_mb" =~ ^[0-9]+$ ]] && (( ram_mb > 0 )); then
        by_ram=$(( ram_mb / 1500 ))
        if (( by_ram < 1 )); then by_ram=1; fi
        if (( by_ram < jobs )); then jobs="$by_ram"; fi
    fi

    if (( jobs < 1 )); then jobs=1; fi
    echo "$jobs"
}

# Toolchain needed to compile audio.cpp (C11/C++17, CMake 3.20+).
_audiocpp_install_build_deps() {
    info "Installing audio.cpp build dependencies..."

    if _is_darwin; then
        # The compiler comes from the Xcode command line tools, which cannot be
        # installed unattended — trigger Apple's own prompt and say so, rather
        # than failing later inside cmake with a missing-compiler error.
        if ! xcode-select -p &>/dev/null; then
            warn "Xcode command line tools are missing (they provide the compiler)."
            warn "Accept the dialog that opens, then re-run ./install."
            xcode-select --install &>/dev/null || true
            note_missing "Xcode command line tools" "xcode-select --install"
            return 1
        fi
        if command -v brew &>/dev/null; then
            local want=() tool
            for tool in cmake ninja; do
                command -v "$tool" &>/dev/null || want+=("$tool")
            done
            if (( ${#want[@]} )); then
                info "Installing ${want[*]} with Homebrew..."
                _brew_install "${want[@]}" || true
            fi
        fi
        if ! command -v cmake &>/dev/null; then
            warn "cmake not found and Homebrew could not install it"
            note_missing "cmake for the speech runtime" "brew install cmake ninja"
            return 1
        fi
        ok "Build tools present (cmake$(command -v ninja &>/dev/null && echo ', ninja'))"
        return 0
    fi

    # coreutils supplies `timeout`, used to prevent a stalled Git HTTPS
    # connection from holding the entire installer forever.
    pkg install -y git cmake ninja clang make pkg-config coreutils 2>/dev/null || true
    # Upstream builds with OpenMP ON by default. Termux ships libomp in its own
    # `openmp` package rather than inside clang, so without this the configure
    # step fails on an otherwise fine toolchain.
    pkg install -y openmp 2>/dev/null || true
}

# Synthesis is only half of speaking — something has to play the WAV, and
# Android ships no CLI audio player at all. Without one, Pilot renders perfect
# audio to a temp file and stays silent.
AUDIOCPP_PLAYERS="termux-media-player afplay mpv ffplay play paplay aplay"

# Echo the first usable playback command, or nothing.
_audiocpp_player() {
    local p
    for p in $AUDIOCPP_PLAYERS; do
        if command -v "$p" &>/dev/null; then echo "$p"; return 0; fi
    done
    return 1
}

# Make sure a player exists. mpv is the one that reliably outputs audio on
# Termux (termux-media-player also works but needs the separate Termux:API app
# from F-Droid, which an installer cannot do on the user's behalf).
_audiocpp_install_player() {
    local existing; existing=$(_audiocpp_player) || true
    if [[ -n "$existing" ]]; then
        ok "Audio player present ($existing)"
        return 0
    fi
    info "Installing an audio player so replies can be heard..."
    pkg install -y mpv 2>/dev/null || true
    existing=$(_audiocpp_player) || true
    if [[ -n "$existing" ]]; then
        ok "Audio player installed ($existing)"
        return 0
    fi
    warn "No audio player found — speech will be synthesized but not played"
    note_missing "audio player for speech playback" "pkg install mpv"
    return 1
}

# Run an audio.cpp Git operation with a finite wall-clock deadline.  Android
# can keep an HTTPS socket half-open indefinitely after a network hand-off;
# Git then prints only "Cloning into ..." while the spinner runs forever.
# GIT_TERMINAL_PROMPT=0 also turns an unexpected credential prompt into a
# normal failure instead of an invisible hang behind the spinner.
_audiocpp_git() {
    local limit="${GATHM_AUDIOCPP_GIT_TIMEOUT:-900}"
    [[ "$limit" =~ ^[0-9]+$ ]] && (( limit > 0 )) || limit=900

    _bounded "$limit" env GIT_TERMINAL_PROMPT=0 \
        git -c http.lowSpeedLimit=1024 -c http.lowSpeedTime=60 "$@"
}

# Clone audio.cpp, or update an existing checkout.
_audiocpp_clone_or_update() {
    local src="$1"

    if [[ -d "$src/.git" ]]; then
        info "Updating audio.cpp checkout ($src)..."
        # --ff-only, never a hard reset: a local checkout may carry the user's
        # own patches. A failed update is not fatal — whatever is already
        # checked out still builds.
        run_with_spinner "git pull (audio.cpp)" -- \
            _audiocpp_git -C "$src" pull --ff-only --recurse-submodules \
            || warn "Could not update audio.cpp — building the existing checkout"
        return 0
    fi

    mkdir -p "$(dirname "$src")" 2>/dev/null || true

    # Two stages, each retried on its own, rather than one clone with
    # --recurse-submodules.
    #
    # A single combined clone is one long transfer, and on a connection that
    # drops large transfers ("RPC failed; curl 56 Recv failure", "fatal: early
    # EOF") every failure throws away all of it — twenty minutes to learn
    # nothing. Split, the main repo and each submodule are separate downloads,
    # a retry only redoes the one that broke, and submodules already fetched
    # are skipped on the next attempt.
    local attempts="${GATHM_AUDIOCPP_GIT_RETRIES:-3}"
    [[ "$attempts" =~ ^[0-9]+$ ]] && (( attempts > 0 )) || attempts=3

    local try rc=1
    for (( try = 1; try <= attempts; try++ )); do
        if [[ -d "$src/.git" ]]; then
            rc=0
            break
        fi
        [[ $try -gt 1 ]] && info "Clone attempt $try of $attempts..."
        # A failed clone leaves an unusable partial directory behind; git
        # refuses to clone into it, so the retry must start clean.
        rm -rf "$src" 2>/dev/null || true
        info "Cloning audio.cpp into $src ..."
        rc=0
        run_with_spinner "git clone audio.cpp (try $try/$attempts)" -- \
            _audiocpp_git clone --depth 1 --no-recurse-submodules \
                "$AUDIOCPP_REPO" "$src" || rc=$?
        (( rc == 0 )) && break
        warn "Clone attempt $try failed — the transfer was interrupted"
    done

    if (( rc != 0 )) || [[ ! -d "$src/.git" ]]; then
        warn "Could not clone audio.cpp after $attempts attempts."
        warn "The transfer keeps being cut off rather than timing out, which is"
        warn "a network problem, not a Gathm one. Options:"
        warn "  - retry: ./install --audio-only"
        warn "  - more attempts: GATHM_AUDIOCPP_GIT_RETRIES=8 ./install --audio-only"
        warn "  - clone it yourself, then re-run --audio-only (any checkout at"
        warn "    ~/audio.cpp or \$GATHM_AUDIOCPP_SRC is reused as-is):"
        warn "      git clone --depth 1 $AUDIOCPP_REPO ~/audio.cpp"
        return 1
    fi

    # Submodules second. ggml and sentencepiece are separate transfers, so one
    # failing no longer costs the main repo.
    for (( try = 1; try <= attempts; try++ )); do
        rc=0
        run_with_spinner "git submodules (try $try/$attempts)" -- \
            _audiocpp_git -C "$src" submodule update --init --recursive \
                --depth 1 || rc=$?
        (( rc == 0 )) && break
        warn "Submodule fetch attempt $try failed — retrying the parts that are missing"
    done

    if (( rc != 0 )); then
        warn "Submodules incomplete after $attempts attempts; the build will"
        warn "probably fail on a missing vendored dependency. Finish them with:"
        warn "  git -C $src submodule update --init --recursive --depth 1"
        return 1
    fi
    return 0
}

# Termux-only source patch: make sentencepiece link on Android.
#
# audio.cpp vendors sentencepiece, which switches to an Android code path when
# __ANDROID__ is defined and logs through Android's liblog. Termux is Android
# by that definition but is a full POSIX userland, not the NDK, and nothing
# here links liblog — so everything compiles fine and then the final link of
# audiocpp_cli dies with:
#
#   ld.lld: error: undefined symbol: __android_log_write
#
# Undefining __ANDROID__ for that one target sends it down the ordinary POSIX
# path, which is the correct one on Termux, and the symbol never appears.
#
# Idempotent: a second run finds the line already present and does nothing.
# Sets _AUDIOCPP_FRESH_CONFIGURE=1 when it actually changes the file, because
# CMake's cache has to be discarded after the compile options change.
_AUDIOCPP_FRESH_CONFIGURE=0
_audiocpp_patch_termux_sentencepiece() {
    local src="$1"
    local spm="$src/external/sentencepiece/src/CMakeLists.txt"
    local line="target_compile_options(sentencepiece-static PRIVATE -U__ANDROID__)"

    if [[ ! -f "$spm" ]]; then
        # Upstream moved or vendored it differently — not fatal, the build
        # either doesn't need the patch anymore or will say so plainly.
        warn "sentencepiece CMakeLists not found (looked in $spm) — skipping Android patch"
        return 0
    fi

    if grep -qF -- "$line" "$spm" 2>/dev/null; then
        ok "sentencepiece already patched for Termux (-U__ANDROID__)"
        return 0
    fi

    local tmp
    tmp=$(mktemp 2>/dev/null) || tmp="$spm.gathm.tmp"
    # Insert immediately after the target is declared. Matching only up to
    # "STATIC" keeps this free of brace/dollar escaping for ${SPM_SRCS}.
    if awk -v ins="$line" '
            { print }
            /add_library\(sentencepiece-static STATIC/ { print ins }
        ' "$spm" > "$tmp" 2>/dev/null \
            && grep -qF -- "$line" "$tmp" 2>/dev/null \
            && mv "$tmp" "$spm" 2>/dev/null; then
        ok "Patched sentencepiece for Termux (-U__ANDROID__ on sentencepiece-static)"
        _AUDIOCPP_FRESH_CONFIGURE=1
        return 0
    fi

    rm -f "$tmp" 2>/dev/null || true
    warn "Could not patch sentencepiece — the build may fail in sentencepiece-static."
    warn "Apply manually, then re-run:"
    warn "  echo '$line' >> $spm"
    return 0
}

# Cache key: the machine type plus the families compiled in. A binary built for
# pocket_tts alone cannot serve a config that also expects sense_asr, and an
# aarch64 build is useless on anything else, so both belong in the name.
_audiocpp_cache_file() {
    local arch models
    arch=$(uname -m 2>/dev/null || echo unknown)
    models="${GATHM_AUDIOCPP_MODELS:-$AUDIOCPP_DEFAULT_MODELS}"
    models="${models//,/-}"
    echo "$AUDIOCPP_CACHE_DIR/audiocpp_cli-${arch}-${models}"
}

# Ask the binary what loaders it has — from inside the checkout when there is
# one. audiocpp_cli resolves model_specs/<family>.json relative to the working
# directory, so run from anywhere else it reports
# "model contract spec not found for family 'sense_asr'" and --list-loaders
# fails outright, which is how a perfectly good ASR build looked missing.
_audiocpp_list_loaders() {
    local bin="$1" src
    [[ -n "$bin" ]] || return 1
    src=$(_audiocpp_src_dir)
    if [[ -d "$src/model_specs" ]]; then
        ( cd "$src" 2>/dev/null && "$bin" --list-loaders 2>/dev/null )
    else
        "$bin" --list-loaders 2>/dev/null
    fi
}

# Does this binary have every family the current config asks for? The cache key
# records the requested families, so caching a binary that lacks one would
# mislabel it — and a later restore would hand back something that cannot do
# what the key promises. Checking the binary itself is the only honest test.
_audiocpp_binary_has_families() {
    local bin="$1" models loaders fam
    models="${GATHM_AUDIOCPP_MODELS:-$AUDIOCPP_DEFAULT_MODELS}"
    loaders=$(_audiocpp_list_loaders "$bin") || return 1
    [[ -n "$loaders" ]] || return 1
    local -a fams=()
    IFS=',' read -ra fams <<< "$models"
    for fam in "${fams[@]+"${fams[@]}"}"; do
        fam="${fam// /}"
        [[ -n "$fam" ]] || continue
        grep -qi -- "$fam" <<< "$loaders" || return 1
    done
    return 0
}

# Does this binary run, and does it have the loaders we expect?
_audiocpp_binary_usable() {
    local bin="$1"
    [[ -x "$bin" ]] || return 1
    _audiocpp_list_loaders "$bin" >/dev/null 2>&1 || "$bin" --help >/dev/null 2>&1 || return 1
    _audiocpp_list_loaders "$bin" | grep -qi "$AUDIOCPP_TTS_FAMILY" || return 1
    _audiocpp_binary_has_families "$bin"
}

# Keep a copy of a good build for next time.
_audiocpp_cache_save() {
    local bin="$1" target
    # Never cache a binary that does not match the key we would file it under.
    # An install predating sense_asr has a pocket_tts-only binary, and the
    # default family list now names both — caching it would poison the cache.
    if ! _audiocpp_binary_has_families "$bin"; then
        return 0
    fi
    target=$(_audiocpp_cache_file)
    mkdir -p "$AUDIOCPP_CACHE_DIR" 2>/dev/null || return 0
    if cp "$bin" "$target.tmp" 2>/dev/null && mv "$target.tmp" "$target" 2>/dev/null; then
        chmod +x "$target" 2>/dev/null || true
        ok "Cached this build for future installs ($target)"
    else
        rm -f "$target.tmp" 2>/dev/null || true
    fi
}

# Reuse a cached build instead of compiling, when one matches and still runs.
_audiocpp_cache_restore() {
    local cached; cached=$(_audiocpp_cache_file)
    [[ -f "$cached" ]] || return 1
    chmod +x "$cached" 2>/dev/null || true
    if ! _audiocpp_binary_usable "$cached"; then
        warn "Cached binary at $cached will not run — rebuilding"
        return 1
    fi
    mkdir -p "$LOCAL_BIN" 2>/dev/null || true
    if cp "$cached" "$LOCAL_BIN/audiocpp_cli" 2>/dev/null; then
        chmod +x "$LOCAL_BIN/audiocpp_cli" 2>/dev/null || true
        ok "Reused the cached audio.cpp build — no compile needed"
        return 0
    fi
    return 1
}

# Fetch a prebuilt binary. This is the way to skip compiling on every device:
# build once, publish, then set GATHM_AUDIOCPP_BIN_URL everywhere else.
_audiocpp_fetch_prebuilt() {
    [[ -n "$AUDIOCPP_BIN_URL" ]] || return 1
    local tmp="${TMPDIR:-${PREFIX:+$PREFIX/tmp}}"; tmp="${tmp:-/tmp}"
    local out="$tmp/audiocpp_cli.download.$$"
    rm -f "$out" 2>/dev/null || true

    info "Downloading prebuilt audiocpp_cli from $AUDIOCPP_BIN_URL"
    if ! run_with_spinner "downloading audiocpp_cli" -- \
            curl -fL --connect-timeout 20 --retry 2 -o "$out" "$AUDIOCPP_BIN_URL"; then
        warn "Download failed — falling back to building from source"
        rm -f "$out" 2>/dev/null || true
        return 1
    fi

    if [[ -n "$AUDIOCPP_BIN_SHA256" ]]; then
        local got=""
        if command -v sha256sum &>/dev/null; then
            got=$(sha256sum "$out" 2>/dev/null | awk '{print $1}')
        elif command -v shasum &>/dev/null; then
            got=$(shasum -a 256 "$out" 2>/dev/null | awk '{print $1}')
        fi
        if [[ -z "$got" ]]; then
            warn "No sha256 tool available — cannot verify the download"
        elif [[ "$got" != "$AUDIOCPP_BIN_SHA256" ]]; then
            # warn, not step_fail: the step has not failed, it falls back to
            # building from source. step_fail would also mark the step failed
            # and then be contradicted by a successful build.
            warn "Checksum mismatch on the downloaded binary — refusing to install it"
            warn "  expected $AUDIOCPP_BIN_SHA256"
            warn "  got      $got"
            note_missing "prebuilt audiocpp_cli (checksum mismatch)" \
                "check GATHM_AUDIOCPP_BIN_URL and GATHM_AUDIOCPP_BIN_SHA256"
            rm -f "$out" 2>/dev/null || true
            return 1
        else
            ok "Checksum verified"
        fi
    fi

    chmod +x "$out" 2>/dev/null || true
    if ! _audiocpp_binary_usable "$out"; then
        warn "The downloaded binary does not run here (wrong architecture or"
        warn "built without the $AUDIOCPP_TTS_FAMILY loader) — building instead"
        rm -f "$out" 2>/dev/null || true
        return 1
    fi

    mkdir -p "$LOCAL_BIN" 2>/dev/null || true
    if cp "$out" "$LOCAL_BIN/audiocpp_cli" 2>/dev/null; then
        chmod +x "$LOCAL_BIN/audiocpp_cli" 2>/dev/null || true
        _audiocpp_cache_save "$LOCAL_BIN/audiocpp_cli"
        rm -f "$out" 2>/dev/null || true
        ok "Installed the prebuilt audiocpp_cli — no compile needed"
        return 0
    fi
    rm -f "$out" 2>/dev/null || true
    return 1
}

# Configure + compile the audiocpp_cli target. CPU only, twice if needed.
_audiocpp_cmake_build() {
    local src="$1"
    local build_dir="$src/build"
    local jobs; jobs=$(_audiocpp_jobs)

    local model_set="${GATHM_AUDIOCPP_MODEL_SET:-custom}"
    local models="${GATHM_AUDIOCPP_MODELS:-$AUDIOCPP_DEFAULT_MODELS}"

    # CPU-only, every accelerator off. Gathm never asks audio.cpp for GPU
    # inference: phones have no usable CUDA/Vulkan path, and a desktop GPU
    # build would demand a whole toolchain just to speak a sentence.
    local -a cm_args=(
        -DCMAKE_BUILD_TYPE=Release
        -DENGINE_ENABLE_CUDA=OFF
        -DENGINE_ENABLE_HIP=OFF
        -DENGINE_ENABLE_VULKAN=OFF
        -DENGINE_ENABLE_METAL=OFF
        -DENGINE_BUILD_EXAMPLES=OFF
        -DENGINE_BUILD_TESTS=OFF
        -DENGINE_BUILD_WARMBENCH=OFF
        # Compiles the package specs into the binary. Upstream's own answer to
        # "model contract spec not found": without it the CLI must be run from
        # the source tree for any family whose spec is not embedded in its GGUF.
        -DAUDIOCPP_DEPLOYMENT_BUILD=ON
    )
    # CMake 4 removed compatibility with cmake_minimum_required(VERSION < 3.5),
    # and vendored dependencies (sentencepiece, parts of ggml) still declare
    # older minimums — configure then dies before a single file is compiled.
    # This is CMake's own escape hatch for exactly that. Only passed to CMake 4+:
    # older CMake would just report it as an unused variable.
    local cmake_major
    cmake_major=$(cmake --version 2>/dev/null | head -1 \
                  | sed -E 's/[^0-9]*([0-9]+).*/\1/')
    if [[ "$cmake_major" =~ ^[0-9]+$ ]] && (( cmake_major >= 4 )); then
        info "CMake $cmake_major detected — allowing pre-3.5 policy minimums"
        cm_args+=( -DCMAKE_POLICY_VERSION_MINIMUM=3.5 )
    fi

    if [[ "$model_set" == "custom" ]]; then
        cm_args+=( -DAUDIOCPP_MODEL_SET=custom -DAUDIOCPP_MODELS="$models" )
        info "Model families: $models"
    else
        cm_args+=( -DAUDIOCPP_MODEL_SET="$model_set" )
        info "Model set: $model_set"
    fi
    # Android needs the vendored sentencepiece patched before anything is
    # configured, or the build dies in sentencepiece-static.
    if _is_termux; then
        _audiocpp_patch_termux_sentencepiece "$src"
    fi

    # A patch that just landed invalidates CMake's cache: it captured the old
    # compile options. Discard the build dir so configure genuinely re-runs.
    if (( _AUDIOCPP_FRESH_CONFIGURE == 1 )) && [[ -d "$build_dir" ]]; then
        info "Source patched — discarding the stale CMake cache in $build_dir"
        rm -rf "$build_dir" 2>/dev/null || true
    fi

    local attempt=1 rc=0
    while (( attempt <= 2 )); do
        # Each attempt is strictly more conservative than the last, because a
        # failed attempt on a phone costs 20-60 minutes — two tries, not a
        # matrix.
        local -a tune
        if (( attempt == 1 )); then
            # The configuration verified on-device: native-ISA kernels, OpenMP
            # threading, llamafile SGEMM. Ninja if we have it — the target
            # graph is large and it schedules better than Make.
            tune=(
                -DENGINE_ENABLE_NATIVE_CPU=ON
                -DENGINE_ENABLE_OPENMP=ON
                -DENGINE_ENABLE_LLAMAFILE=ON
            )
            # Apple clang ships without OpenMP. Asking for it on a Mac without
            # brew's libomp fails configure for a threading library the models
            # are small enough not to need, so it is off there by default.
            if _is_darwin && [[ ! -e "$(brew --prefix 2>/dev/null)/opt/libomp" ]]; then
                tune=(
                    -DENGINE_ENABLE_NATIVE_CPU=ON
                    -DENGINE_ENABLE_OPENMP=OFF
                    -DENGINE_ENABLE_LLAMAFILE=ON
                )
            fi
            if command -v ninja &>/dev/null; then
                tune+=( -G Ninja )
            fi
            info "Configuring audio.cpp (CPU, native ISA)..."
        else
            # Portable fallback: the three options that actually break on
            # Android — -march=native is rejected by some clang builds, libomp
            # may be absent, and llamafile's SGEMM kernels lean on the ISA
            # detection native-CPU was providing — plus the default generator,
            # in case Ninja was the problem.
            warn "Retrying with portable flags (no native ISA, no OpenMP, no llamafile, default generator)..."
            tune=(
                -DENGINE_ENABLE_NATIVE_CPU=OFF
                -DENGINE_ENABLE_OPENMP=OFF
                -DENGINE_ENABLE_LLAMAFILE=OFF
            )
            # Stale cache entries would otherwise pin the failed configuration
            # (and a generator change requires a clean build dir regardless).
            rm -rf "$build_dir" 2>/dev/null || true
        fi

        rc=0
        run_with_spinner "cmake configure (audio.cpp)" -- \
            cmake -S "$src" -B "$build_dir" "${cm_args[@]}" "${tune[@]}" || rc=$?

        if (( rc == 0 )); then
            info "Compiling audiocpp_cli with $jobs parallel job(s) — this is the long part."
            if _is_termux; then
                info "On a phone this can take 20-60 min. Keep Termux in the foreground"
                info "(Android kills background builds) and stay on a charger."
            fi
            run_with_spinner "cmake --build (audiocpp_cli)" -- \
                cmake --build "$build_dir" --parallel "$jobs" --target audiocpp_cli || rc=$?
        fi

        if (( rc == 0 )) && [[ -x "$build_dir/bin/audiocpp_cli" ]]; then
            return 0
        fi

        attempt=$(( attempt + 1 ))
    done

    return 1
}

# Put the built binary on PATH at $LOCAL_BIN/audiocpp_cli and confirm it runs.
_audiocpp_install_bin() {
    local src="$1"
    local built="$src/build/bin/audiocpp_cli"
    local target="$LOCAL_BIN/audiocpp_cli"

    [[ -x "$built" ]] || return 1
    mkdir -p "$LOCAL_BIN" 2>/dev/null || true

    if ! cp "$built" "$target" 2>/dev/null; then
        warn "Could not copy audiocpp_cli into $LOCAL_BIN"
        return 1
    fi
    chmod +x "$target" 2>/dev/null || true

    # A copied binary can lose sibling shared objects that live in the build
    # tree (ggml links statically by default, but a shared build would not).
    # Verify the copy actually runs; if it doesn't, replace it with a wrapper
    # that execs the binary in place rather than leave a broken command
    # on PATH that fails later, mid-conversation.
    if "$target" --help >/dev/null 2>&1; then
        return 0
    fi

    warn "Copied audiocpp_cli won't run standalone — installing a wrapper instead"
    cat > "$target" <<EOF
#!/usr/bin/env bash
# Gathm wrapper: run audiocpp_cli from its build tree so it can find the
# shared libraries built alongside it.
exec "$built" "\$@"
EOF
    chmod +x "$target" 2>/dev/null || true

    if "$target" --help >/dev/null 2>&1; then
        return 0
    fi
    warn "audiocpp_cli still won't run — see $src/build for build output"
    return 1
}

# Record where the runtime lives so Pilot (and --check) can find it without
# re-deriving any of this. Mirrors _save_model_config's ~/.gathm + .env split.
_audiocpp_save_config() {
    local bin="$1" src="$2"
    local config_dir="$HOME/.gathm"
    mkdir -p "$config_dir" 2>/dev/null || true
    echo "$bin"      > "$config_dir/audiocpp_path"  2>/dev/null || true
    echo "$src"      > "$config_dir/audiocpp_src"   2>/dev/null || true
    echo "audio.cpp" > "$config_dir/audio_backend"  2>/dev/null || true

    # Everything Pilot needs to build a TTS command line, so it never has to
    # hardcode a family name or guess where the weights went.
    local model_dir; model_dir=$(_audiocpp_model_dir "$src") || true
    echo "$AUDIOCPP_TTS_FAMILY" > "$config_dir/audiocpp_family" 2>/dev/null || true
    echo "$AUDIOCPP_TTS_VOICE"  > "$config_dir/audiocpp_voice"  2>/dev/null || true
    [[ -n "$model_dir" ]] && { echo "$model_dir" > "$config_dir/audiocpp_model" 2>/dev/null || true; }

    _audiocpp_write_env GATHM_AUDIOCPP_BIN    "$bin"
    _audiocpp_write_env GATHM_AUDIOCPP_FAMILY "$AUDIOCPP_TTS_FAMILY"
    _audiocpp_write_env GATHM_AUDIOCPP_VOICE  "$AUDIOCPP_TTS_VOICE"
    [[ -n "$model_dir" ]] && _audiocpp_write_env GATHM_AUDIOCPP_MODEL "$model_dir"

    ok "Speech runtime registered: $bin"
}

# Upsert KEY=VALUE in the repo .env (GNU sed first, then BSD's -i '' form).
_audiocpp_write_env() {
    local key="$1" value="$2"
    local env_file="$SCRIPT_DIR/.env"
    if [[ -f "$env_file" ]] && grep -q "^${key}=" "$env_file" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$env_file" 2>/dev/null || \
            sed -i '' "s|^${key}=.*|${key}=${value}|" "$env_file" 2>/dev/null || true
    else
        echo "${key}=${value}" >> "$env_file" 2>/dev/null || true
    fi
}

# Echo the directory holding the PocketTTS weights, or nothing.
# model_manager_v2.py installs to models/PocketTTS-GGUF/english, but resolve it
# by locating the .gguf instead of trusting that layout across versions.
_audiocpp_model_dir() {
    local src="$1" hit f
    # Expected layout first. A for-loop over the glob, not `[[ -f dir/*.gguf ]]`
    # — inside [[ ]] the pattern is never expanded, so that test can only fail.
    for f in "$src/$AUDIOCPP_TTS_MODEL_REL"/*.gguf; do
        if [[ -f "$f" ]]; then
            echo "$src/$AUDIOCPP_TTS_MODEL_REL"; return 0
        fi
    done
    # `|| true` guards `set -o pipefail`: head closing the pipe kills find with
    # SIGPIPE, which would otherwise fail this precisely when there is a lot to
    # find.
    # Prefer a TTS-looking path before anything else: with an ASR family also
    # installed, models/ holds weights this function must not return.
    hit=$(find "$src/models" -maxdepth 4 -iname '*.gguf' -type f -ipath '*tts*' \
            2>/dev/null | head -1) || true
    if [[ -z "$hit" ]]; then
        hit=$(find "$src/models" -maxdepth 4 -name '*.gguf' -type f \
                -not -ipath "*$(basename "$AUDIOCPP_ASR_MODEL_REL")*" \
                -not -ipath '*asr*' 2>/dev/null | head -1) || true
    fi
    if [[ -n "$hit" ]]; then
        dirname "$hit"; return 0
    fi
    echo ""
    return 1
}

# Where the transcription weights live, same two-step logic as the voice model.
_audiocpp_asr_model_dir() {
    local src="$1" hit f
    for f in "$src/$AUDIOCPP_ASR_MODEL_REL"/*.gguf; do
        if [[ -f "$f" ]]; then
            echo "$src/$AUDIOCPP_ASR_MODEL_REL"; return 0
        fi
    done
    hit=$(find "$src/models" -maxdepth 4 -iname '*.gguf' -type f \
            \( -ipath '*asr*' -o -ipath '*sensevoice*' \) 2>/dev/null | head -1) || true
    if [[ -n "$hit" ]]; then
        dirname "$hit"; return 0
    fi
    echo ""
    return 1
}

_audiocpp_has_asr_model() {
    local src="$1" dir
    dir=$(_audiocpp_asr_model_dir "$src") || true
    [[ -n "$dir" ]]
}

# Was the ASR family actually compiled into this binary? An install built
# before sense_asr became a default has TTS only, and downloading 250 MB of
# weights it cannot load would be worse than saying so.
_audiocpp_asr_loader_present() {
    local bin="$1"
    [[ -n "$bin" ]] || return 1
    _audiocpp_list_loaders "$bin" | grep -qi "$AUDIOCPP_ASR_FAMILY"
}

# Are the voice weights on disk?
_audiocpp_has_model() {
    local src="$1" dir
    dir=$(_audiocpp_model_dir "$src") || true
    [[ -n "$dir" ]]
}

# Download the PocketTTS weights with the project's own model manager.
#
# Deliberately not pip or a hand-rolled curl of the .gguf: the model spec knows
# which files belong to the package (weights *and* embeddings/alba.safetensors)
# and puts them in the layout audiocpp_cli expects. Fetching just the .gguf
# yields a model that loads and then has no voice.
#
# model_manager_v2.py is standard-library only — urllib, not requests or
# huggingface_hub — so this stays consistent with the no-pip rule on Termux. It
# needs the `python` package and nothing else.
_audiocpp_install_tts_model() {
    local src="$1"
    local mgr="$src/tools/model_manager_v2.py"

    if _audiocpp_has_model "$src"; then
        ok "Voice model already installed ($(_audiocpp_model_dir "$src"))"
        return 0
    fi

    if [[ "${GATHM_AUDIOCPP_SKIP_MODEL:-0}" == "1" ]]; then
        warn "Skipping voice model download (GATHM_AUDIOCPP_SKIP_MODEL=1)"
        note_missing "audio.cpp voice model" \
            "python $mgr install $AUDIOCPP_TTS_PACKAGE"
        return 1
    fi

    if [[ ! -f "$mgr" ]]; then
        warn "model_manager_v2.py not found at $mgr — cannot fetch the voice model"
        note_missing "audio.cpp voice model" \
            "grab a GGUF from huggingface.co/audio-cpp/audio.cpp-gguf"
        return 1
    fi

    local py; py=$(_python_cmd)
    if [[ -z "$py" ]]; then
        pkg install -y python 2>/dev/null || true
        py=$(_python_cmd)
    fi
    if [[ -z "$py" ]]; then
        warn "Python not available — cannot run the model manager"
        note_missing "audio.cpp voice model" "pkg install python && python $mgr install $AUDIOCPP_TTS_PACKAGE"
        return 1
    fi

    # Roughly 1 GB of weights; refuse rather than fill the phone.
    local free_mb; free_mb=$(_detect_free_disk_mb "$src") || true
    if [[ "$free_mb" =~ ^[0-9]+$ ]] && (( free_mb > 0 && free_mb < 1536 )); then
        warn "Only ${free_mb} MB free — skipping the voice model download (needs ~1.5 GB)"
        note_missing "audio.cpp voice model (${free_mb} MB free)" \
            "free up ~1.5 GB, then: python $mgr install $AUDIOCPP_TTS_PACKAGE"
        return 1
    fi

    info "Downloading voice model $AUDIOCPP_TTS_PACKAGE (a few hundred MB)..."
    # Run from inside the source tree so the manager finds model_specs/, and pin
    # the output with --models-root rather than relying on cwd for both.
    # --progress gives the spinner real download progress to display instead of
    # a silent multi-hundred-MB wait.
    run_with_spinner "model_manager install $AUDIOCPP_TTS_PACKAGE" -- \
        bash -c "cd '$src' && '$py' '$mgr' install '$AUDIOCPP_TTS_PACKAGE' \
                    --models-root '$src/models' --progress" || true

    if _audiocpp_has_model "$src"; then
        ok "Voice model installed ($(_audiocpp_model_dir "$src"))"
        return 0
    fi

    warn "Voice model download did not complete."
    echo -e "     Retry with: ${BOLD}cd $src && $py tools/model_manager_v2.py install $AUDIOCPP_TTS_PACKAGE${RESET}"
    note_missing "audio.cpp voice model" \
        "cd $src && python tools/model_manager_v2.py install $AUDIOCPP_TTS_PACKAGE"
    return 1
}

# Download the transcription weights. Same shape as the voice model, with a
# smaller free-space floor because SenseVoice-Small is ~250 MB, not ~1 GB.
_audiocpp_install_asr_model() {
    local src="$1"
    local mgr="$src/tools/model_manager_v2.py"

    if _audiocpp_has_asr_model "$src"; then
        ok "Speech-to-text model already installed ($(_audiocpp_asr_model_dir "$src"))"
        return 0
    fi

    if [[ "${GATHM_AUDIOCPP_SKIP_ASR_MODEL:-${GATHM_AUDIOCPP_SKIP_MODEL:-0}}" == "1" ]]; then
        warn "Skipping speech-to-text model download"
        note_missing "audio.cpp speech-to-text model" \
            "python $mgr install $AUDIOCPP_ASR_PACKAGE"
        return 1
    fi

    if [[ ! -f "$mgr" ]]; then
        warn "model_manager_v2.py not found at $mgr — cannot fetch the ASR model"
        note_missing "audio.cpp speech-to-text model" \
            "grab a GGUF from huggingface.co/audio-cpp/audio.cpp-gguf"
        return 1
    fi

    local py; py=$(_python_cmd)
    if [[ -z "$py" ]]; then
        pkg install -y python 2>/dev/null || true
        py=$(_python_cmd)
    fi
    if [[ -z "$py" ]]; then
        warn "Python not available — cannot run the model manager"
        note_missing "audio.cpp speech-to-text model" \
            "pkg install python && python $mgr install $AUDIOCPP_ASR_PACKAGE"
        return 1
    fi

    local free_mb; free_mb=$(_detect_free_disk_mb "$src") || true
    if [[ "$free_mb" =~ ^[0-9]+$ ]] && (( free_mb > 0 && free_mb < 768 )); then
        warn "Only ${free_mb} MB free — skipping the speech-to-text model (needs ~350 MB)"
        note_missing "audio.cpp speech-to-text model (${free_mb} MB free)" \
            "free up ~350 MB, then: python $mgr install $AUDIOCPP_ASR_PACKAGE"
        return 1
    fi

    info "Downloading speech-to-text model $AUDIOCPP_ASR_PACKAGE (~250 MB)..."
    run_with_spinner "model_manager install $AUDIOCPP_ASR_PACKAGE" -- \
        bash -c "cd '$src' && '$py' '$mgr' install '$AUDIOCPP_ASR_PACKAGE' \
                    --models-root '$src/models' --progress" || true

    if _audiocpp_has_asr_model "$src"; then
        ok "Speech-to-text model installed ($(_audiocpp_asr_model_dir "$src"))"
        return 0
    fi

    warn "Speech-to-text model download did not complete."
    echo -e "     Retry with: ${BOLD}cd $src && $py tools/model_manager_v2.py install $AUDIOCPP_ASR_PACKAGE${RESET}"
    note_missing "audio.cpp speech-to-text model" \
        "cd $src && python tools/model_manager_v2.py install $AUDIOCPP_ASR_PACKAGE"
    return 1
}

# Record the ASR weights and family for lib/speech.py to find.
_audiocpp_save_asr_path() {
    local src="$1" model_dir
    model_dir=$(_audiocpp_asr_model_dir "$src") || true
    [[ -n "$model_dir" ]] || return 0
    mkdir -p "$HOME/.gathm" 2>/dev/null || true
    echo "$model_dir"          > "$HOME/.gathm/audiocpp_asr_model"  2>/dev/null || true
    echo "$AUDIOCPP_ASR_FAMILY" > "$HOME/.gathm/audiocpp_asr_family" 2>/dev/null || true
    _audiocpp_write_env GATHM_AUDIOCPP_ASR_MODEL  "$model_dir"
    _audiocpp_write_env GATHM_AUDIOCPP_ASR_FAMILY "$AUDIOCPP_ASR_FAMILY"
}

# Microphone capture. audio.cpp takes a file, so something has to produce one:
# on Android that is termux-microphone-record (termux-api package *and* the
# Termux:API app), and since it cannot encode WAV, ffmpeg converts to the
# 16 kHz mono the ASR models want.
_audiocpp_install_recorder() {
    if _is_darwin; then
        # No termux-api here: capture goes through ffmpeg's avfoundation input
        # (sox's `rec` works too, if the user already has it).
        if ! command -v ffmpeg &>/dev/null && ! command -v rec &>/dev/null; then
            info "Installing microphone support (ffmpeg)..."
            command -v brew &>/dev/null && _brew_install ffmpeg || true
        fi
        if command -v ffmpeg &>/dev/null || command -v rec &>/dev/null; then
            ok "Microphone capture ($(command -v ffmpeg &>/dev/null && echo ffmpeg || echo rec))"
            info "macOS will ask for microphone permission the first time you use it."
            return 0
        fi
        warn "No microphone capture — transcribing existing files still works"
        note_missing "microphone capture for voice input" "brew install ffmpeg"
        return 1
    fi
    _is_termux || return 0
    if ! command -v termux-microphone-record &>/dev/null; then
        info "Installing microphone support..."
        pkg install -y termux-api 2>/dev/null || true
    fi
    command -v ffmpeg &>/dev/null || pkg install -y ffmpeg 2>/dev/null || true

    local rc=0
    if command -v termux-microphone-record &>/dev/null; then
        ok "Microphone capture (termux-microphone-record)"
        info "Voice input also needs the Termux:API app from F-Droid, and mic permission."
    else
        warn "No microphone capture — transcribing existing files still works"
        note_missing "microphone capture for voice input" \
            "pkg install termux-api, plus the Termux:API app from F-Droid"
        rc=1
    fi
    if command -v ffmpeg &>/dev/null; then
        ok "Audio conversion (ffmpeg)"
    else
        warn "ffmpeg missing — recordings cannot be converted to 16 kHz WAV"
        note_missing "ffmpeg for voice input" "pkg install ffmpeg"
        rc=1
    fi
    return $rc
}

# Transcribe the WAV the TTS smoke test just produced. One check, both
# directions: if this prints words, the whole speech loop works on this device.
_audiocpp_asr_smoke_test() {
    local bin="$1" src="$2"
    local model_dir; model_dir=$(_audiocpp_asr_model_dir "$src") || true
    [[ -n "$model_dir" ]] || return 1
    [[ -n "$_AUDIOCPP_SMOKE_WAV" && -s "$_AUDIOCPP_SMOKE_WAV" ]] || return 1

    local seg="${TMPDIR:-${PREFIX:+$PREFIX/tmp}}"; seg="${seg:-/tmp}"
    seg="$seg/gathm-asr-smoketest.$$.json"
    rm -f "$seg" 2>/dev/null || true

    info "Testing transcription..."
    if run_with_spinner "transcribing the test phrase" -- \
            bash -c "cd '$src' 2>/dev/null || true; '$bin' --task asr \
                   --family '$AUDIOCPP_ASR_FAMILY' \
                   --model '$model_dir' \
                   --backend cpu \
                   --audio '$_AUDIOCPP_SMOKE_WAV' \
                   --segments-out '$seg'"; then
        ok "Transcription works (family '$AUDIOCPP_ASR_FAMILY')"
        rm -f "$seg" 2>/dev/null || true
        return 0
    fi

    rm -f "$seg" 2>/dev/null || true
    warn "Transcription model is installed but the test run failed."
    echo -e "     Try manually: ${BOLD}$bin --task asr --family $AUDIOCPP_ASR_FAMILY \\"
    echo -e "       --model $model_dir --backend cpu --audio some.wav --metrics${RESET}"
    note_missing "audio.cpp transcription" "see the manual command above"
    return 1
}

# Set up the listening half: weights, config, a round-trip test, and the tools
# needed to capture audio in the first place.
_audiocpp_setup_listening() {
    local bin="$1" src="$2"

    if ! _audiocpp_asr_loader_present "$bin"; then
        warn "This build has no '$AUDIOCPP_ASR_FAMILY' loader — voice input unavailable"
        echo -e "     Add it with: ${BOLD}GATHM_AUDIOCPP_MODELS=$AUDIOCPP_DEFAULT_MODELS \\"
        echo -e "       GATHM_AUDIOCPP_FORCE=1 ./install${RESET}"
        info "The rebuild reuses the existing build directory, so it compiles the"
        info "new family only rather than starting over."
        note_missing "speech-to-text (loader not compiled in)" \
            "GATHM_AUDIOCPP_MODELS=$AUDIOCPP_DEFAULT_MODELS GATHM_AUDIOCPP_FORCE=1 ./install"
        return 1
    fi

    if _audiocpp_install_asr_model "$src"; then
        _audiocpp_save_asr_path "$src"
        _audiocpp_asr_smoke_test "$bin" "$src" || true
        _audiocpp_install_recorder || true
    fi
}

# Synthesize a throwaway WAV to prove the whole chain works: binary links,
# loaders are compiled in, weights load, the voice resolves, audio comes out.
# Cheaper to find out here than the first time Pilot tries to talk.
_audiocpp_smoke_test() {
    local bin="$1" src="$2"
    local model_dir; model_dir=$(_audiocpp_model_dir "$src") || true
    [[ -n "$model_dir" ]] || return 1

    local tmp_dir="${TMPDIR:-${PREFIX:+$PREFIX/tmp}}"; tmp_dir="${tmp_dir:-/tmp}"
    local out="$tmp_dir/gathm-tts-smoketest.$$.wav"
    rm -f "$out" 2>/dev/null || true

    info "Testing speech synthesis..."
    if run_with_spinner "synthesizing a test phrase" -- \
            bash -c "cd '$src' 2>/dev/null || true; '$bin' --task tts \
                   --family '$AUDIOCPP_TTS_FAMILY' \
                   --model '$model_dir' \
                   --backend cpu \
                   --voice-id '$AUDIOCPP_TTS_VOICE' \
                   --text 'Gathm speech is online.' \
                   --out '$out'" \
        && [[ -s "$out" ]]; then
        local kb=$(( $(wc -c < "$out" 2>/dev/null || echo 0) / 1024 ))
        ok "Speech synthesis works (${kb} KB WAV, voice '$AUDIOCPP_TTS_VOICE')"
        # Kept, not deleted: the ASR smoke test transcribes this exact file, and
        # _audiocpp_setup_voice removes it once both directions have run.
        _AUDIOCPP_SMOKE_WAV="$out"
        return 0
    fi

    rm -f "$out" 2>/dev/null || true
    warn "audiocpp_cli built and weights are present, but synthesis failed."
    echo -e "     Try manually: ${BOLD}$bin --task tts --family $AUDIOCPP_TTS_FAMILY \\"
    echo -e "       --model $model_dir --backend cpu --voice-id $AUDIOCPP_TTS_VOICE \\"
    echo -e "       --text \"hello\" --out hello.wav --metrics${RESET}"
    note_missing "audio.cpp speech synthesis" "see the manual command above"
    return 1
}

# Record the resolved weights directory. Separate from _audiocpp_save_config
# because that runs right after the build, before the model exists.
_audiocpp_save_model_path() {
    local src="$1" model_dir
    model_dir=$(_audiocpp_model_dir "$src") || true
    [[ -n "$model_dir" ]] || return 0
    mkdir -p "$HOME/.gathm" 2>/dev/null || true
    echo "$model_dir" > "$HOME/.gathm/audiocpp_model" 2>/dev/null || true
    _audiocpp_write_env GATHM_AUDIOCPP_MODEL "$model_dir"
}

# Fetch the weights, record where they landed, then prove the chain end-to-end.
_audiocpp_setup_voice() {
    local bin="$1" src="$2"
    if _audiocpp_install_tts_model "$src"; then
        _audiocpp_save_model_path "$src"
        _audiocpp_smoke_test "$bin" "$src" || true
        _audiocpp_install_player || true
    fi
    # Listening is independent of speaking: a build with the ASR loader can
    # transcribe even if the voice model never downloaded.
    _audiocpp_setup_listening "$bin" "$src" || true
    if [[ -n "$_AUDIOCPP_SMOKE_WAV" ]]; then
        rm -f "$_AUDIOCPP_SMOKE_WAV" 2>/dev/null || true
        _AUDIOCPP_SMOKE_WAV=""
    fi
}

# Build audio.cpp from source. Must stay pip-free (see the section comment
# above): on Android there is no wheel to fall back to.
_audiocpp_build_and_install() {
    local src; src=$(_audiocpp_src_dir)

    # Before anything expensive: can we avoid compiling altogether? A published
    # binary wins, then a cached build from a previous install on this device.
    # Both are verified by actually running --list-loaders, so a stale or
    # wrong-architecture file falls through to the source build rather than
    # installing something broken.
    if [[ "${GATHM_AUDIOCPP_FORCE_BUILD:-0}" != "1" ]]; then
        if _audiocpp_fetch_prebuilt; then
            local pre; pre=$(_audiocpp_bin) || true
            _audiocpp_save_config "$pre" "$src"
            step_done "audio.cpp installed from a prebuilt binary"
            _audiocpp_setup_voice "$pre" "$src"
            return 0
        fi
        if _audiocpp_cache_restore; then
            local cachedbin; cachedbin=$(_audiocpp_bin) || true
            _audiocpp_save_config "$cachedbin" "$src"
            step_done "audio.cpp restored from cache (no compile)"
            # The weights live in the source tree, so it still has to exist for
            # the voice/ASR models — clone it, but skip the build entirely.
            if [[ ! -d "$src/.git" ]]; then
                _audiocpp_install_build_deps || true
                _audiocpp_clone_or_update "$src" || true
            fi
            _audiocpp_setup_voice "$cachedbin" "$src"
            return 0
        fi
    fi

    # Source tree plus a full ggml build needs real space, and a phone that
    # runs out mid-compile fails in a way that is tedious to diagnose.
    # `|| true`: the detector returns non-zero when free space is unknown.
    local free_mb; free_mb=$(_detect_free_disk_mb "$src") || true
    if [[ "$free_mb" =~ ^[0-9]+$ ]] && (( free_mb > 0 && free_mb < 3072 )); then
        step_skip "Skipping audio.cpp: needs ~3 GB, only ${free_mb} MB free"
        note_missing "audio.cpp speech runtime (${free_mb} MB free)" \
            "free up ~3 GB, then re-run ./install"
        return 0
    fi

    # `|| ...` deliberately: under `set -euo pipefail` a bare call that returns
    # non-zero exits the whole installer. A Mac with no Xcode command line
    # tools would have aborted here, taking the shortcuts, the verify step and
    # the completion message with it — for an optional feature.
    if ! _audiocpp_install_build_deps; then
        step_fail "audio.cpp needs a build toolchain that could not be installed"
        note_missing "audio.cpp speech runtime" \
            "install the toolchain above, then: ./install --audio-only"
        return 0
    fi

    if ! _audiocpp_clone_or_update "$src"; then
        step_fail "audio.cpp clone failed — Pilot will run without voice"
        note_missing "audio.cpp speech runtime" \
            "git clone $AUDIOCPP_REPO $src && ./install"
        return 0
    fi

    local t0=$SECONDS
    if ! _audiocpp_cmake_build "$src"; then
        step_fail "audio.cpp build failed after $(_format_elapsed $(( SECONDS - t0 )))"
        warn "Build log tail is above. The known-good Termux sequence is:"
        warn "  cd $src"
        warn "  echo 'target_compile_options(sentencepiece-static PRIVATE -U__ANDROID__)' \\"
        warn "    >> external/sentencepiece/src/CMakeLists.txt"
        warn "  rm -rf build"
        warn "  cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \\"
        warn "    -DENGINE_ENABLE_CUDA=OFF -DENGINE_ENABLE_HIP=OFF \\"
        warn "    -DENGINE_ENABLE_VULKAN=OFF -DENGINE_ENABLE_METAL=OFF \\"
        warn "    -DENGINE_ENABLE_NATIVE_CPU=ON -DENGINE_ENABLE_OPENMP=ON \\"
        warn "    -DENGINE_ENABLE_LLAMAFILE=ON -DAUDIOCPP_MODEL_SET=custom \\"
        warn "    -DAUDIOCPP_MODELS=pocket_tts"
        warn "  cmake --build build --target audiocpp_cli -j$(_audiocpp_jobs)"
        note_missing "audio.cpp speech runtime" "see build output in $src/build"
        return 0
    fi

    if ! _audiocpp_install_bin "$src"; then
        step_fail "audiocpp_cli built but could not be installed to $LOCAL_BIN"
        note_missing "audiocpp_cli on PATH" "cp $src/build/bin/audiocpp_cli $LOCAL_BIN/"
        return 0
    fi

    local bin; bin=$(_audiocpp_bin) || true
    _audiocpp_save_config "$bin" "$src"
    _audiocpp_cache_save "$bin"
    step_done "audio.cpp built and installed in $(_format_elapsed $(( SECONDS - t0 )))"
    _audiocpp_setup_voice "$bin" "$src"
}

# Entry point. Termux and macOS: on Android it is the only speech path that
# works at all, and on macOS it is the only speech-to-text path there is (`say`
# covers speaking, but the OS exposes no CLI for listening). Every other
# platform is left exactly as it was, with whatever it already uses.
install_audio_cpp() {
    local platform="$1"

    if ! _audiocpp_supported; then
        # Name the platform actually detected. The version of this message that
        # did not said "built on Termux and macOS only" while skipping on a Mac,
        # which read as a supported platform being deliberately skipped.
        step_skip "audio.cpp skipped: platform is '${platform}' (built on Termux and macOS)"
        return 0
    fi

    # Already have it? Register and move on — this is the fast path that keeps
    # re-running ./install cheap instead of recompiling for an hour.
    local existing; existing=$(_audiocpp_bin) || true
    if [[ -n "$existing" && "${GATHM_AUDIOCPP_FORCE:-0}" != "1" ]]; then
        _audiocpp_save_config "$existing" "$(_audiocpp_src_dir)"
        # Seed the cache from a binary that already works, so the next install
        # (or a reinstall after uninstall) needs no compile.
        [[ -f "$(_audiocpp_cache_file)" ]] || _audiocpp_cache_save "$existing"
        step_done "audio.cpp already installed ($existing)"
        _audiocpp_setup_voice "$existing" "$(_audiocpp_src_dir)"
        return 0
    fi

    # Escape hatch for anyone who wants a fast install and no voice.
    if [[ "${GATHM_INSTALL_AUDIO_CPP:-}" == "0" ]]; then
        step_skip "audio.cpp skipped (GATHM_INSTALL_AUDIO_CPP=0)"
        return 0
    fi

    if [[ "$GATHM_ONLINE" != "true" ]]; then
        step_skip "audio.cpp skipped (offline — the source has to be cloned)"
        note_missing "audio.cpp speech runtime" "re-run ./install while online"
        return 0
    fi

    _audiocpp_build_and_install
}

# --- Create command shortcuts ---
# gathm and gathm-agent: symlinked directly — simpler, always in sync with
#   the source, and uninstall just removes the links.
# gathm-api: needs a thin wrapper to select the right Python interpreter
#   (venv vs system) since server.py is not a standalone executable.
setup_shortcuts() {
    local platform="$1"
    info "Creating command shortcuts..."

    local bin_dir="$HOME/.local/bin"
    mkdir -p "$bin_dir"

    # gathm — symlink to the main executable
    chmod +x "$SCRIPT_DIR/gathm" 2>/dev/null || true
    ln -sf "$SCRIPT_DIR/gathm" "$bin_dir/gathm"

    # gathm-agent — symlink to the orchestrator
    chmod +x "$SCRIPT_DIR/agent/orchestrator.sh" 2>/dev/null || true
    ln -sf "$SCRIPT_DIR/agent/orchestrator.sh" "$bin_dir/gathm-agent"

    # gathm-api — thin wrapper: picks venv python when available
    local shebang="#!/usr/bin/env bash"
    [[ "$platform" == "termux" ]] && shebang="#!/data/data/com.termux/files/usr/bin/bash"

    local api_python_cmd
    if [[ -x "$GATHM_VENV/bin/python3" ]]; then
        api_python_cmd="$GATHM_VENV/bin/python3"
    elif command -v python3 &>/dev/null; then
        api_python_cmd="python3"
    else
        api_python_cmd="python"
    fi
    cat > "$bin_dir/gathm-api" << SCRIPT
$shebang
exec $api_python_cmd "$SCRIPT_DIR/api/server.py" "\$@"
SCRIPT
    chmod +x "$bin_dir/gathm-api"

    # Add ~/.local/bin to PATH if not already there
    local rc_file=""
    if [[ "$platform" == "termux" ]]; then
        rc_file="$HOME/.bashrc"
    elif [[ -f "$HOME/.zshrc" ]]; then rc_file="$HOME/.zshrc"
    elif [[ -f "$HOME/.bashrc" ]]; then rc_file="$HOME/.bashrc"
    elif [[ -f "$HOME/.bash_profile" ]]; then rc_file="$HOME/.bash_profile"
    elif [[ -f "$HOME/.profile" ]]; then rc_file="$HOME/.profile"
    else rc_file="$HOME/.bashrc"
    fi

    [[ -f "$rc_file" ]] || touch "$rc_file"
    if [[ -n "$rc_file" ]] && ! grep -q '.local/bin' "$rc_file" 2>/dev/null; then
        echo '' >> "$rc_file"
        echo '# Gathm Framework' >> "$rc_file"
        echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$rc_file"
        info "Added ~/.local/bin to PATH in $rc_file"
    fi

    ok "Shortcuts created: gathm → $SCRIPT_DIR/gathm"
    ok "                   gathm-agent → $SCRIPT_DIR/agent/orchestrator.sh"
    ok "                   gathm-api (wrapper, python: $api_python_cmd)"
}

# --- Start the GUI API server in the background ---
# Sets global GUI_PORT and GUI_URL
GUI_PORT=8080
GUI_URL="http://127.0.0.1:${GUI_PORT}"

start_gui_server() {
    # Prefer the pilot venv's Python — that's where FastAPI + uvicorn were
    # installed. Fall back to system python only if the venv is unavailable.
    local python_cmd=""
    _init_venv
    if [[ -n "$GATHM_VENV" && -x "$GATHM_VENV/bin/python3" ]]; then
        python_cmd="$GATHM_VENV/bin/python3"
    elif command -v python3 &>/dev/null; then
        python_cmd="python3"
    elif command -v python &>/dev/null; then
        python_cmd="python"
    fi

    if [[ -z "$python_cmd" ]]; then
        warn "Python not found — cannot start GUI server"
        return 1
    fi

    local server_script="$SCRIPT_DIR/api/server.py"
    if [[ ! -f "$server_script" ]]; then
        warn "API server not found at $server_script — skipping GUI"
        return 1
    fi

    # Something already listening? Do not just return — the installer has only
    # just (re)staged the code, so a server left over from an earlier run is
    # still serving the OLD api/server.py. That is precisely how a newly added
    # endpoint keeps returning the old error: the GUI POSTs to a route that
    # exists on disk but not in the running process, falls through to the
    # StaticFiles mount, and comes back 405.
    #
    # Restart our own server only. Anything else holding the port belongs to
    # someone else and is left alone.
    if curl -s --max-time 2 "$GUI_URL/" &>/dev/null; then
        if ! command -v pgrep >/dev/null 2>&1; then
            warn "GUI server already running at $GUI_URL, and pgrep is unavailable"
            warn "so it cannot be identified. If the GUI behaves like older code,"
            warn "restart it manually:  pkill -f api/server.py  then re-run ./install"
            return 0
        fi

        # Match on the "api/server.py" suffix rather than $server_script's
        # absolute path: the server may have been launched relative to another
        # cwd or through the gathm-api shortcut, and an absolute-path match then
        # silently misses it, leaving the stale process serving.
        #
        # Then filter hard. `pgrep -f` matches any process whose *command line*
        # contains the pattern, which includes wrapper shells — and, in the
        # wrong circumstances, this installer itself. Skip our own pid and our
        # parent, and require the command line to actually be a Python process,
        # which is what rules out a shell that merely mentions the path.
        local _old_pids="" _p _cmd
        for _p in $(pgrep -f 'api/server\.py' 2>/dev/null || true); do
            [[ "$_p" == "$$" || "$_p" == "${PPID:-0}" ]] && continue
            if [[ -r "/proc/$_p/cmdline" ]]; then
                _cmd=$(tr '\0' ' ' < "/proc/$_p/cmdline" 2>/dev/null) || _cmd=""
                [[ "$_cmd" == *python* ]] || continue
            fi
            _old_pids+="$_p "
        done
        _old_pids="${_old_pids%% }"

        if [[ -z "${_old_pids// /}" ]]; then
            ok "GUI server already running at $GUI_URL (not ours — leaving it alone)"
            return 0
        fi

        info "Restarting GUI server so it serves the current code (pid: ${_old_pids})..."
        # shellcheck disable=SC2086  # word splitting is intended for the pid list
        kill $_old_pids 2>/dev/null || true
        local _w=0
        while (( _w < 5 )) && curl -s --max-time 1 "$GUI_URL/" &>/dev/null; do
            sleep 1
            _w=$((_w + 1))
        done
        if curl -s --max-time 1 "$GUI_URL/" &>/dev/null; then
            # shellcheck disable=SC2086
            kill -9 $_old_pids 2>/dev/null || true
            sleep 1
        fi
    fi

    info "Starting GUI server on port $GUI_PORT..."
    local _log_dir="${PREFIX:+$PREFIX/tmp}"; _log_dir="${_log_dir:-${TMPDIR:-/tmp}}"
    nohup "$python_cmd" "$server_script" --port "$GUI_PORT" &>"$_log_dir/gathm-gui.log" &
    local _gui_pid=$!
    # Record the pid where the launcher looks for it, so `gathm stop` can shut
    # down the server the installer started instead of telling the user to pkill.
    mkdir -p "$HOME/.gathm" 2>/dev/null || true
    echo "$_gui_pid" >"$HOME/.gathm/gui.pid" 2>/dev/null || true
    disown "$_gui_pid" 2>/dev/null || true

    # Wait up to 15 s for the server to respond (Termux can be slow)
    local _max_wait=15
    # `:-` so the function stays callable (and testable) before main() sets it.
    [[ "${_GATHM_PLATFORM:-}" != "termux" ]] && _max_wait=8
    local i=0
    while (( i < _max_wait )); do
        sleep 1
        if curl -s --max-time 2 "$GUI_URL/" &>/dev/null; then
            ok "GUI server started at ${CYAN}${GUI_URL}${RESET}"
            return 0
        fi
        i=$((i + 1))
    done

    warn "GUI server did not respond in time — check $_log_dir/gathm-gui.log"
    if [[ -s "$_log_dir/gathm-gui.log" ]]; then
        echo -e "${YELLOW}    ── last lines of gathm-gui.log ──${RESET}"
        tail -n 15 "$_log_dir/gathm-gui.log" 2>/dev/null | sed 's/^/      /'
    fi

    return 1
}

# --- Launch Pilot and open GUI browser after install ---
launch_post_install() {
    local platform="${1:-linux}"

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "${BOLD}${GREEN}Launching Gathm...${RESET}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    # 1. Start GUI server in background
    if start_gui_server; then
        # 2. Open GUI in default browser
        info "Opening GUI in browser..."
        open_url "$GUI_URL" "$platform"
        echo -e "  ${CYAN}GUI:${RESET} $GUI_URL"
    fi

    echo ""

    # 3. Determine how to launch Pilot (prefer venv set by install_pilot_deps)
    local python_cmd="${_PILOT_PYTHON:-}"
    if [[ -z "$python_cmd" ]]; then
        local venv_python="$SCRIPT_DIR/pilot/venv/bin/python"
        [[ -x "$venv_python" ]] && python_cmd="$venv_python"
    fi
    [[ -z "$python_cmd" ]] && command -v python3 &>/dev/null && python_cmd="python3"
    [[ -z "$python_cmd" ]] && command -v python  &>/dev/null && python_cmd="python"

    local pilot_run="$SCRIPT_DIR/pilot/run.sh"
    local pilot_main="$SCRIPT_DIR/pilot/main.py"

    if [[ ! -f "$pilot_run" && ! -f "$pilot_main" ]]; then
        warn "Pilot not available — start it manually: bash pilot/run.sh"
        return 0
    fi

    echo -e "${BOLD}Starting Pilot AI...${RESET}"
    echo -e "  ${YELLOW}(Press Ctrl+C or type /exit to quit Pilot)${RESET}"
    echo ""

    # Hand off to Pilot via run.sh (activates venv) or python directly as fallback
    cd "$SCRIPT_DIR"
    if [[ -f "$pilot_run" ]]; then
        exec bash "$pilot_run"
    else
        exec "$python_cmd" "$pilot_main"
    fi
}

# --- Verify everything ---
verify() {
    local errors=0
    local plat="${_GATHM_PLATFORM:-$(detect_platform)}"
    _GATHM_MISSING=()   # reset the optional-components list for this run

    echo ""
    echo -e "${BOLD}Verification${RESET}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Platform
    ok "Platform: $plat | $(uname -s) | Bash ${BASH_VERSION:-?}"

    # Core commands
    for cmd in bash curl jq git; do
        if command -v "$cmd" &>/dev/null; then
            ok "$cmd"
        else
            fail "$cmd NOT FOUND"; errors=$((errors + 1))
        fi
    done

    # Python
    if command -v python3 &>/dev/null; then
        ok "python3 ($(python3 --version 2>&1))"
    elif command -v python &>/dev/null; then
        ok "python ($(python --version 2>&1))"
    else
        fail "python NOT FOUND"; errors=$((errors + 1))
    fi

    # Tools
    local tc=0
    for dir in "$SCRIPT_DIR"/tools/*/; do
        local n; n=$(basename "$dir")
        [[ -f "$dir/$n" ]] && tc=$((tc + 1))
    done
    ok "$tc tools available"

    # Connectivity
    if [[ "$GATHM_ONLINE" == "true" ]]; then
        ok "Network: Online"
    else
        warn "Network: Offline"
    fi

    # LLM backend + model
    local llm_backend="ollama"
    [[ -f "$HOME/.gathm/llm_backend" ]] && llm_backend=$(cat "$HOME/.gathm/llm_backend")
    case "$llm_backend" in
        gemini)
            ok "LLM backend: Google Gemini (free tier)"
            if [[ -f "$HOME/.gathm/model" ]]; then
                ok "LLM model: $(cat "$HOME/.gathm/model")"
            fi
            ;;
        ollama)
            if command -v ollama &>/dev/null; then
                ok "LLM backend: Ollama ($(ollama --version 2>&1 | head -1))"
            else
                warn "LLM backend: Ollama not installed (optional — needed for Pilot AI)"
                note_missing "Ollama runtime" "curl -fsSL https://ollama.com/install.sh | sh  (or pkg install ollama on Termux)"
            fi
            # Confirm the configured model is actually downloaded, not just named.
            local want_model=""
            [[ -f "$HOME/.gathm/model" ]] && want_model=$(cat "$HOME/.gathm/model" 2>/dev/null | tr -d '[:space:]')
            if [[ -n "$want_model" ]]; then
                if command -v ollama &>/dev/null \
                        && ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$want_model"; then
                    ok "LLM model pulled: $want_model"
                else
                    warn "LLM model '$want_model' not downloaded yet"
                    # If the shortfall is storage, say so and adjust the fix hint.
                    local _free_mb; _free_mb=$(_detect_free_disk_mb "${OLLAMA_MODELS:-$HOME/.ollama/models}")
                    if (( _free_mb > 0 && _free_mb < $(_model_size_mb "$want_model") + 1024 )); then
                        note_missing "Ollama model $want_model (only ${_free_mb} MB free)" \
                            "free up storage, then: ollama pull $want_model"
                    else
                        note_missing "Ollama model $want_model" "ollama pull $want_model"
                    fi
                fi
            fi
            ;;
        *)
            warn "LLM backend: not configured (Pilot AI unavailable)"
            note_missing "LLM backend" "re-run ./install while online, or set a Gemini key"
            ;;
    esac

    # ── Pilot runtime: venv + the Python packages Pilot imports at startup ──
    # We actually IMPORT each module (not just find_spec) so a native library
    # failure is caught here instead of only blowing up when Pilot starts.
    _init_venv
    local pilot_py="$GATHM_VENV/bin/python3"
    if [[ -x "$pilot_py" ]]; then
        local missing_mods
        missing_mods=$("$pilot_py" - <<'PY' 2>/dev/null
# Import what Pilot actually imports, not just the top-level packages.
#
# Importing `langchain_core` and `langgraph` alone is not a useful check: both
# top-level packages import cleanly even when the submodules Pilot needs are
# broken. langchain_core resolves public names lazily via module __getattr__,
# so a version mismatch only surfaces on the real `from ... import ...`. That
# gap let verify() report "All checks passed!" on a phone where Pilot then
# died at startup on langchain_core.runnables.base.
#
# Each entry is (statement to execute, pip package to blame).
checks = [
    ("import pydantic_core", "pydantic"),
    ("from langchain_core.messages import AIMessage, BaseMessage, HumanMessage",
     "langchain-core"),
    ("from langchain_core.runnables import Runnable", "langchain-core"),
    ("from langgraph.graph import StateGraph, END", "langgraph"),
    ("import rich", "rich"),
    ("import dotenv", "python-dotenv"),
    ("import prompt_toolkit", "prompt_toolkit"),
    ("import bs4", "beautifulsoup4"),
    ("import requests", "requests"),
]
missing = []
details = []
for stmt, pkg in checks:
    try:
        exec(stmt, {})
    except Exception as exc:
        if pkg not in missing:
            missing.append(pkg)
        # Keep the real exception: "langchain-core is missing" is misleading
        # when the package is installed and something it imports is not. The
        # underlying message names the actual culprit.
        details.append("%s: %s: %s" % (stmt.split(" import ")[0], type(exc).__name__, exc))
# Line 1: packages to blame. Remaining lines: what actually went wrong.
print(" ".join(missing))
for d in details:
    print(d)
PY
)
        # First line is the package list; any following lines are the real
        # exceptions, which is what actually identifies the problem.
        local _dep_pkgs _dep_details
        _dep_pkgs=$(printf '%s\n' "$missing_mods" | head -1)
        _dep_details=$(printf '%s\n' "$missing_mods" | tail -n +2)
        if [[ -z "$_dep_pkgs" ]]; then
            ok "Pilot runtime (venv + dependencies)"
        else
            warn "Pilot runtime missing/broken: $_dep_pkgs"
            if [[ -n "$_dep_details" ]]; then
                printf '%s\n' "$_dep_details" | sed 's/^/       /'
            fi
            note_missing "Pilot Python deps" "pip install -r pilot/requirements.txt  (missing: $_dep_pkgs)"
        fi

        # GUI/API server needs FastAPI + uvicorn (installed into the same venv).
        if "$pilot_py" -c "import fastapi, uvicorn" 2>/dev/null; then
            ok "GUI server dependencies (fastapi, uvicorn)"
            # uvicorn loads the app as "api.server:app", so that module path has
            # to resolve from the repo root. find_spec checks it without
            # executing the module, so this needs no running server.
            if "$pilot_py" -c "
import importlib.util, sys
sys.path.insert(0, '$SCRIPT_DIR')
sys.exit(0 if importlib.util.find_spec('api.server') else 1)
" 2>/dev/null; then
                ok "GUI app importable (api.server)"
            else
                warn "GUI app not importable as api.server (GUI won't start)"
                note_missing "GUI app (api.server)" "check $SCRIPT_DIR/api/server.py is present and importable"
            fi
        else
            warn "GUI server dependencies missing (GUI won't start; Pilot CLI still works)"
            note_missing "GUI deps (fastapi/uvicorn)" "pip install fastapi uvicorn"
        fi
    else
        warn "Pilot venv not found"
        note_missing "Pilot venv" "re-run ./install (creates pilot/venv from requirements.txt)"
    fi

    # ── Browser engine (powers Pilot's 'browser' tool) ──
    if [[ "$plat" == "termux" ]]; then
        if command -v chromium >/dev/null 2>&1 || command -v chromium-browser >/dev/null 2>&1; then
            ok "Browser engine (system Chromium)"
        else
            warn "Chromium not installed (browser control limited to open/fetch)"
            note_missing "Chromium (browser tool)" "pkg install tur-repo x11-repo && pkg install chromium"
        fi
    else
        if [[ -x "$GATHM_VENV/bin/playwright" ]] && "$pilot_py" -c "import playwright" 2>/dev/null; then
            ok "Browser engine (Playwright)"
        else
            warn "Playwright browser not fully installed (browser control limited)"
            note_missing "Playwright Chromium" "playwright install chromium"
        fi
    fi

    # ── Speech runtime (what lets Pilot talk) ──
    local audio_bin audio_src
    audio_bin=$(_audiocpp_bin) || true
    audio_src=$(_audiocpp_src_dir)
    # --list-loaders is the better probe than --help: it only reports
    # "pocket_tts: tts (offline)" if the TTS family was actually compiled in.
    if [[ -n "$audio_bin" ]] \
            && { _audiocpp_list_loaders "$audio_bin" >/dev/null 2>&1 || "$audio_bin" --help >/dev/null 2>&1; }; then
        ok "Speech runtime (audio.cpp: $audio_bin)"
        if _audiocpp_list_loaders "$audio_bin" | grep -qi "$AUDIOCPP_TTS_FAMILY"; then
            ok "TTS loader compiled in ($AUDIOCPP_TTS_FAMILY)"
        fi
        # The binary alone cannot speak — it needs weights.
        if _audiocpp_has_model "$audio_src"; then
            ok "Voice model ($(_audiocpp_model_dir "$audio_src"), voice '$AUDIOCPP_TTS_VOICE')"
            # Synthesis without playback is silence, so this is part of "works".
            local audio_player; audio_player=$(_audiocpp_player) || true
            if [[ -n "$audio_player" ]]; then
                ok "Audio playback ($audio_player)"
            else
                warn "No audio player — Pilot renders speech but cannot play it"
                note_missing "audio player for speech playback" \
            "$(_is_darwin && echo 'brew install mpv' || echo 'pkg install mpv')"
            fi
        else
            warn "No voice model downloaded yet (Pilot stays silent until one is)"
            note_missing "audio.cpp voice model" \
                "cd $audio_src && python tools/model_manager_v2.py install $AUDIOCPP_TTS_PACKAGE"
        fi
        # ── Listening (what lets Pilot hear) ──
        if _audiocpp_asr_loader_present "$audio_bin"; then
            ok "Transcription loader compiled in ($AUDIOCPP_ASR_FAMILY)"
            if _audiocpp_has_asr_model "$audio_src"; then
                ok "Speech-to-text model ($(_audiocpp_asr_model_dir "$audio_src"))"
                if command -v termux-microphone-record &>/dev/null; then
                    ok "Microphone capture (termux-microphone-record)"
                elif [[ "$plat" == "termux" ]]; then
                    warn "No microphone capture — file transcription still works"
                    note_missing "microphone capture for voice input" \
                        "pkg install termux-api, plus the Termux:API app from F-Droid"
                fi
                # Recordings arrive as AAC/Opus; the ASR models want 16 kHz WAV.
                if command -v ffmpeg &>/dev/null; then
                    ok "Audio conversion (ffmpeg)"
                elif [[ "$plat" == "termux" ]]; then
                    warn "ffmpeg missing — recordings cannot be converted for the model"
                    note_missing "ffmpeg for voice input" "pkg install ffmpeg"
                fi
            else
                warn "No speech-to-text model downloaded yet (voice input unavailable)"
                note_missing "audio.cpp speech-to-text model" \
                    "cd $audio_src && python tools/model_manager_v2.py install $AUDIOCPP_ASR_PACKAGE"
            fi
        elif [[ "$plat" == "termux" ]]; then
            warn "Built without the '$AUDIOCPP_ASR_FAMILY' loader (no voice input)"
            note_missing "speech-to-text (loader not compiled in)" \
                "GATHM_AUDIOCPP_MODELS=$AUDIOCPP_DEFAULT_MODELS GATHM_AUDIOCPP_FORCE=1 ./install"
        fi
    elif [[ -n "$audio_bin" ]]; then
        warn "audiocpp_cli found but won't run ($audio_bin)"
        note_missing "audio.cpp speech runtime" \
            "GATHM_AUDIOCPP_FORCE=1 ./install"
    elif [[ "$plat" == "termux" ]]; then
        warn "Speech runtime not installed (Pilot runs, just without voice)"
        note_missing "audio.cpp speech runtime" "re-run ./install"
    fi
    # Off Termux there is nothing to report: audio.cpp is not part of that
    # install, so a missing binary is the expected state, not a finding.

    # Agent smoke test
    if bash "$SCRIPT_DIR/agent/orchestrator.sh" list --json &>/dev/null; then
        ok "Agent orchestrator"
    else
        fail "Agent orchestrator broken"; errors=$((errors + 1))
    fi

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Optional / degraded components — Gathm still runs, these add features.
    if (( ${#_GATHM_MISSING[@]} > 0 )); then
        echo -e "${BOLD}${YELLOW}Still missing${RESET} (optional — core Gathm works without these):"
        local item comp fix
        for item in "${_GATHM_MISSING[@]}"; do
            comp="${item%%|*}"; fix="${item#*|}"
            printf '  %b○ %-22s%b  fix: %s\n' "$YELLOW" "$comp" "$RESET" "$fix"
        done
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    fi

    if [[ $errors -eq 0 && ${#_GATHM_MISSING[@]} -eq 0 ]]; then
        ok "All checks passed!"
    elif [[ $errors -eq 0 ]]; then
        ok "Core install OK — ${#_GATHM_MISSING[@]} optional item(s) missing (see above)"
    else
        fail "$errors required issue(s) found"
    fi
    return $errors
}

# --- Uninstall ---
uninstall() {
    info "Removing Gathm shortcuts..."
    rm -f "$HOME/.local/bin/gathm" "$HOME/.local/bin/gathm-agent" "$HOME/.local/bin/gathm-api"
    rm -f "$HOME/.local/bin/audiocpp_cli"

    # The audio.cpp checkout is only deleted when it lives inside ~/.gathm
    # (the default). A checkout somewhere else — ~/audio.cpp, or a custom
    # GATHM_AUDIOCPP_SRC — is left alone, since we did not create it.
    # Either way say which happened: rebuilding costs up to an hour on a phone.
    local audio_src; audio_src=$(_audiocpp_src_dir)
    if [[ -d "$audio_src" && "$audio_src" == "$HOME/.gathm/"* ]]; then
        warn "Deleting the audio.cpp build at $audio_src (a rebuild takes 20-60 min on a phone)"
    fi

    info "Removing data directory..."
    rm -rf "$HOME/.gathm"

    if [[ -d "$audio_src" ]]; then
        warn "audio.cpp source kept at $audio_src (delete manually to reclaim the space)"
    fi
    ok "Uninstalled. Source directory not removed: $SCRIPT_DIR"
}

# --- Reload shell config (best effort) ---
reload_shell_config() {
    # DO NOT source ~/.bashrc, ~/.bash_profile, or any rc file here.
    #
    # On macOS it is common for ~/.bashrc to contain 'exec zsh', which
    # replaces the running bash process with zsh.  When invoked via
    # 'source', exec replaces the INSTALL SCRIPT'S bash process, which
    # then exits cleanly (exit 0) — silently terminating the install
    # without firing the ERR trap or printing any error.
    #
    # PATH was already prepended with ~/.local/bin at the top of this
    # script (export PATH="$LOCAL_BIN:$PATH"), so the installed commands
    # are already accessible for the rest of the install.  The user's
    # interactive shell will see the updated PATH the next time they
    # open a terminal or run 'source ~/.zshrc'.
    export PATH="$LOCAL_BIN:$PATH"
    return 0
}

# --- Main ---
main() {
    echo ""
    echo -e "${BOLD}${GREEN}Gathm Enterprise v$VERSION - Setup${RESET}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    case "${1:-install}" in
        --check|-c)
            verify; exit $? ;;
        --uninstall|-u)
            uninstall; exit 0 ;;
        --audio-only|--speech)
            # Just the speech runtime. Re-running the whole installer to retry
            # one compile means sitting through eleven unrelated steps.
            _GATHM_PLATFORM=$(detect_platform)
            info "Platform detected: ${_GATHM_PLATFORM}"
            check_internet
            step_begin "Installing audio.cpp (speech runtime)"
            install_audio_cpp "$_GATHM_PLATFORM"
            echo ""
            info "Now check it with:  python3 lib/speech.py --check"
            exit 0 ;;
        --help|-h)
            echo "Usage: ./install [OPTION]"
            echo ""
            echo "Options:"
            echo "  (default)     Auto-detect platform and install"
            echo "  --check       Verify environment only"
            echo "  --audio-only  Install just the speech runtime (audio.cpp)"
            echo "  --uninstall   Remove shortcuts and data"
            echo "  --help        Show this help"
            exit 0 ;;
    esac

    local platform
    platform=$(detect_platform)
    # Expose platform globally so sub-functions (e.g. Gemini fallback) can use it
    _GATHM_PLATFORM="$platform"

    # Visible step count. Termux has one extra step (storage permission),
    # which runs first so a permission-grant restart costs no real work.
    # Steps: [storage] connectivity, python, deps, files, ollama, llm-model,
    # pilot-deps, playwright, audio.cpp, shortcuts, verify.
    if [[ "$platform" == "termux" ]]; then
        _GATHM_TOTAL_STEPS=12
    else
        _GATHM_TOTAL_STEPS=11
    fi

    # Termux storage permission FIRST: granting it can restart Termux, so we
    # do it before any heavy work. It's idempotent, so a re-run skips it.
    if [[ "$platform" == "termux" ]]; then
        step_begin "Configuring Termux storage"
        setup_termux_storage "$platform"
        step_done "Storage configured"
    fi

    step_begin "Checking internet connectivity"
    check_internet
    if [[ "$GATHM_ONLINE" == "true" ]]; then
        step_done "Network reachable"
    else
        step_skip "Offline — online-only steps will be skipped"
    fi

    # Verify Python 3.8+ is present before touching the venv or pip.
    # This runs before install_deps so a missing Python surfaces immediately
    # with a clear message rather than a cryptic venv failure later.
    step_begin "Verifying Python toolchain (3.8+)"
    check_and_install_python "$platform"
    step_done "Python toolchain ready"

    step_begin "Installing OS dependencies"
    install_deps "$platform"
    step_done "OS dependencies installed"

    step_begin "Staging gathm files"
    setup_files
    step_done "Files staged"

    # Install Ollama + pull the best available model first.
    # Pilot needs a running LLM to function, so we set up the AI runtime
    # before installing Python deps — this also means the model is ready
    # by the time Pilot starts for the first time.
    # If Ollama cannot be installed, falls back to Google Gemini free tier.
    step_begin "Installing Ollama (local LLM runtime)"
    install_ollama "$platform"
    # install_ollama emits step_done / step_skip / step_fail itself.

    step_begin "Selecting LLM model"
    select_and_pull_llm_model
    step_done "LLM model configuration complete"

    # TODO(engineer): temporarily disabled — re-enable when resuming the
    # engineer agent. Uncomment the line below to restore engineer setup.
    # install_engineer_deps
    step_begin "Installing Pilot AI Python dependencies"
    install_pilot_deps
    step_done "Pilot AI dependencies installed"

    step_begin "Installing Playwright browser engine"
    install_playwright_browser
    step_done "Browser engine ready"

    # Speech runtime (lets Pilot talk). Native C++ on every platform — on
    # Termux that is the only thing that works, so it runs by default there
    # and is opt-in elsewhere. Emits its own step_done / step_skip / step_fail.
    step_begin "Installing audio.cpp (speech runtime)"
    install_audio_cpp "$platform"

    step_begin "Installing shell shortcuts"
    setup_shortcuts "$platform"
    step_done "Shortcuts installed"

    reload_shell_config

    step_begin "Running final verification"
    verify || true   # non-zero return just means warnings; never abort setup
    step_done "Verification complete"

    step_summary

    echo ""
    echo -e "${BOLD}${GREEN}Setup Complete!${RESET}"
    echo ""

    # Pilot clears the screen when it launches, so persist the "still missing"
    # report to a file and leave a short pointer here — the last thing the user
    # sees before hand-off. verify() populated _GATHM_MISSING just above.
    if (( ${#_GATHM_MISSING[@]} > 0 )); then
        local report="$HOME/.gathm/install_report.txt"
        mkdir -p "$HOME/.gathm" 2>/dev/null || true
        {
            echo "Gathm install — still missing (optional, core Gathm works without these):"
            local _m
            for _m in "${_GATHM_MISSING[@]}"; do
                echo "  - ${_m%%|*}"
                echo "      fix: ${_m#*|}"
            done
        } > "$report" 2>/dev/null || true

        warn "${#_GATHM_MISSING[@]} optional component(s) still missing (core Gathm works)."
        echo -e "     Saved to ${CYAN}$report${RESET}"
        echo -e "     Re-check anytime with: ${BOLD}./install --check${RESET}"
        echo ""
    fi

    # Start GUI + hand off to Pilot in the current terminal
    launch_post_install "$platform"
}

main "$@"
