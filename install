#!/bin/bash
## Author: hakxcore
## Gathm Installer (formerly Termux-Snippets)

currentVersion="3.0.0"

#colors
RED="$(printf '\033[31m')" GREEN="$(printf '\033[32m')" ORANGE="$(printf '\033[33m')" BLUE="$(printf '\033[34m')"
MAGENTA="$(printf '\033[35m')" CYAN="$(printf '\033[36m')" WHITE="$(printf '\033[37m')" BLACK="$(printf '\033[30m')" 
REDBG="$(printf '\033[41m')" GREENBG="$(printf '\033[42m')" ORANGEBG="$(printf '\033[43m')" BLUEBG="$(printf '\033[44m')", 
MAGENTABG="$(printf '\033[45m')" CYANBG="$(printf '\033[46m')" WHITEBG="$(printf '\033[47m')" BLACKBG="$(printf '\033[40m')"
RESETBG="$(printf '\e[0m')" BLINK="$(printf '\033[5;31m')"

##Platform Check
if [[ "$OSTYPE" == "darwin" ]]; then
    distro="darwin"
    platform="Darwin"
    prefix=""
    SUDO="sudo"
elif [[ "$OSTYPE" == linux-android* ]]; then
    distro="termux"
    platform="Termux"
    prefix="/data/data/com.termux/files/"
    SUDO=""
elif [ -f "/etc/os-release" ]; then
    distro="$(source /etc/os-release && echo $ID)"
    platform="Linux"
    prefix=""
    SUDO="sudo"
else # Fallback for other Linux or unknown systems
    # Try the gawk-dependent command but redirect stderr to /dev/null
    # to avoid errors on systems where 'match' with 'groups' is not supported.
    # This might still lead to an empty distro if gawk is not available.
    distro=$(ls /etc 2>/dev/null | awk 'match($0, "(.+?)[-_](?:release|version)", groups) {if(groups[1] != "os") {print groups[1]}}')
    if [ -z "$distro" ]; then
        distro="invalid"
    fi
    platform="Unknown Linux/Other"
    prefix=""
    SUDO="sudo"
fi

checkDialog()
{
  if ! command -v dialog &>/dev/null; then
    echo "${BLUE}Installing dialog...${RESETBG}"
    case "$distro" in
      termux)
        pkg install -y dialog || { echo "${RED}Error: Failed to install dialog. Please install it manually.${RESETBG}"; exit 1; }
        ;;
      debian|ubuntu|kali)
        $SUDO apt-get update && $SUDO apt-get install -y dialog || { echo "${RED}Error: Failed to install dialog. Please install it manually.${RESETBG}"; exit 1; }
        ;;
      darwin)
        if command -v brew &>/dev/null; then
          brew install dialog || { echo "${RED}Error: Failed to install dialog. Please install it manually using Homebrew.${RESETBG}"; exit 1; }
        else
          echo "${RED}Error: Homebrew not found. Please install dialog manually.${RESETBG}"; exit 1;
        fi
        ;;
      *)
        echo "${RED}Error: dialog not found and automatic installation is not supported for your distribution ('$distro'). Please install it manually.${RESETBG}"; exit 1;
        ;;
    esac
  fi 
}

checkPv()
{
  if ! command -v pv &>/dev/null; then
    echo "${BLUE}Installing pv...${RESETBG}"
    case "$distro" in
      termux)
        pkg install -y pv || { echo "${RED}Error: Failed to install pv. Please install it manually.${RESETBG}"; exit 1; }
        ;;
      debian|ubuntu|kali)
        $SUDO apt-get update && $SUDO apt-get install -y pv || { echo "${RED}Error: Failed to install pv. Please install it manually.${RESETBG}"; exit 1; }
        ;;
      darwin)
        if command -v brew &>/dev/null; then
          brew install pv || { echo "${RED}Error: Failed to install pv. Please install it manually using Homebrew.${RESETBG}"; exit 1; }
        else
          echo "${RED}Error: Homebrew not found. Please install pv manually.${RESETBG}"; exit 1;
        fi
        ;;
      *)
        echo "${RED}Error: pv not found and automatic installation is not supported for your distribution ('$distro'). Please install it manually.${RESETBG}"; exit 1;
        ;;
    esac
  fi 
}

# while-menu-dialog: a menu driven Operating system chooseing Installation  program

DIALOG_CANCEL=1
DIALOG_ESC=255
HEIGHT=0
WIDTH=0

display_termux() {
  dialog --prgbox $1 ./installation 50 80
}

display_debian() {
  dialog --prgbox $1 ./installation 50 80
}

checkDialog
checkPv
while true; do
  exec 3>&1
  selection=$(dialog \
    --backtitle "Gathm Installer" \
    --title "Gathm Installation" \
    --clear \
    --cancel-label "Exit" \
    --menu "Choose OS:" $HEIGHT $WIDTH 4 \
    "1" "Termux" \
    "2" "Debian OS" \
    2>&1 1>&3)
  exit_status=$?
  exec 3>&-
  case $exit_status in
    $DIALOG_CANCEL)
      clear
      if command -v gathm &>/dev/null
      then
        echo -e ""$GREEN"\t\t\tInstallation Sucessfull." | pv -qL 15
        echo -e "\n\t\t\t\U1F449 gathm \U1F448\n"
        else
        echo -e "\t\t\tInstallation Unsucessfull\n"
      fi
      exit
      ;;
    $DIALOG_ESC)
      clear
      echo "Program aborted." >&2
      exit 1
      ;;
  esac
  case $selection in
    1 )
    if [[ "$SUDO" == "" ]] 
    then
      display_termux "TERMUX"
      else
        echo "Wrong Choice"
    fi
    ;;
    2 )
    if [[ "$SUDO" == "sudo" ]] 
    then
      result=$(echo "Debian";)
      display_debian "DEBIAN"
      else
        echo "Wrong Choice"
    fi
      
      ;;
  esac
done

