# --- Platform detection ---
detect_platform() {
    local kernel
    kernel=$(uname -s 2>/dev/null || echo "unknown")
    case "$kernel" in
        Darwin)       echo "macos" ;;
        MINGW*|MSYS*) echo "windows" ;;
        CYGWIN*)      echo "windows" ;;
        Linux)
            if command -v termux-setup-storage &>/dev/null; then
                echo "termux"
            elif grep -qi microsoft /proc/version 2>/dev/null; then
                echo "wsl"
            elif command -v apt-get &>/dev/null; then
                echo "debian"
            elif command -v dnf &>/dev/null; then
                echo "fedora"
            elif command -v pacman &>/dev/null; then
                echo "arch"
            elif command -v apk &>/dev/null; then
                echo "alpine"
            elif command -v zypper &>/dev/null; then
                echo "opensuse"
            else
                echo "linux"
            fi
            ;;
        *) echo "unknown" ;;
    esac
}

# --- Install dependencies by platform ---
install_deps() {
    local platform="$1"

    # Core packages every platform needs.
    # openssl is intentionally excluded: macOS ships LibreSSL as 'openssl',
    # and Linux distros pre-install it.  It is only added for Termux and
    # any platform where it is genuinely absent.
    local core="bash curl jq git"

    info "Platform detected: $platform"
    info "Installing dependencies..."

    case "$platform" in
        termux)
            pkg update -y 2>/dev/null || true
            # patchelf: used to adjust RPATHs of prebuilt .so files when needed.
            pkg install -y $core python rust pv dialog wget dnsutils iproute2 net-tools libxml2 patchelf 2>/dev/null || true
            # pydantic-core is a Rust extension. PyPI only ships manylinux/musl
            # wheels (glibc/musl) which Android's Bionic linker cannot load at
            # all — so we MUST use Termux's own Bionic-native build. Installing
            # python-pydantic pulls in the matching python-pydantic-core; the
            # pilot venv (created with --system-site-packages) then imports them
            # directly and pip never touches pydantic-core. Best-effort.
            pkg install -y python-pydantic python-pydantic-core 2>/dev/null || true
            # Note: python-numpy used to be installed here to satisfy
            # langchain-community, but Pilot no longer depends on it (see
            # pilot/requirements.txt), so we skip it — building/compiling numpy
            # on Android was the slow, noisy step and it is no longer needed.
            # Best-effort real zstandard: langsmith (a langchain-core dep) pulls
            # it in, and building it from source on-device is very slow. If
            # Termux ships a prebuilt binding we use it; otherwise the venv gets
            # a pure-Python stub in _create_termux_native_stubs. (zstd = C lib.)
            pkg install -y zstd python-zstandard 2>/dev/null || true
            # libgcc provides libgcc_s.so.1 which is required by manylinux aarch64 wheels
            # compiled with GCC (e.g. pydantic-core). musllinux wheels are preferred but
            # this ensures manylinux fallback wheels also load correctly.
            pkg install -y libgcc 2>/dev/null || true
            pip install pyyaml 2>/dev/null || true
            ;;
        debian|wsl)
            sudo apt-get update -y 2>/dev/null || true
            sudo apt-get install -y $core python3 python3-pip python3-venv pv dialog wget dnsutils iproute2 net-tools libxml2-utils 2>/dev/null || true
            pip3 install pyyaml 2>/dev/null || pip install pyyaml 2>/dev/null || true
            ;;
        fedora)
            sudo dnf install -y $core python3 python3-pip pv dialog wget bind-utils iproute net-tools libxml2 2>/dev/null || true
            pip3 install pyyaml 2>/dev/null || true
            ;;
        arch)
            sudo pacman -Sy --noconfirm $core python python-pip pv dialog wget bind-tools iproute2 net-tools libxml2 2>/dev/null || true
            pip install pyyaml 2>/dev/null || true
            ;;
        alpine)
            apk update 2>/dev/null || true
            apk add $core python3 py3-pip pv dialog wget bind-tools iproute2 net-tools libxml2-utils 2>/dev/null || true
            pip3 install pyyaml 2>/dev/null || true
            ;;
        opensuse)
            sudo zypper install -y $core python3 python3-pip pv dialog wget bind-utils iproute2 net-tools libxml2-tools 2>/dev/null || true
            pip3 install pyyaml 2>/dev/null || true
            ;;
        macos)
            if command -v brew &>/dev/null; then
                # openssl omitted: macOS ships LibreSSL as /usr/bin/openssl
                brew install bash curl jq git python3 pv dialog wget 2>/dev/null || true
                pip3 install pyyaml 2>/dev/null || true
            else
                warn "Homebrew not found. Install it from https://brew.sh"
                warn "Then run: brew install bash curl jq git python3 pv dialog"
            fi
            ;;
        windows)
            if command -v scoop &>/dev/null; then
                scoop install git curl jq python 2>/dev/null || true
            elif command -v choco &>/dev/null; then
                choco install git curl jq python3 -y 2>/dev/null || true
            elif command -v pacman &>/dev/null; then
                # MSYS2
                pacman -Sy --noconfirm $core python python-pip 2>/dev/null || true
            else
                warn "No package manager found (try installing scoop, choco, or MSYS2)"
            fi
            pip install pyyaml 2>/dev/null || pip3 install pyyaml 2>/dev/null || true
            ;;
        *)
            warn "Unknown platform. Please install manually: $core python3 pv jq"
            ;;
    esac

    ok "Dependencies installed"
}

# --- Termux storage permissions (no-op on non-Termux) ---
#
# Granting the Android storage permission can make Termux kill and restart
# its session, which aborts this installer. To keep that from costing the
# user any real work, this step runs FIRST (before any heavy install) and is
# fully idempotent: once $HOME/storage exists it returns instantly, so a
# post-restart re-run of ./install sails straight past it.
setup_termux_storage() {
    local platform="$1"
    [[ "$platform" != "termux" ]] && return 0

    if ! command -v termux-setup-storage >/dev/null 2>&1; then
        warn "termux-setup-storage not found; skipping storage permission setup"
        return 0
    fi

    # Already granted → nothing to do. This is the fast path that makes a
    # re-run after a Termux restart smooth.
    if [[ -d "$HOME/storage" ]]; then
        ok "Termux storage already configured"
        return 0
    fi

    warn "Termux is about to ask for the storage permission."
    warn "Granting it may restart Termux and interrupt this installer."
    warn "If that happens, just run ${BOLD}./install${RESET}${YELLOW} again — it resumes and"
    warn "skips every step that already finished (including this one)."
    # Give the user a few seconds to read this before the Android dialog pops.
    sleep 4

    info "Requesting Termux storage permission..."
    termux-setup-storage 2>/dev/null || true
    sleep 2

    if [[ -d "$HOME/storage" ]]; then
        ok "Termux storage configured"
    else
        warn "Storage folder not detected yet."
        warn "If Termux restarted, re-run ./install — it will pick up from here."
    fi
}

# --- Install Ollama (local LLM runtime) ---
install_ollama() {
    if [[ "$GATHM_ONLINE" != "true" ]]; then
        step_skip "Ollama install skipped (offline)"
        return 0
    fi

    if command -v ollama &>/dev/null; then
        step_done "Ollama already installed ($(ollama --version 2>&1 | head -1))"
        start_ollama_serve
        return 0
    fi

    local platform="$1"

    # Pre-cache sudo credentials. The official Ollama installer calls sudo
    # several times (writing /usr/local/bin, registering systemd units). If
    # sudo prompts mid-download the install can sit waiting for a password
    # behind a wall of curl output — looking exactly like a hung script.
    if [[ "$platform" != "windows" && "$platform" != "termux" ]] \
            && command -v sudo &>/dev/null \
            && ! sudo -n true 2>/dev/null; then
        info "Caching sudo credentials so the Ollama installer doesn't pause for a password later..."
        sudo -v 2>/dev/null || warn "sudo credential cache failed — installer may prompt mid-run"
    fi

    info "Downloads ~700MB (plus GPU drivers if a GPU is detected)."
    info "Typical time: 3-15 min depending on your connection. Live progress below."
    echo ""

    local t0=$SECONDS
    local install_rc=0

    case "$platform" in
        macos)
            if command -v brew &>/dev/null; then
                run_with_spinner "Installing Ollama via Homebrew" -- \
                    brew install ollama || install_rc=$?
            else
                # Foreground so user sees curl + install.sh progress directly.
                curl -fsSL https://ollama.com/install.sh | sh || install_rc=$?
            fi
            ;;
        termux)
            run_with_spinner "Installing Ollama via pkg" -- \
                pkg install -y ollama || install_rc=$?
            ;;
        windows)
            # Try package managers first, then fall back to the official installer exe
            if command -v winget &>/dev/null; then
                run_with_spinner "Installing Ollama via winget" -- \
                    winget install --id Ollama.Ollama --accept-source-agreements \
                        --accept-package-agreements --silent || install_rc=$?
            elif command -v scoop &>/dev/null; then
                info "Installing Ollama via scoop..."
                scoop bucket add extras 2>/dev/null || true
                run_with_spinner "scoop install ollama" -- \
                    scoop install extras/ollama || install_rc=$?
            elif command -v choco &>/dev/null; then
                run_with_spinner "Installing Ollama via Chocolatey" -- \
                    choco install ollama -y || install_rc=$?
            else
                # Download and run the official silent installer
                info "Downloading OllamaSetup.exe (official installer)..."
                local _tmp_dir; _tmp_dir=$(mktemp -d 2>/dev/null || echo "$TEMP/gathm_$$")
                mkdir -p "$_tmp_dir" 2>/dev/null || true
                local _setup_exe="$_tmp_dir/OllamaSetup.exe"
                if curl -fL --progress-bar "https://ollama.com/download/OllamaSetup.exe" \
                        -o "$_setup_exe"; then
                    info "Running OllamaSetup.exe /SILENT..."
                    "$_setup_exe" /SILENT || install_rc=$?
                    rm -f "$_setup_exe" 2>/dev/null || true
                else
                    install_rc=1
                    warn "Could not download Ollama installer."
                    warn "Install manually from: https://ollama.com/download/windows"
                fi
            fi
            ;;
        *)
            # Linux (all distros), WSL — keep install.sh in the foreground so the
            # user sees its real-time progress messages (downloading bundle, setting
            # up systemd, etc.) instead of staring at a silent screen.
            curl -fsSL https://ollama.com/install.sh | sh || install_rc=$?
            ;;
    esac

    local elapsed=$(( SECONDS - t0 ))

    if command -v ollama &>/dev/null; then
        step_done "Ollama installed in $(_format_elapsed $elapsed)"
        start_ollama_serve
    else
        step_fail "Ollama installation failed after $(_format_elapsed $elapsed) — install manually from https://ollama.com"
    fi
}

# --- Ensure ollama serve is running in the background ---
start_ollama_serve() {
    if ! command -v ollama &>/dev/null; then
        return 0
    fi

    # Check if already serving (port 11434)
    if curl -s --max-time 2 http://127.0.0.1:11434/ &>/dev/null; then
        ok "Ollama server already running"
        return 0
    fi

    info "Starting Ollama server (ollama serve)..."
    local _log_dir="${PREFIX:+$PREFIX/tmp}"; _log_dir="${_log_dir:-${TMPDIR:-/tmp}}"
    nohup ollama serve &>"$_log_dir/ollama-serve.log" &
    disown $! 2>/dev/null || true

    # Wait up to 10 s for it to come up
    local i=0
    while (( i < 10 )); do
        sleep 1
        if curl -s --max-time 2 http://127.0.0.1:11434/ &>/dev/null; then
            ok "Ollama server started"
            return 0
        fi
        i=$((i + 1))
    done

    warn "Ollama server did not respond in time — it may still be starting up"
}

# --- Open URL in default browser (best-effort) ---
