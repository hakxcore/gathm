#!/usr/bin/env bash
# Author: Gathm maintainers
# Description: HTTP endpoint probe with status, headers, and latency.

source "$(dirname "$0")/../../lib/utils.bash"

currentVersion="3.0.0"
max_time=15
insecure=0

usage() {
  cat <<EOF
HTTPProbe (v$currentVersion)
Description: Probe an HTTP(S) endpoint and summarize response metadata.

Usage: httpprobe [flags] [url-or-host]
  [url-or-host]  URL or host to probe (default scheme: https://)
  -m <seconds>   Max request time (default: $max_time)
  -k             Skip TLS certificate verification
  -h             Show the help
  -v             Get the tool version

Examples:
  httpprobe openai.com
  httpprobe https://example.com/health
  httpprobe -m 5 -k https://self-signed.badssl.com/
EOF
}

normalize_target() {
  local target="$1"
  if [[ "$target" =~ ^https?:// ]]; then
    echo "$target"
  else
    echo "https://$target"
  fi
}

probe_endpoint() {
  local input="$1"
  local target
  target=$(normalize_target "$input")

  local curl_args=(-sS -L -D - -o /dev/null --max-time "$max_time")
  if [[ "$insecure" -eq 1 ]]; then
    curl_args+=(-k)
  fi

  local meta_fmt
  meta_fmt=$'__GATHM_META__\nHTTP_CODE:%{http_code}\nFINAL_URL:%{url_effective}\nREMOTE_IP:%{remote_ip}\nTIME_TOTAL:%{time_total}\nCONTENT_TYPE:%{content_type}\nSSL_VERIFY:%{ssl_verify_result}\n'

  local output
  output=$(curl "${curl_args[@]}" -w "$meta_fmt" "$target" 2>&1)
  local exit_code=$?
  if [[ $exit_code -ne 0 ]]; then
    echo "Error: probe failed for $target"
    echo "$output" | tail -n 1
    return 1
  fi

  local headers meta
  headers=$(echo "$output" | sed '/^__GATHM_META__$/,$d' | tr -d '\r')
  meta=$(echo "$output" | sed -n '/^__GATHM_META__$/,$p' | sed '1d')

  local http_code final_url remote_ip time_total content_type ssl_verify
  http_code=$(echo "$meta" | awk -F: '/^HTTP_CODE:/{print $2}')
  final_url=$(echo "$meta" | awk -F: '/^FINAL_URL:/{sub(/^FINAL_URL:/,""); print}')
  remote_ip=$(echo "$meta" | awk -F: '/^REMOTE_IP:/{print $2}')
  time_total=$(echo "$meta" | awk -F: '/^TIME_TOTAL:/{print $2}')
  content_type=$(echo "$meta" | awk -F: '/^CONTENT_TYPE:/{sub(/^CONTENT_TYPE:/,""); print}')
  ssl_verify=$(echo "$meta" | awk -F: '/^SSL_VERIFY:/{print $2}')

  local last_header_block
  last_header_block=$(echo "$headers" | awk 'BEGIN{RS=""; ORS=""} {block=$0} END{print block}')

  echo "Target: $target"
  echo "HTTP Status: ${http_code:-N/A}"
  echo "Final URL: ${final_url:-N/A}"
  echo "Remote IP: ${remote_ip:-N/A}"
  echo "Total Time: ${time_total:-N/A}s"
  echo "Content-Type: ${content_type:-N/A}"
  if [[ "$ssl_verify" != "" && "$ssl_verify" != "0" ]]; then
    echo "TLS Verify Result: $ssl_verify (non-zero indicates verification issue)"
  elif [[ "$ssl_verify" == "0" ]]; then
    echo "TLS Verify Result: 0 (certificate verified)"
  fi

  if [[ -n "$last_header_block" ]]; then
    echo "Key Headers:"
    echo "$last_header_block" | grep -Ei '^(HTTP/|server:|date:|location:|strict-transport-security:|x-frame-options:|x-content-type-options:|content-security-policy:|cache-control:)' | sed 's/^/  /'
  fi

  if [[ "${http_code:-000}" == "000" ]]; then
    return 1
  fi
  return 0
}

while getopts "m:kvh" opt; do
  case "$opt" in
    m) max_time="$OPTARG" ;;
    k) insecure=1 ;;
    v) echo "Version $currentVersion"; exit 0 ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [[ ! "$max_time" =~ ^[0-9]+$ ]]; then
  echo "Error: -m expects an integer number of seconds."
  exit 1
fi

if [[ $# -ne 1 ]]; then
  usage
  exit 1
fi

check_dependencies curl
probe_endpoint "$1"
exit $?
