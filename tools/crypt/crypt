#!/usr/bin/env bash
# Author: Hakxcore & Alexander Epstein
# Description: A wrapper around openssl for file encryption and decryption.

# Source the shared utility library
source "$(dirname "$0")/../../lib/utils.bash"

currentVersion="3.0.0"

check_openssl() {
    check_dependencies openssl
}

encrypt()
{
    local input="$1"
    local output="$2"
    if [[ ! -f "$input" ]]; then
        echo "Error: Input file '$input' not found."
        return 1
    fi
    
    echo "Encrypting $input..."
    # Note: openssl 1.1.1+ requires -pbkdf2 for better security and to avoid warnings
    local pbkdf2_flag=""
    openssl version | grep -qE "1\.1\.1|[3-9]\." && pbkdf2_flag="-pbkdf2"
    
    openssl enc -aes-256-cbc -salt -a $pbkdf2_flag -in "$input" -out "$output"
}

decrypt()
{
    local input="$1"
    local output="$2"
    if [[ ! -f "$input" ]]; then
        echo "Error: Input file '$input' not found."
        return 1
    fi
    
    echo "Decrypting $input..."
    local pbkdf2_flag=""
    openssl version | grep -qE "1\.1\.1|[3-9]\." && pbkdf2_flag="-pbkdf2"
    
    openssl enc -aes-256-cbc -d -a $pbkdf2_flag -in "$input" -out "$output"
}

usage()
{
  cat <<EOF
Crypt (v$currentVersion)
Description: Encrypt or decrypt files using AES-256.

Usage: crypt [flag] [inputFile] [outputFile]
  -e  Encrypt file
  -d  Decrypt file
  -h  Show the help
  -v  Get the tool version

Examples:
  crypt -e secret.txt secret.enc
  crypt -d secret.enc secret.txt
EOF
}

# --- Initialize Variables ---
ACTION=""

# --- Option Parsing ---
while getopts "e:d:vh" opt; do
  case "$opt" in
    e) ACTION="encrypt"; INPUT_FILE="$OPTARG"; OUTPUT_FILE="$3" ;;
    d) ACTION="decrypt"; INPUT_FILE="$OPTARG"; OUTPUT_FILE="$3" ;;
    v) echo "Version $currentVersion"; exit 0 ;;
    h) usage; exit 0 ;;
  esac
done

# Fallback for positional if getopts logic is complex with multiple args
if [[ -z "$ACTION" ]]; then
    if [[ "$1" == "-e" ]]; then
        ACTION="encrypt"; INPUT_FILE="$2"; OUTPUT_FILE="$3"
    elif [[ "$1" == "-d" ]]; then
        ACTION="decrypt"; INPUT_FILE="$2"; OUTPUT_FILE="$3"
    else
        usage
        exit 1
    fi
fi

if [[ -z "$INPUT_FILE" || -z "$OUTPUT_FILE" ]]; then
    echo "Error: Missing input or output file."
    usage
    exit 1
fi

check_openssl
if [[ "$ACTION" == "encrypt" ]]; then
    encrypt "$INPUT_FILE" "$OUTPUT_FILE"
else
    decrypt "$INPUT_FILE" "$OUTPUT_FILE"
fi

exit 0
