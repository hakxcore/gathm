#!/usr/bin/env bash
# Author: Gathm maintainers
# Description: ASN and BGP prefix intelligence lookup.

source "$(dirname "$0")/../../lib/utils.bash"

currentVersion="3.0.0"
# api.bgpview.io stopped resolving entirely ("Could not resolve host"), so this
# moved to RIPEstat: free, no key, and run by the RIPE NCC rather than a hobby
# project. GATHM_ASN_API overrides it.
API_BASE="${GATHM_ASN_API:-https://stat.ripe.net/data}"

usage() {
  cat <<EOF
ASN (v$currentVersion)
Description: Lookup ASN details, prefixes, and IP-to-ASN mappings.

Usage: asn [query]
  [query]  ASN (e.g., AS15169 or 15169) or IPv4/IPv6 address
  -h       Show the help
  -v       Get the tool version

Examples:
  asn AS15169
  asn 13335
  asn 8.8.8.8
EOF
}

normalize_query() {
  local value="$1"
  value="${value#http://}"
  value="${value#https://}"
  value="${value%%/*}"
  echo "$value"
}

is_ip_query() {
  local value="$1"
  if [[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    return 0
  fi
  if [[ "$value" == *":"* ]]; then
    return 0
  fi
  return 1
}

is_asn_query() {
  local value
  value=$(echo "$1" | tr '[:lower:]' '[:upper:]')
  [[ "$value" =~ ^AS?[0-9]+$ ]]
}

lookup_asn() {
  local input="$1"
  local query
  query=$(normalize_query "$input")

  local mode
  local endpoint
  local normalized_asn
  if is_ip_query "$query"; then
    mode="ip"
    endpoint="$API_BASE/prefix-overview/data.json?resource=$query"
  elif is_asn_query "$query"; then
    mode="asn"
    normalized_asn=$(echo "$query" | tr '[:lower:]' '[:upper:]' | sed 's/^AS//')
    endpoint="$API_BASE/as-overview/data.json?resource=AS$normalized_asn"
  else
    echo "Error: Query must be an ASN (AS12345) or an IP address."
    return 1
  fi

  local response
  response=$(httpGet "$endpoint")
  if ! printf '%s' "$response" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null; then
    httpJsonError "$endpoint" "$response" "the RIPEstat API"
    return 1
  fi

  # Prefix counts come from a second call; only for an ASN, and only if the
  # first one worked, so a failure here degrades the report rather than it.
  local prefixes=""
  if [[ "$mode" == "asn" ]]; then
    prefixes=$(httpGet "$API_BASE/announced-prefixes/data.json?resource=AS$normalized_asn" 2>/dev/null)
    printf '%s' "$prefixes" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null \
        || prefixes=""
  fi

  # GATHM_PAYLOAD, not a pipe: the heredoc below already occupies stdin (it is
  # the program), so piped data never arrived and every parse failed with
  # "Expecting value: line 1 column 1".
  GATHM_PAYLOAD="${response}" GATHM_PREFIXES="${prefixes}" \
  python3 - "$mode" "$query" <<'PY'
import json
import os
import sys

mode = sys.argv[1]
query = sys.argv[2]

try:
    payload = json.loads(os.environ.get("GATHM_PAYLOAD", ""))
except Exception as exc:
    print(f"Error: Could not parse ASN response ({exc}).")
    sys.exit(1)

if payload.get("status") != "ok":
    message = payload.get("status") or "unknown status"
    print(f"Error: RIPEstat lookup failed ({message}).")
    sys.exit(1)

data = payload.get("data") or {}

if mode == "asn":
    resource = data.get("resource") or query
    holder = data.get("holder") or "N/A"
    announced = data.get("announced")
    block = data.get("block") or {}

    print(f"ASN: AS{str(resource).lstrip('ASas')}")
    print(f"Holder: {holder}")
    print(f"Announced: {'yes' if announced else 'no'}")
    if block:
        print(f"Block: {block.get('resource', 'N/A')} ({block.get('desc') or block.get('name') or 'N/A'})")

    v4, v6 = [], []
    try:
        pref = json.loads(os.environ.get("GATHM_PREFIXES", "") or "{}")
        for entry in (pref.get("data") or {}).get("prefixes") or []:
            value = entry.get("prefix", "")
            (v6 if ":" in value else v4).append(value)
    except Exception:
        pass
    print(f"IPv4 Prefix Count: {len(v4)}")
    print(f"IPv6 Prefix Count: {len(v6)}")
    if v4:
        print("Top IPv4 Prefixes:")
        for value in v4[:5]:
            print(f"  - {value}")
    if v6:
        print("Top IPv6 Prefixes:")
        for value in v6[:5]:
            print(f"  - {value}")
else:
    print(f"IP: {query}")
    print(f"Prefix: {data.get('resource', 'N/A')}")
    asns = data.get("asns") or []
    print(f"Announcing ASNs: {len(asns)}")
    for entry in asns:
        number = entry.get("asn", "N/A")
        holder = entry.get("holder") or "N/A"
        print(f"  - AS{number}  {holder}")
    if data.get("block"):
        blk = data["block"]
        print(f"Block: {blk.get('resource', 'N/A')} ({blk.get('desc') or 'N/A'})")
PY
}

while getopts "vh" opt; do
  case "$opt" in
    v) echo "Version $currentVersion"; exit 0 ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -ne 1 ]]; then
  usage
  exit 1
fi

check_dependencies python3
getConfiguredClient || exit 1
checkInternet || { echo "Error: No internet connection"; exit 1; }

lookup_asn "$1"
exit $?
