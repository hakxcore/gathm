#!/usr/bin/env bash
# Author: Alexander Epstein https://github.com/alexanderepstein
# Description: Checks the available SSL/TLS ciphers for an https site.

# Source the shared utility library
source "$(dirname "$0")/../../lib/utils.bash"

currentVersion="3.0.0"
DELAY=0.1 # Reduced default delay for efficiency, but users can override

usage()
{
  cat <<EOF
Siteciphers (v$currentVersion)
Description: Checks the available ciphers for the SSL of an https site.

Usage: siteciphers [website]
  [website]  The domain to check (e.g., google.com)
  -d <secs>  Delay between requests (default: 0.1)
  -h         Show the help
  -v         Get the tool version

Examples:
  siteciphers github.com
  siteciphers -d 0 google.com
EOF
}

checkCiphers()
{
  local server="$1"
  if [[ "$server" != *":"* ]]; then
      server="${server}:443"
  fi

  check_dependencies openssl
  
  # Get all local ciphers supported by this openssl version
  local ciphers=$(openssl ciphers 'ALL:eNULL' | sed -e 's/:/ /g')

  # LibreSSL and OpenSSL both list well over a hundred ciphers, and each one is
  # a full TCP+TLS round trip: unbounded, this ran for minutes and looked hung.
  local max="${GATHM_SITECIPHERS_MAX:-40}"
  # A total budget, because a per-cipher bound is not enough: a server that
  # simply ignores an unsupported cipher makes each probe wait the full timeout,
  # and 40 of those still overran the harness. This guarantees a report.
  local budget="${GATHM_SITECIPHERS_BUDGET:-25}"
  local started=$SECONDS
  local total=0
  for _c in $ciphers; do total=$((total + 1)); done
  if (( max > 0 && total > max )); then
    ciphers=$(printf '%s\n' $ciphers | head -n "$max" | tr '\n' ' ')
    echo "Checking the first $max of $total local ciphers for $server..."
    echo "(raise with GATHM_SITECIPHERS_MAX, 0 for all)"
  else
    echo "Checking $total ciphers for $server..."
  fi
  print_divider

  local checked=0
  for cipher in $ciphers; do
    # Try connecting with each cipher. run_bounded, not `timeout`: macOS has no
    # GNU timeout, so this call used to fail on every cipher there.
    if (( budget > 0 && SECONDS - started >= budget )); then
      echo "(stopping after ${budget}s — raise with GATHM_SITECIPHERS_BUDGET, 0 for no limit)"
      break
    fi
    local result=$(echo -n | run_bounded 2 openssl s_client -cipher "$cipher" -connect "$server" 2>&1)
    checked=$((checked + 1))
    
    if [[ "$result" == *"Cipher is $cipher"* ]] || [[ "$result" == *"Cipher    :"* ]]; then
        echo -e "${GREEN}[YES]${RESETBG} $cipher"
    elif [[ "$result" == *":error:"* ]]; then
        # Too much output if we show every NO, so maybe only show YES or summary
        # But for AI, we'll keep it simple
        : # echo "[NO]  $cipher"
    fi
    sleep $DELAY
  done
  print_divider
  echo "Checked $checked cipher(s)."
}

# --- Option Parsing ---
while getopts "d:vh" opt; do
  case "$opt" in
    d) DELAY=$OPTARG ;;
    v) echo "Version $currentVersion"; exit 0 ;;
    h) usage; exit 0 ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -eq 0 ]]; then
  usage
  exit 1
fi

checkInternet || { echo "Error: No internet connection"; exit 1; }
checkCiphers "$1"

exit 0
