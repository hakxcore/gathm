#!/usr/bin/env bash
# Fetch terminal GIF output using the shared client configuration.
source "$(dirname "$0")/../../lib/utils.bash"

usage() {
    cat <<'USAGE'
Gif (v3.0.0)
Usage: gif <keyword>  (use underscores between words)
  -h  Show help
  -v  Show version
USAGE
}
case "${1:-}" in
    -v) echo 'Version 3.0.0'; exit 0 ;;
    -h|help|'') usage; exit 0 ;;
    -u|update)
        echo 'Update Gathm through its installer; the legacy termux-snippets updater has been removed.' >&2
        exit 1 ;;
esac
if [[ $# -ne 1 || ! "$1" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    usage >&2
    exit 1
fi
check_dependencies curl || exit 1
curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
    --max-time 30 "https://e.xec.sh/$1"
