#!/usr/bin/env bash
# Author: Hakxcore https://github.com/hakxcore
# Description: Provides relevant information about a certain movie.

# Source the shared utility library
source "$(dirname "$0")/../../lib/utils.bash"

currentVersion="3.0.0"
detail=false

## This function grabs information about a movie and using python parses the
getMovieInfo()
{
  apiKey=946f500a
  movie=$(echo "$@" | tr " " + )
  export PYTHONIOENCODING=utf8
  movieInfo=$(httpGet "http://www.omdbapi.com/?t=$movie&apikey=$apiKey")
  
  checkResponse=$(echo "$movieInfo" | python3 -c "import sys, json; print(json.load(sys.stdin).get('Response', 'False'))" 2>/dev/null)
  
  if [[ $checkResponse == "False" ]]; then 
    echo "No movie found"
    return 1
  fi
  
  # Extract info using python
  python3 -c "import sys, json; 
data = json.load(sys.stdin)
detail = sys.argv[1] == 'true'
print('Title: ' + data.get('Title', 'N/A'))
print('Year: ' + data.get('Year', 'N/A'))
print('Runtime: ' + data.get('Runtime', 'N/A'))
print('Genre: ' + data.get('Genre', 'N/A'))
print('Director: ' + data.get('Director', 'N/A'))
print('Actors: ' + data.get('Actors', 'N/A'))
print('Plot: ' + data.get('Plot', 'N/A'))
if detail:
    print('Awards: ' + data.get('Awards', 'N/A'))
    print('Box Office: ' + data.get('BoxOffice', 'N/A'))
" "$detail" <<< "$movieInfo"
}

usage()
{
  cat <<EOF
Movies (v$currentVersion)

Description: Provides relevant information about a certain movie.

Usage: movies [flag] [movieName]
  -h  Show the help
  -v  Get the tool version
  -d  Show detailed information

Examples:
  movies Inception
  movies -d "The Dark Knight"
EOF
}

# --- Option Parsing ---
while getopts 'dhv' flag; do
  case "${flag}" in
    d) detail=true ;;
    h) usage; exit 0 ;;
    v) echo "Version $currentVersion"; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# == 0 ]]; then
  usage
  exit 1
fi

check_dependencies python3
getConfiguredClient || exit 1
checkInternet || { echo "Error: no active internet connection" >&2; exit 1; }

getMovieInfo "$@"
exit 0
