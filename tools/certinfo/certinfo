#!/usr/bin/env bash
# Author: Gathm maintainers
# Description: TLS certificate inspection for HTTPS endpoints.

source "$(dirname "$0")/../../lib/utils.bash"

currentVersion="3.0.0"

# Where fetch_peer_certificate leaves openssl's stderr for the caller to read.
CERTINFO_ERR_FILE="${TMPDIR:-/tmp}/gathm-certinfo-$$.err"
trap 'rm -f "$CERTINFO_ERR_FILE" 2>/dev/null || true' EXIT

usage() {
  cat <<EOF
CertInfo (v$currentVersion)
Description: Inspect TLS certificate details for a host.

Usage: certinfo [host[:port]]
  [host[:port]]  Domain name and optional port (default: 443)
  -h             Show the help
  -v             Get the tool version

Examples:
  certinfo github.com
  certinfo example.com:8443
EOF
}

normalize_target() {
  local value="$1"
  value="${value#http://}"
  value="${value#https://}"
  value="${value%%/*}"
  echo "$value"
}

fetch_peer_certificate() {
  local server="$1"
  local host="$2"
  local raw

  # run_bounded picks timeout/gtimeout/perl, so this is one path everywhere.
  # -showcerts because LibreSSL (which is what `openssl` is on macOS) does not
  # always emit the leaf certificate without it, and an empty PEM here was
  # reported as "could not retrieve certificate" from a server that answered.
  #
  # openssl's own complaint goes to a file, not a variable: this function runs
  # inside $( ), so anything it sets is lost and anything it echoes would be
  # captured as certificate data instead of shown to the user.
  local openssl_bin="${GATHM_OPENSSL:-openssl}"
  raw=$(echo | run_bounded 10 "$openssl_bin" s_client -showcerts -servername "$host" \
                    -connect "$server" 2>"$CERTINFO_ERR_FILE")

  local pem
  pem=$(echo "$raw" | awk '/-----BEGIN CERTIFICATE-----/{flag=1} flag{print} /-----END CERTIFICATE-----/{exit}')

  # Fall back to Python's TLS stack when openssl produced no certificate. On
  # macOS `openssl` is Apple's LibreSSL 2.8.3 — years old — and its s_client can
  # come back empty against a host that a modern client reaches without trouble.
  # python3 is already a declared dependency, uses the system trust store, and
  # only the handshake moves here: the PEM is still parsed by openssl below.
  if [[ -z "${pem// }" ]] && command -v python3 >/dev/null 2>&1; then
    pem=$(python3 - "$host" "${server##*:}" <<'PY' 2>>"$CERTINFO_ERR_FILE"
import socket, ssl, sys
host, port = sys.argv[1], int(sys.argv[2] or 443)
ctx = ssl.create_default_context()
# The point here is to see the certificate, not to vet it: an expired or
# self-signed certificate is exactly what someone runs certinfo to look at.
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
with socket.create_connection((host, port), timeout=10) as raw_sock:
    with ctx.wrap_socket(raw_sock, server_hostname=host) as tls:
        der = tls.getpeercert(binary_form=True)
print(ssl.DER_cert_to_PEM_cert(der), end="")
PY
    )
  fi

  printf '%s' "$pem"
}

inspect_certificate() {
  local input_target="$1"
  local normalized
  normalized=$(normalize_target "$input_target")

  if [[ -z "$normalized" ]]; then
    echo "Error: Empty target."
    return 1
  fi

  local server="$normalized"
  if [[ "$server" != *:* ]]; then
    server="${server}:443"
  fi
  local host="${server%%:*}"

  local cert_pem
  cert_pem=$(fetch_peer_certificate "$server" "$host")
  if [[ -z "$cert_pem" ]]; then
    echo "Error: Could not retrieve certificate from $server"
    local why=""
    [[ -s "$CERTINFO_ERR_FILE" ]] && why=$(grep -m1 -iE \
        "error|refused|timed out|unknown|unable|verify|no route|resolve" \
        "$CERTINFO_ERR_FILE" 2>/dev/null)
    [[ -n "$why" ]] && echo "       openssl said: ${why#*:}"
    echo "       Reproduce with: openssl s_client -servername $host -connect $server"
    return 1
  fi

  local cert_details
  cert_details=$(echo "$cert_pem" | openssl x509 -noout -subject -issuer -dates -serial -fingerprint -sha256 -ext subjectAltName 2>/dev/null)
  if [[ -z "$cert_details" ]]; then
    echo "Error: Unable to parse certificate data."
    return 1
  fi

  local not_after
  not_after=$(echo "$cert_details" | sed -n 's/^notAfter=//p')

  local validity
  validity=$(python3 - "$not_after" <<'PY'
from datetime import datetime, timezone
import sys

value = sys.argv[1].strip()
if not value:
    print("UNKNOWN|unknown")
    sys.exit(0)

parsed = None
for fmt in ("%b %d %H:%M:%S %Y %Z", "%b %d %H:%M:%S %Y GMT"):
    try:
        parsed = datetime.strptime(value, fmt).replace(tzinfo=timezone.utc)
        break
    except Exception:
        pass

if parsed is None:
    print("UNKNOWN|unknown")
    sys.exit(0)

days_left = (parsed - datetime.now(timezone.utc)).days
if days_left < 0:
    state = "EXPIRED"
elif days_left <= 30:
    state = "EXPIRING_SOON"
else:
    state = "VALID"
print(f"{state}|{days_left}")
PY
)

  local cert_state="${validity%%|*}"
  local days_left="${validity##*|}"

  echo "Server: $server"
  echo "Certificate Status: $cert_state"
  if [[ "$days_left" != "unknown" ]]; then
    echo "Days Until Expiry: $days_left"
  fi
  echo "$cert_details" | sed -n 's/^subject=/Subject: /p'
  echo "$cert_details" | sed -n 's/^issuer=/Issuer: /p'
  echo "$cert_details" | sed -n 's/^notBefore=/Valid From: /p'
  echo "$cert_details" | sed -n 's/^notAfter=/Valid Until: /p'
  echo "$cert_details" | sed -n 's/^serial=/Serial: /p'
  echo "$cert_details" | sed -n 's/^sha256 Fingerprint=/SHA256 Fingerprint: /p'

  local san_line
  san_line=$(echo "$cert_details" | awk '/X509v3 Subject Alternative Name/{getline; gsub(/^ +/, ""); print}')
  if [[ -n "$san_line" ]]; then
    echo "SAN: $san_line"
  fi
}

while getopts "vh" opt; do
  case "$opt" in
    v) echo "Version $currentVersion"; exit 0 ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -ne 1 ]]; then
  usage
  exit 1
fi

check_dependencies openssl python3
inspect_certificate "$1"
exit $?
