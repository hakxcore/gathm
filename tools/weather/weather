#!/usr/bin/env bash
# Author: Hakxcore & Alexander Epstein
# Description: Provides a 3-day forecast for your location or a specified location.

# Source the shared utility library
source "$(dirname "$0")/../../lib/utils.bash"

currentVersion="3.0.0"
LANG="${LANG:-en}"
locale=$(echo "$LANG" | cut -c1-2)
[[ $(echo "$locale" | grep -Eo "[a-z A-Z]*" | wc -c) != 3 ]] && locale="en"

getIPWeather()
{
  local params="$1"
  # Fetch country/city/loc using ipinfo.io via shared httpGet
  local country=$(httpGet ipinfo.io/country)
  if [[ "$country" == "US" ]]; then
    local city=$(httpGet ipinfo.io/city)
    local region=$(httpGet ipinfo.io/region)
    [[ $(echo "$region" | wc -w) -eq 2 ]] && region=$(echo "$region" | grep -Eo "[A-Z]*" | tr -d "[:space:]")
    httpGet "$locale.wttr.in/${city},${region}${params}"
  else
    local location=$(httpGet ipinfo.io/loc)
    httpGet "$locale.wttr.in/${location}${params}"
  fi
}

getLocationWeather()
{
  local args=$(echo "$@" | tr " " +)
  httpGet "$locale.wttr.in/${args}"
}

usage()
{
  cat <<EOF
Weather (v$currentVersion)
Description: Provides a 3-day forecast on your current location or a specified location.

Usage: weather [location] [units/flags]
  [location]     City, country, or IP address. Defaults to current IP.
  [units/flags]  
                 m   - Metric units
                 i   - Imperial units
                 M   - Wind speed in m/s
                 Moon - Phase of the moon

Examples:
  weather
  weather London m
  weather Tokyo iM
  weather Moon
EOF
}

# --- Option Parsing ---
while getopts "uvh" opt; do
  case "$opt" in
    v) echo "Version $currentVersion"; exit 0 ;;
    h) usage; exit 0 ;;
    u) # Legacy update flag, ignored in Gathm
       exit 0 ;;
  esac
done

getConfiguredClient || exit 1
checkInternet || { echo "Error: No internet connection"; exit 1; }

if [[ $# -eq 0 ]]; then
  getIPWeather ""
elif [[ "$1" == "Moon" || "$1" == "moon" ]]; then
  getLocationWeather "Moon"
else
  # Check if last arg is a unit flag
  last_arg="${@: -1}"
  if [[ "$last_arg" =~ ^[miM]+$ ]]; then
    # Construct wttr.in query params
    params="?"
    [[ "$last_arg" == *"m"* ]] && params="${params}m"
    [[ "$last_arg" == *"i"* ]] && params="${params}u"
    [[ "$last_arg" == *"M"* ]] && params="${params}M"
    
    if [[ $# -eq 1 ]]; then
      getIPWeather "$params"
    else
      args_without_last="${@:1:(($# - 1))}"
      getLocationWeather "${args_without_last}${params}"
    fi
  else
    getLocationWeather "$@"
  fi
fi

exit 0
