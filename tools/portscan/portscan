#!/usr/bin/env bash
# Author: Gathm maintainers
# Description: Flexible TCP/UDP port scanner with nmap or Python engine.

source "$(dirname "$0")/../../lib/utils.bash"

currentVersion="3.1.0"
scan_mode="tcp"
ports="21,22,25,53,80,110,143,443,445,3389,8080"
timeout_seconds=1
engine="auto"

usage() {
  cat <<USAGE
Portscan (v$currentVersion)
Description: Scan TCP/UDP ports using nmap (if available) or a built-in Python scanner.

Usage: portscan [flags] [target]
  [target]      Hostname, IP address, or CIDR range (e.g. 192.168.1.0/24)
  -t MODE       Scan mode: tcp | udp | both (default: $scan_mode)
  -p PORTS      Port list/range (default: $ports)
  -w SECONDS    Per-port timeout in seconds (default: $timeout_seconds)
  -e ENGINE     Engine: auto | nmap | python (default: $engine)
  -h            Show this help
  -v            Show tool version

Examples:
  portscan scanme.nmap.org
  portscan -t both -p 1-1024 scanme.nmap.org
  portscan -t udp -p 53,67,68 -e python 8.8.8.8
  portscan 192.168.1.0/24
  portscan -p 22,80,443 10.0.0.0/24
USAGE
}

run_nmap_scan() {
  local target="$1"
  local args=(-Pn -p "$ports" --host-timeout "${timeout_seconds}s")

  case "$scan_mode" in
    tcp)  args=(-sT "${args[@]}") ;;
    udp)  args=(-sU "${args[@]}") ;;
    both) args=(-sT -sU "${args[@]}") ;;
    *) echo "Error: Invalid mode '$scan_mode'." >&2; return 1 ;;
  esac

  echo "Engine: nmap"
  exec nmap "${args[@]}" "$target"
}

run_python_scan() {
  local target="$1"
  python3 - "$target" "$scan_mode" "$ports" "$timeout_seconds" <<'PY'
import ipaddress
import socket
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import Dict, List, Set, Tuple

target = sys.argv[1].strip()
mode = sys.argv[2].strip().lower()
port_spec = sys.argv[3].strip()
timeout = float(sys.argv[4])

if mode not in {"tcp", "udp", "both"}:
    print(f"Error: Unsupported mode '{mode}'.")
    sys.exit(1)

def parse_ports(spec: str) -> List[int]:
    out: Set[int] = set()
    for token in spec.split(","):
        token = token.strip()
        if not token:
            continue
        if "-" in token:
            parts = token.split("-", 1)
            if len(parts) != 2:
                continue
            try:
                start = int(parts[0])
                end = int(parts[1])
            except ValueError:
                continue
            if start > end:
                start, end = end, start
            for p in range(start, end + 1):
                if 1 <= p <= 65535:
                    out.add(p)
        else:
            try:
                p = int(token)
            except ValueError:
                continue
            if 1 <= p <= 65535:
                out.add(p)
    return sorted(out)

def expand_targets(target: str) -> List[str]:
    """Expand CIDR notation or range into individual IPs. Single hosts pass through."""
    if "/" in target:
        try:
            network = ipaddress.ip_network(target, strict=False)
            if network.num_addresses > 65536:
                print(f"Error: Subnet {target} too large ({network.num_addresses} hosts, limit: 65536).")
                sys.exit(1)
            return [str(ip) for ip in network.hosts()]
        except ValueError as exc:
            print(f"Error: Invalid CIDR notation '{target}' ({exc}).")
            sys.exit(1)
    return [target]

ports = parse_ports(port_spec)
if not ports:
    print("Error: No valid ports to scan.")
    sys.exit(1)

if len(ports) > 4096:
    print(f"Error: Refusing to scan {len(ports)} ports in one run (limit: 4096).")
    sys.exit(1)

targets = expand_targets(target)
is_subnet = len(targets) > 1

def resolve_host(host: str):
    try:
        info = socket.getaddrinfo(host, None, 0, socket.SOCK_STREAM)
        return info[0][0], info[0][4][0]
    except socket.gaierror:
        return None, None

def scan_tcp_port(family, ip, port: int) -> bool:
    sock = socket.socket(family, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        addr = (ip, port, 0, 0) if family == socket.AF_INET6 else (ip, port)
        return sock.connect_ex(addr) == 0
    except (OSError, socket.error):
        return False
    finally:
        sock.close()

def scan_udp_port(family, ip, port: int) -> str:
    sock = socket.socket(family, socket.SOCK_DGRAM)
    sock.settimeout(timeout)
    try:
        addr = (ip, port, 0, 0) if family == socket.AF_INET6 else (ip, port)
        sock.sendto(b"\x00", addr)
        try:
            sock.recvfrom(1024)
            return "open"
        except socket.timeout:
            return "open|filtered"
        except ConnectionRefusedError:
            return "closed"
        except OSError as exc:
            if getattr(exc, "errno", None) in {61, 111, 10061}:
                return "closed"
            return "open|filtered"
    finally:
        sock.close()

def scan_single_host(host: str) -> Dict:
    """Scan a single host and return results dict."""
    family, ip = resolve_host(host)
    if ip is None:
        return {"host": host, "ip": None, "error": f"Failed to resolve '{host}'"}

    tcp_open = []
    udp_open = []
    udp_open_filtered = []

    for port in ports:
        if mode in {"tcp", "both"} and scan_tcp_port(family, ip, port):
            tcp_open.append(port)
        if mode in {"udp", "both"}:
            state = scan_udp_port(family, ip, port)
            if state == "open":
                udp_open.append(port)
            elif state == "open|filtered":
                udp_open_filtered.append(port)

    return {
        "host": host, "ip": ip,
        "tcp_open": tcp_open, "udp_open": udp_open,
        "udp_open_filtered": udp_open_filtered,
    }

print("Engine: python")
print(f"Target: {target}")
print(f"Mode: {mode}")
print(f"Ports per host: {len(ports)}")

if is_subnet:
    print(f"Hosts to scan: {len(targets)}")
    # Use threading for parallel host scanning (cap at 50 threads)
    max_workers = min(50, len(targets))
    results: List[Dict] = []
    hosts_with_open_ports = 0

    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        futures = {executor.submit(scan_single_host, h): h for h in targets}
        for future in as_completed(futures):
            result = future.result()
            if result.get("error"):
                continue
            has_open = (result.get("tcp_open") or result.get("udp_open")
                        or result.get("udp_open_filtered"))
            if has_open:
                results.append(result)
                hosts_with_open_ports += 1

    print(f"\nHosts with open ports: {hosts_with_open_ports}/{len(targets)}")
    # Sort results by IP for consistent output
    results.sort(key=lambda r: ipaddress.ip_address(r["ip"]))
    for r in results:
        print(f"\n  Host: {r['ip']}")
        if mode in {"tcp", "both"} and r.get("tcp_open"):
            print(f"    Open TCP: {', '.join(str(p) for p in r['tcp_open'])}")
        if mode in {"udp", "both"} and r.get("udp_open"):
            print(f"    Open UDP: {', '.join(str(p) for p in r['udp_open'])}")
        if mode in {"udp", "both"} and r.get("udp_open_filtered"):
            print(f"    Open|Filtered UDP: {', '.join(str(p) for p in r['udp_open_filtered'])}")

    if not results:
        print("No hosts with open ports found.")
else:
    # Single host scan (original behavior)
    family, ip = resolve_host(targets[0])
    if ip is None:
        print(f"Error: Failed to resolve target '{targets[0]}'.")
        sys.exit(1)

    print(f"Resolved IP: {ip}")
    result = scan_single_host(targets[0])

    if mode in {"tcp", "both"}:
        if result.get("tcp_open"):
            print("Open TCP Ports: " + ", ".join(str(p) for p in result["tcp_open"]))
        else:
            print("Open TCP Ports: none")

    if mode in {"udp", "both"}:
        if result.get("udp_open"):
            print("Open UDP Ports: " + ", ".join(str(p) for p in result["udp_open"]))
        else:
            print("Open UDP Ports: none detected")

        if result.get("udp_open_filtered"):
            print("Open|Filtered UDP Ports: " + ", ".join(str(p) for p in result["udp_open_filtered"]))
PY
}

while getopts "t:p:w:e:vh" opt; do
  case "$opt" in
    t) scan_mode="$(echo "$OPTARG" | tr '[:upper:]' '[:lower:]')" ;;
    p) ports="$OPTARG" ;;
    w) timeout_seconds="$OPTARG" ;;
    e) engine="$(echo "$OPTARG" | tr '[:upper:]' '[:lower:]')" ;;
    v) echo "Version $currentVersion"; exit 0 ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -ne 1 ]]; then
  usage
  exit 1
fi

if [[ ! "$timeout_seconds" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "Error: -w expects a positive number." >&2
  exit 1
fi

case "$scan_mode" in
  tcp|udp|both) ;;
  *)
    echo "Error: -t must be one of tcp, udp, both." >&2
    exit 1
    ;;
esac

case "$engine" in
  auto|nmap|python) ;;
  *)
    echo "Error: -e must be one of auto, nmap, python." >&2
    exit 1
    ;;
esac

if [[ "$engine" == "nmap" ]]; then
  if ! command -v nmap >/dev/null 2>&1; then
    echo "Error: nmap engine requested but nmap is not installed." >&2
    exit 1
  fi
  run_nmap_scan "$1"
elif [[ "$engine" == "auto" && $(command -v nmap >/dev/null 2>&1; echo $?) -eq 0 ]]; then
  run_nmap_scan "$1"
else
  check_dependencies python3
  run_python_scan "$1"
fi

exit $?
