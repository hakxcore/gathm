#!/usr/bin/env bash
# Author: hakxcore
# Gathm - A modular tool framework
#
# One command starts everything: `gathm` brings up the web GUI in your browser
# and drops you into the Pilot TUI in this terminal. The old dialog-driven tool
# menu is gone — Pilot (and `gathm run <tool>`) covers everything it did, and it
# no longer forces `dialog`/`pv` to be installed just to launch.

currentVersion="3.0.0"
# Resolve this script through any symlinks before deriving the install dir.
# ~/.local/bin/gathm is a symlink to the checkout, and BASH_SOURCE[0] is the
# *link* path — so a plain dirname pointed INSTALL_DIR at ~/.local/bin and every
# subcommand died on a missing lib/utils.bash. Hand-rolled rather than
# `readlink -f`, which is not portable to macOS's BSD readlink.
_gathm_self="${BASH_SOURCE[0]}"
_gathm_hops=0
while [[ -L "$_gathm_self" && $_gathm_hops -lt 20 ]]; do
    _gathm_link="$(readlink "$_gathm_self")"
    if [[ "$_gathm_link" == /* ]]; then
        _gathm_self="$_gathm_link"
    else
        _gathm_self="$(cd "$(dirname "$_gathm_self")" &>/dev/null && pwd)/$_gathm_link"
    fi
    _gathm_hops=$((_gathm_hops + 1))
done
INSTALL_DIR="$(cd "$(dirname "$_gathm_self")" &>/dev/null && pwd)"
AGENT_SCRIPT="$INSTALL_DIR/agent/orchestrator.sh"
source "$INSTALL_DIR/lib/utils.bash"

# --- Where the GUI lives ---
GUI_HOST="${GATHM_GUI_HOST:-${GATHM_HOST:-127.0.0.1}}"
GUI_PORT="${GATHM_GUI_PORT:-${GATHM_PORT:-8080}}"
# 0.0.0.0 is a bind address, not somewhere a browser can go — advertise
# loopback instead so the URL we print and open is always reachable.
_gui_display_host="$GUI_HOST"
[[ "$_gui_display_host" == "0.0.0.0" || "$_gui_display_host" == "::" ]] && _gui_display_host="127.0.0.1"
GUI_URL="http://${_gui_display_host}:${GUI_PORT}"

GATHM_STATE_DIR="${GATHM_CONFIG_DIR:-$HOME/.gathm}"
GUI_PID_FILE="$GATHM_STATE_DIR/gui.pid"
GUI_LOG="$GATHM_STATE_DIR/gui.log"

OPEN_BROWSER=1
START_GUI=1

# --- Graceful shutdown ---
_gathm_cleanup() {
    clear 2>/dev/null || true
    echo ""
    echo -e "${INDIAN_GREEN}Jai Hind! Gathm signing off.${RESETBG}"
    exit 0
}
trap _gathm_cleanup INT TERM

# --- Python selection -------------------------------------------------------
# The installer builds a venv at pilot/venv and puts FastAPI/uvicorn in it, so
# prefer that over whatever python3 happens to be on PATH.
pick_python() {
    local candidate
    # GATHM_PYTHON wins. A pipx install has no pilot/venv — the dependencies
    # live in pipx's own venv, and its interpreter is the only one that can see
    # langchain and rich. The console script sets this; without it the search
    # below would fall through to a bare `python3` that has none of them.
    if [[ -n "${GATHM_PYTHON:-}" && -x "${GATHM_PYTHON}" ]]; then
        echo "$GATHM_PYTHON"
        return 0
    fi
    for candidate in \
        "$INSTALL_DIR/pilot/venv/bin/python3" \
        "$INSTALL_DIR/pilot/venv/bin/python"; do
        [[ -x "$candidate" ]] && { echo "$candidate"; return 0; }
    done
    for candidate in python3 python; do
        command -v "$candidate" &>/dev/null && { command -v "$candidate"; return 0; }
    done
    return 1
}

# --- GUI server -------------------------------------------------------------
# Is anything answering on the GUI port? curl first, then wget, then Python —
# a Termux install that skipped curl should still get a working launcher.
gui_responding() {
    local timeout="${1:-2}" py
    if command -v curl &>/dev/null; then
        curl -fsS --max-time "$timeout" -o /dev/null "$GUI_URL/" 2>/dev/null && return 0
        return 1
    fi
    if command -v wget &>/dev/null; then
        wget -q -T "$timeout" -O /dev/null "$GUI_URL/" 2>/dev/null && return 0
        return 1
    fi
    py="$(pick_python)" || return 1
    "$py" -c 'import sys,urllib.request; urllib.request.urlopen(sys.argv[1], timeout=float(sys.argv[2]))' \
        "$GUI_URL/" "$timeout" &>/dev/null
}

open_url() {
    local url="$1" platform
    platform="$(detect_platform)"
    case "$platform" in
        darwin)  open "$url" &>/dev/null || true ;;
        termux)  termux-open-url "$url" &>/dev/null || true ;;
        windows) cmd.exe /c start "" "$url" &>/dev/null || true ;;
        wsl)     cmd.exe /c start "" "$url" &>/dev/null || xdg-open "$url" &>/dev/null || true ;;
        *)       xdg-open "$url" &>/dev/null \
                     || sensible-browser "$url" &>/dev/null \
                     || x-www-browser "$url" &>/dev/null || true ;;
    esac
}

# --- Preflight --------------------------------------------------------------
# Everything below runs before the GUI or Pilot is started, because the
# alternative is what used to happen: the launcher brings both up, the browser
# opens on a working page, and then the first thing you type into Pilot comes
# back "[Errno 111] Connection refused" because Ollama was never running.
#
# The rule for each check is whether Gathm can start at all without it:
#
#   fatal    no Python, no Pilot, no Pilot dependencies. Nothing to start.
#   warn     GUI dependencies, jq, the LLM. Pilot still opens and can still
#            tell you things; you are told what will not work and why.
#
# Every network probe is bounded, since a preflight that hangs is worse than
# the failure it was added to catch.

PREFLIGHT_FAIL=0
PREFLIGHT_WARN=0
PREFLIGHT_PY=""
OLLAMA_AUTOSTART=1
OLLAMA_PID_FILE="$GATHM_STATE_DIR/ollama.pid"
OLLAMA_LOG="$GATHM_STATE_DIR/ollama.log"

# Advice has to match how Gathm got here. Telling a pipx user to run
# `pip install -r pilot/requirements.txt` points them at a requirements file
# inside site-packages and a venv they do not manage.
deps_advice() {
    if [[ "${GATHM_INSTALL_KIND:-}" == "pipx" ]]; then
        echo "pipx install --force 'gathm[all]'   (or: pipx reinstall gathm)"
    else
        echo "pip install -r pilot/requirements.txt   (or ./install)"
    fi
}

setup_advice() {
    if [[ "${GATHM_INSTALL_KIND:-}" == "pipx" ]]; then
        echo "gathm setup"
    else
        echo "./install"
    fi
}

pf_ok()   { echo -e "  ${GREEN}✓${RESETBG} $1"; }
pf_warn() {
    echo -e "  ${ORANGE}!${RESETBG} $1"
    [[ -n "${2:-}" ]] && echo "      $2"
    PREFLIGHT_WARN=$((PREFLIGHT_WARN + 1))
    return 0
}
pf_fail() {
    echo -e "  ${RED}✗${RESETBG} $1"
    [[ -n "${2:-}" ]] && echo "      $2"
    PREFLIGHT_FAIL=$((PREFLIGHT_FAIL + 1))
    return 0
}

# The LLM endpoint, from the same environment lib/llm.py reads, so the
# launcher and Pilot can never disagree about where the model is.
ollama_root() {
    local base="${OLLAMA_BASE_URL:-http://localhost:11434/v1}"
    base="${base%/}"
    base="${base%/v1}"
    echo "$base"
}

llm_backend() { echo "${GATHM_LLM_BACKEND:-ollama}"; }

llm_model() {
    echo "${GATHM_OLLAMA_MODEL:-${OLLAMA_MODEL:-gemma3:12b}}"
}

ollama_responding() {
    local seconds="${1:-2}"
    command -v curl >/dev/null 2>&1 || return 0   # cannot probe; do not cry wolf
    run_bounded "$seconds" curl -fsS "$(ollama_root)/api/tags" >/dev/null 2>&1
}

# Start the server ourselves rather than telling the user to open another
# terminal. Same process-group treatment as the GUI: `set -m` makes it a group
# leader so Ctrl+C in Pilot cannot reach it.
start_ollama() {
    command -v ollama >/dev/null 2>&1 || return 1
    mkdir -p "$GATHM_STATE_DIR" 2>/dev/null || true
    (
        set -m
        nohup ollama serve </dev/null >>"$OLLAMA_LOG" 2>&1 &
        echo $! >"$OLLAMA_PID_FILE" 2>/dev/null || true
    )
    local waited=0
    while (( waited < 10 )); do
        sleep 1
        waited=$((waited + 1))
        ollama_responding 2 && return 0
    done
    return 1
}

check_python() {
    if PREFLIGHT_PY="$(pick_python)"; then
        pf_ok "Python  $("$PREFLIGHT_PY" -V 2>&1 | tail -1)"
        return 0
    fi
    pf_fail "Python 3 not found" "Install Python 3, then run: $(setup_advice)"
    return 1
}

check_pilot() {
    [[ -n "$PREFLIGHT_PY" ]] || return 1
    # Mirror launch_pilot: it takes run.sh if there is one, main.py otherwise.
    # Checking only for main.py would refuse to start an install that launches
    # perfectly well through run.sh.
    if [[ ! -f "$INSTALL_DIR/pilot/run.sh" && ! -f "$INSTALL_DIR/pilot/main.py" ]]; then
        pf_fail "Pilot is missing from $INSTALL_DIR/pilot" "Re-run the installer: $(setup_advice)"
        return 1
    fi
    # run.sh brings its own environment (the installer's venv), so the module
    # checks below only speak for a direct main.py launch.
    if [[ ! -f "$INSTALL_DIR/pilot/main.py" ]]; then
        pf_ok "Pilot"
        return 0
    fi
    # Two tiers, because they fail differently. Without `rich`, pilot/main.py
    # raises SystemExit at import and there is nothing to start. Without
    # langchain/langgraph it starts fine in its degraded mode — the TUI opens,
    # the tools run, and only the AI answers are unavailable. Calling that
    # fatal would refuse to launch something that works.
    local hard soft
    hard="$("$PREFLIGHT_PY" - <<'PY' 2>/dev/null
import importlib.util
missing = []
for name in ("rich",):
    try:
        if importlib.util.find_spec(name) is None:
            missing.append(name)
    except Exception:
        missing.append(name)
print(" ".join(missing))
PY
)"
    if [[ -n "${hard// }" ]]; then
        pf_fail "Pilot cannot start — missing: ${hard}" \
                "Install it with: $(deps_advice)"
        return 1
    fi

    soft="$("$PREFLIGHT_PY" - <<'PY' 2>/dev/null
import importlib.util
missing = []
for name in ("langchain_core", "langgraph"):
    try:
        if importlib.util.find_spec(name) is None:
            missing.append(name)
    except Exception:
        missing.append(name)
print(" ".join(missing))
PY
)"
    if [[ -n "${soft// }" ]]; then
        pf_warn "AI runtime missing: ${soft} — Pilot will open but cannot answer" \
                "Install it with: $(deps_advice)"
        return 0
    fi
    pf_ok "Pilot dependencies"
    return 0
}

check_gui_deps() {
    (( START_GUI )) || return 0
    [[ -n "$PREFLIGHT_PY" ]] || return 0
    local missing
    missing="$("$PREFLIGHT_PY" - <<'PY' 2>/dev/null
import importlib.util
missing = []
for name in ("fastapi", "uvicorn"):
    try:
        if importlib.util.find_spec(name) is None:
            missing.append(name)
    except Exception:
        missing.append(name)
print(" ".join(missing))
PY
)"
    if [[ -n "${missing// }" ]]; then
        pf_warn "GUI dependencies missing: ${missing} — starting Pilot only" \
                "Install them with: $(if [[ "${GATHM_INSTALL_KIND:-}" == "pipx" ]]; then echo "pipx install --force 'gathm[gui]'"; else echo "./install"; fi)"
        START_GUI=0
        return 1
    fi
    pf_ok "GUI dependencies"
    return 0
}

check_llm() {
    local backend model
    backend="$(llm_backend)"
    model="$(llm_model)"

    if [[ "$backend" != "ollama" ]]; then
        # A hosted backend needs a key, not a server. Check the key exists;
        # whether it is valid is not something to spend startup time on.
        local key="${GATHM_LLM_API_KEY:-${OPENAI_API_KEY:-${GEMINI_API_KEY:-}}}"
        if [[ -z "$key" ]]; then
            pf_warn "LLM backend '$backend' has no API key set" \
                    "Pilot will not be able to answer. Set the key for $backend."
            return 1
        fi
        pf_ok "LLM  $backend ($model)"
        return 0
    fi

    if ollama_responding 2; then
        pf_ok "Ollama  running at $(ollama_root)"
    elif ! command -v ollama >/dev/null 2>&1; then
        pf_warn "Ollama is not installed — Pilot cannot answer questions" \
                "Install it from https://ollama.com, then: ollama pull $model"
        return 1
    elif (( OLLAMA_AUTOSTART )); then
        echo -e "  ${ORANGE}·${RESETBG} Ollama is not running — starting it..."
        if start_ollama; then
            pf_ok "Ollama  started at $(ollama_root)"
        else
            pf_warn "Ollama would not start — Pilot cannot answer questions" \
                    "Start it yourself with: ollama serve   (log: $OLLAMA_LOG)"
            return 1
        fi
    else
        pf_warn "Ollama is not running at $(ollama_root)" \
                "Start it with: ollama serve"
        return 1
    fi

    # The server can be up with the configured model never pulled, which fails
    # later as a 404 from deep inside LangChain rather than as "pull the model".
    local tags
    tags="$(run_bounded 3 curl -fsS "$(ollama_root)/api/tags" 2>/dev/null)" || tags=""
    if [[ -n "$tags" && -n "$PREFLIGHT_PY" ]]; then
        local have
        have="$(GATHM_WANT_MODEL="$model" GATHM_TAGS="$tags" "$PREFLIGHT_PY" - <<'PY' 2>/dev/null
import json, os
want = os.environ.get("GATHM_WANT_MODEL", "")
try:
    payload = json.loads(os.environ.get("GATHM_TAGS") or "{}")
    names = [m.get("name", "") for m in payload.get("models", [])]
except Exception:
    print("unknown")
    raise SystemExit
# `llama3.2:3b` should satisfy a request for `llama3.2`, and vice versa.
stems = [n.split(":")[0] for n in names]
if want in names or want.split(":")[0] in stems:
    print("yes")
else:
    print("no " + ", ".join(names[:6]))
PY
)"
        case "$have" in
            yes)     pf_ok "Model   $model" ;;
            "no "*)  pf_warn "Model '$model' is not pulled" \
                             "Pull it with: ollama pull $model   (installed: ${have#no })" ;;
            *)       : ;;   # could not read the list; not worth a warning
        esac
    fi
    return 0
}

check_tooling() {
    command -v jq >/dev/null 2>&1 \
        || pf_warn "jq is not installed — several tools need it" \
                   "Install it with your package manager, or run: $(setup_advice)"
    return 0
}

# Runs every check. Returns non-zero only when Gathm cannot start at all.
preflight() {
    echo -e "${BOLD}Checking your setup...${RESETBG}"
    check_python
    check_pilot
    check_gui_deps
    check_llm
    check_tooling
    echo ""
    if (( PREFLIGHT_FAIL )); then
        echo -e "${RED}Gathm cannot start: ${PREFLIGHT_FAIL} problem(s) above.${RESETBG}" >&2
        return 1
    fi
    return 0
}

# Start api/server.py in the background. Returns 0 when the GUI is serving.
start_gui() {
    if gui_responding 2; then
        echo -e "${GREEN}[+]${RESETBG} GUI already running at ${CYAN}${GUI_URL}${RESETBG}"
        return 0
    fi

    local server_script="$INSTALL_DIR/api/server.py"
    if [[ ! -f "$server_script" ]]; then
        echo -e "${ORANGE}[!]${RESETBG} API server not found at $server_script — starting Pilot only." >&2
        return 1
    fi

    local py
    if ! py="$(pick_python)"; then
        echo -e "${ORANGE}[!]${RESETBG} Python 3 not found — cannot start the GUI." >&2
        return 1
    fi

    mkdir -p "$GATHM_STATE_DIR" 2>/dev/null || true
    echo -e "${GREEN}[*]${RESETBG} Starting GUI server on port ${GUI_PORT}..."
    rm -f "$GUI_PID_FILE" 2>/dev/null || true

    # The server has to end up in its OWN process group, not ours.
    #
    # A background job in a non-interactive script inherits the script's
    # process group, and because launch_pilot `exec`s, Pilot becomes the leader
    # of that same group — the terminal's foreground group. So Ctrl+C at the
    # Pilot prompt was delivered to the GUI server too and took it down with
    # Pilot (uvicorn logging "Shutting down"). `nohup` does not help: it blocks
    # SIGHUP, not SIGINT.
    #
    # `set -m` in a subshell turns on job control there, which makes the
    # background job a process-group leader. That is enough — terminal signals
    # only reach the foreground group — and unlike `setsid` it exists
    # everywhere bash does, including macOS. stdin comes from /dev/null so a
    # background read can never raise SIGTTIN.
    (
        set -m
        nohup "$py" "$server_script" --host "$GUI_HOST" --port "$GUI_PORT" \
            </dev/null >>"$GUI_LOG" 2>&1 &
        echo $! >"$GUI_PID_FILE" 2>/dev/null || true
    )
    local gui_pid; gui_pid="$(cat "$GUI_PID_FILE" 2>/dev/null || true)"
    if [[ -z "$gui_pid" ]]; then
        echo -e "${ORANGE}[!]${RESETBG} Could not start the GUI server." >&2
        return 1
    fi

    # Termux phones are slow to import FastAPI; give them longer.
    local max_wait=8
    [[ "$(detect_platform)" == "termux" ]] && max_wait=20
    local waited=0
    while (( waited < max_wait )); do
        sleep 1
        waited=$((waited + 1))
        if gui_responding 2; then
            echo -e "${GREEN}[+]${RESETBG} GUI ready at ${CYAN}${GUI_URL}${RESETBG}"
            return 0
        fi
        # Died on startup (port in use, missing FastAPI) — stop waiting and say why.
        if ! kill -0 "$gui_pid" 2>/dev/null; then
            break
        fi
    done

    echo -e "${ORANGE}[!]${RESETBG} GUI server did not come up — see $GUI_LOG" >&2
    if [[ -s "$GUI_LOG" ]]; then
        tail -n 12 "$GUI_LOG" 2>/dev/null | sed 's/^/      /' >&2
    fi
    rm -f "$GUI_PID_FILE" 2>/dev/null || true
    return 1
}

# Stop the Ollama server, but only if this launcher was the one that started
# it. A server the user runs themselves in another terminal is not ours to
# take down because they quit Gathm.
stop_ollama() {
    local pid=""
    [[ -f "$OLLAMA_PID_FILE" ]] || return 0
    pid="$(cat "$OLLAMA_PID_FILE" 2>/dev/null)"
    rm -f "$OLLAMA_PID_FILE" 2>/dev/null || true
    [[ -n "$pid" ]] || return 0
    kill -0 "$pid" 2>/dev/null || return 0
    kill "$pid" 2>/dev/null || true
    echo -e "${GREEN}[+]${RESETBG} Ollama stopped (pid $pid) — Gathm had started it."
    return 0
}

stop_gui() {
    local pid="" stopped=0
    [[ -f "$GUI_PID_FILE" ]] && pid="$(cat "$GUI_PID_FILE" 2>/dev/null)"

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        local waited=0
        while (( waited < 5 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            waited=$((waited + 1))
        done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
        stopped=1
    fi
    rm -f "$GUI_PID_FILE" 2>/dev/null || true

    if (( stopped )); then
        echo -e "${GREEN}[+]${RESETBG} GUI server stopped (pid $pid)."
        return 0
    fi
    if gui_responding 2; then
        # Someone else's server, or one started before this pid file existed.
        echo -e "${ORANGE}[!]${RESETBG} Something is still serving ${GUI_URL} but Gathm did not start it."
        echo "    Stop it with: pkill -f api/server.py"
        return 1
    fi
    echo "No GUI server is running."
    return 0
}

launch_pilot() {
    local pilot_run="$INSTALL_DIR/pilot/run.sh"
    local pilot_main="$INSTALL_DIR/pilot/main.py"

    if [[ -f "$pilot_run" ]]; then
        exec bash "$pilot_run" "$@"
    fi
    if [[ -f "$pilot_main" ]]; then
        local py
        py="$(pick_python)" || {
            echo -e "${RED}Error: Python 3 not found — cannot start Pilot.${RESETBG}" >&2
            exit 1
        }
        exec "$py" "$pilot_main" "$@"
    fi
    echo -e "${RED}Error: Pilot not found at $pilot_main${RESETBG}" >&2
    echo "Re-run the installer: ./install" >&2
    exit 1
}

# Shared flag parsing for `gathm` and `gathm gui`.
parse_launch_flags() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-gui|--tui-only) START_GUI=0; shift ;;
            --no-browser)        OPEN_BROWSER=0; shift ;;
            --port)              GUI_PORT="${2:-$GUI_PORT}"; shift 2 ;;
            --port=*)            GUI_PORT="${1#*=}"; shift ;;
            --host)              GUI_HOST="${2:-$GUI_HOST}"; shift 2 ;;
            --host=*)            GUI_HOST="${1#*=}"; shift ;;
            *)                   shift ;;
        esac
    done
    _gui_display_host="$GUI_HOST"
    [[ "$_gui_display_host" == "0.0.0.0" || "$_gui_display_host" == "::" ]] && _gui_display_host="127.0.0.1"
    GUI_URL="http://${_gui_display_host}:${GUI_PORT}"
}

# `gathm` with no arguments: GUI in the browser, Pilot in this terminal.
cmd_start() {
    parse_launch_flags "$@"

    echo ""
    echo -e "${BOLD}${GREEN}Gathm v$currentVersion${RESETBG}"
    echo ""

    # Before the browser opens on a page that cannot answer anything.
    preflight || exit 1

    if (( START_GUI )); then
        if start_gui; then
            if (( OPEN_BROWSER )); then
                echo -e "${GREEN}[*]${RESETBG} Opening ${CYAN}${GUI_URL}${RESETBG} in your browser..."
                open_url "$GUI_URL"
            fi
            echo "    The GUI keeps running after you leave Pilot. Stop it with: gathm stop"
        fi
    fi

    echo ""
    echo -e "${BOLD}Starting Pilot...${RESETBG}  ${ORANGE}(/exit or Ctrl+C to quit)${RESETBG}"
    echo ""
    launch_pilot
}

# `gathm gui`: server + browser, no TUI.
cmd_gui() {
    parse_launch_flags "$@"
    preflight || exit 1
    start_gui || exit 1
    if (( OPEN_BROWSER )); then
        open_url "$GUI_URL"
    fi
    echo "    Stop it with: gathm stop"
}

# `gathm doctor`: the same checks, on their own, starting nothing. Useful when
# something is broken and you do not want a browser window as well.
cmd_doctor() {
    parse_launch_flags "$@"
    OLLAMA_AUTOSTART=0          # reporting is the job here, not fixing
    echo ""
    echo -e "${BOLD}${GREEN}Gathm v$currentVersion${RESETBG}"
    echo ""
    preflight
    local status=$?
    if (( status == 0 && PREFLIGHT_WARN == 0 )); then
        echo -e "${GREEN}Everything checks out.${RESETBG}"
    elif (( status == 0 )); then
        echo -e "${ORANGE}Gathm will start, with ${PREFLIGHT_WARN} thing(s) not working.${RESETBG}"
    fi
    return $status
}

# Unified command help
show_help() {
    cat <<EOF
Gathm v$currentVersion

Usage:
  gathm                          Start the web GUI in your browser and Pilot here
  gathm tui                      Pilot only (no GUI server, no browser)
  gathm gui                      GUI server + browser only (no Pilot)
  gathm doctor                   Check your setup: Python, deps, Ollama, model
  gathm stop                     Stop the GUI server Gathm started
  gathm <agent-command> [...]    Run orchestrator command (run/ask/plan/...)
  gathm <tool> [args...]         Shortcut for: gathm run <tool> [args...]

Launch options (for 'gathm' and 'gathm gui'):
  --no-gui, --tui-only           Skip the GUI server and the browser
  --no-browser                   Start the GUI server but do not open a browser
  --port <n>                     GUI port (default $GUI_PORT, env GATHM_GUI_PORT)
  --host <addr>                  GUI bind address (default $GUI_HOST, env GATHM_GUI_HOST)

Examples:
  gathm
  gathm --no-browser
  gathm tui
  gathm gui --port 9090
  gathm ask "weather in Tokyo"
  gathm run dns -t MX gmail.com
  gathm weather "Paris"
  gathm status

Notes:
  - 'gathm-agent' remains available as a compatibility alias.
  - Run 'gathm help-agent' to display full orchestrator help.
EOF
}

is_agent_subcommand() {
    case "${1:-}" in
        run|ask|plan|engineer|chain|parallel|new-tool|list|health|heal|cache|status|monitor|help|--help|-h|--version|-v|--json)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

run_agent() {
    if [[ ! -f "$AGENT_SCRIPT" ]]; then
        echo "${RED}Error: Agent script not found at $AGENT_SCRIPT${RESETBG}" >&2
        exit 1
    fi
    exec bash "$AGENT_SCRIPT" "$@"
}

tool_exists() {
    local tool_name="$1"
    [[ -f "$INSTALL_DIR/tools/$tool_name/$tool_name" && -x "$INSTALL_DIR/tools/$tool_name/$tool_name" ]]
}

main() {
    local first_arg="${1:-}"

    case "$first_arg" in
        ""|start|up|menu)
            [[ -n "$first_arg" ]] && shift
            cmd_start "$@"
            return 0
            ;;
        # Launch flags with no subcommand in front: `gathm --no-browser` is
        # still `gathm`, so start normally rather than calling it unknown.
        --no-gui|--tui-only|--no-browser|--port|--port=*|--host|--host=*)
            cmd_start "$@"
            return 0
            ;;
        tui|pilot|chat)
            shift
            START_GUI=0            # no GUI here, so do not check for its deps
            preflight || exit 1
            echo ""
            launch_pilot "$@"
            ;;
        gui|web|browser)
            shift
            cmd_gui "$@"
            return 0
            ;;
        doctor|check)
            shift
            cmd_doctor "$@"
            return $?
            ;;
        stop)
            stop_gui
            stop_ollama
            return 0
            ;;
        help|-h|--help)
            show_help
            return 0
            ;;
        help-agent)
            run_agent --help
            ;;
        -v|--version)
            echo "gathm v$currentVersion"
            return 0
            ;;
    esac

    if is_agent_subcommand "$first_arg"; then
        run_agent "$@"
    fi

    if tool_exists "$first_arg"; then
        run_agent run "$@"
    fi

    echo "${RED}Unknown command or tool: $first_arg${RESETBG}" >&2
    echo "Use 'gathm --help' to see usage." >&2
    exit 1
}

main "$@"
