#!/usr/bin/env bash
# Author: hakxcore
# Gathm - A modular tool framework

currentVersion="3.0.0"
# Resolve this script through any symlinks before deriving the install dir.
# ~/.local/bin/gathm is a symlink to the checkout, and BASH_SOURCE[0] is the
# *link* path — so a plain dirname pointed INSTALL_DIR at ~/.local/bin and every
# subcommand died on a missing lib/utils.bash. Hand-rolled rather than
# `readlink -f`, which is not portable to macOS's BSD readlink.
_gathm_self="${BASH_SOURCE[0]}"
_gathm_hops=0
while [[ -L "$_gathm_self" && $_gathm_hops -lt 20 ]]; do
    _gathm_link="$(readlink "$_gathm_self")"
    if [[ "$_gathm_link" == /* ]]; then
        _gathm_self="$_gathm_link"
    else
        _gathm_self="$(cd "$(dirname "$_gathm_self")" &>/dev/null && pwd)/$_gathm_link"
    fi
    _gathm_hops=$((_gathm_hops + 1))
done
INSTALL_DIR="$(cd "$(dirname "$_gathm_self")" &>/dev/null && pwd)"
AGENT_SCRIPT="$INSTALL_DIR/agent/orchestrator.sh"
source "$INSTALL_DIR/lib/utils.bash"

# --- Graceful shutdown ---
_gathm_cleanup() {
    clear 2>/dev/null || true
    echo ""
    echo -e "${INDIAN_GREEN}Jai Hind! Gathm signing off.${RESETBG}"
    exit 0
}
trap _gathm_cleanup INT TERM

# Ensure dependencies
check_menu_dependencies() {
    local deps=("dialog" "pv")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &>/dev/null; then
            echo "${RED}Error: $dep is required but not installed.${RESETBG}"
            echo "Please install it using your package manager (e.g., pkg install $dep or apt install $dep)."
            exit 1
        fi
    done
    getConfiguredClient
}

# Dynamic Tool Discovery
scan_tools() {
    tools=()
    tool_descs=()
    
    # Built-in tools
    for dir in "$INSTALL_DIR"/tools/*/; do
        tool_name=$(basename "$dir")
        # Check if a file with the same name as the directory exists, and it's an executable
        if [[ -f "$dir/$tool_name" && -x "$dir/$tool_name" ]]; then
            tools+=("$tool_name")
            # Try to extract description from the tool script (looking for "Description:")
            desc=$(grep -m 1 "Description:" "$dir/$tool_name" | sed 's/Description: //')
            if [[ -z "$desc" ]]; then desc="No description available"; fi
            tool_descs+=("$desc")
        fi
    done
}

# Unified command help
show_help() {
    cat <<EOF
Gathm v$currentVersion

Usage:
  gathm                          Open interactive menu
  gathm menu                     Open interactive menu
  gathm <agent-command> [...]    Run orchestrator command (run/ask/plan/...)
  gathm <tool> [args...]         Shortcut for: gathm run <tool> [args...]

Examples:
  gathm
  gathm menu
  gathm ask "weather in Tokyo"
  gathm run dns -t MX gmail.com
  gathm weather "Paris"
  gathm status

Notes:
  - 'gathm-agent' remains available as a compatibility alias.
  - Run 'gathm help-agent' to display full orchestrator help.
EOF
}

is_agent_subcommand() {
    case "${1:-}" in
        run|ask|plan|engineer|chain|parallel|new-tool|list|health|heal|cache|status|monitor|help|--help|-h|--version|-v|--json)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

run_agent() {
    if [[ ! -f "$AGENT_SCRIPT" ]]; then
        echo "${RED}Error: Agent script not found at $AGENT_SCRIPT${RESETBG}" >&2
        exit 1
    fi
    exec bash "$AGENT_SCRIPT" "$@"
}

tool_exists() {
    local tool_name="$1"
    [[ -f "$INSTALL_DIR/tools/$tool_name/$tool_name" && -x "$INSTALL_DIR/tools/$tool_name/$tool_name" ]]
}

# Main Menu
main_menu() {
    check_menu_dependencies

    while true; do
        scan_tools
        
        # Construct dialog menu items
        menu_items=()
        for i in "${!tools[@]}"; do
            menu_items+=("${tools[$i]}" "${tool_descs[$i]}")
        done
        
        exec 3>&1
        selection=$(dialog \
            --backtitle "Gathm Framework v$currentVersion" \
            --title "Main Menu" \
            --clear \
            --cancel-label "Exit" \
            --menu "Select a tool to run:" 20 70 15 \
            "${menu_items[@]}" \
            2>&1 1>&3)
        exit_status=$?
        exec 3>&-
        
        if [ $exit_status -ne 0 ]; then
            clear
            echo "Goodbye!"
            exit 0
        fi
        
        run_tool "$selection"
    done
}

run_tool() {
    local tool=$1
    local tool_path="$INSTALL_DIR/tools/$tool/$tool"

    # Ask for arguments (dialog may be cancelled with Esc/Cancel)
    local args=""
    exec 3>&1
    args=$(dialog \
        --title "$tool" \
        --inputbox "Enter arguments for $tool (leave empty if none):" 10 60 \
        2>&1 1>&3) || { exec 3>&-; return 0; }
    exec 3>&-

    clear
    print_header
    echo "Running $tool..."
    echo "------------------------------------------------"

    # Run the tool in a subshell; catch errors and interrupts
    (source "$INSTALL_DIR/lib/utils.bash"; "$tool_path" $args) || {
        local rc=$?
        if [[ $rc -eq 130 ]]; then
            echo -e "\n${ORANGE}[!] Tool interrupted.${RESETBG}"
        else
            echo -e "\n${RED}[!] Tool exited with error (code $rc).${RESETBG}"
            echo -e "${GREEN}The Engineer will take care of this shortly.${RESETBG}"
        fi
    }

    echo "------------------------------------------------"
    pause
}

main() {
    local first_arg="${1:-}"

    if [[ -z "$first_arg" || "$first_arg" == "menu" ]]; then
        main_menu
        return 0
    fi

    case "$first_arg" in
        help|-h|--help)
            show_help
            return 0
            ;;
        help-agent)
            run_agent --help
            ;;
        -v|--version)
            echo "gathm v$currentVersion"
            return 0
            ;;
    esac

    if is_agent_subcommand "$first_arg"; then
        run_agent "$@"
    fi

    if tool_exists "$first_arg"; then
        run_agent run "$@"
    fi

    echo "${RED}Unknown command or tool: $first_arg${RESETBG}" >&2
    echo "Use 'gathm --help' to see usage." >&2
    exit 1
}

main "$@"
