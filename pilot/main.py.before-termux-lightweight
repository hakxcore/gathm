def _detect_platform() -> str:
    """Detect platform for the welcome box."""
    import platform
    system = platform.system().lower()
    if system == "darwin":
        return "macOS"
    if system == "linux":
        if shutil.which("termux-setup-storage"):
            return "Termux"
        return "Linux"
    return system

def print_tricolor_banner():
