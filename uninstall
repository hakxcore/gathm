#!/usr/bin/env bash
# Gathm uninstaller: Linux, macOS, Termux, WSL, and Windows Bash environments.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/install_common.bash
source "$SCRIPT_DIR/lib/install_common.bash"

DRY_RUN=0; KEEP_DATA=1; YES=0
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=1 ;;
        --keep-data) KEEP_DATA=1 ;;
        --purge-data) KEEP_DATA=0 ;;
        --yes|-y) YES=1 ;;
        --help|-h)
            printf 'Usage: ./uninstall [--dry-run] [--purge-data|--keep-data] [--yes]\n'
            printf 'Removes owned shortcuts and local virtualenvs; keeps user data by default.\n'
            printf 'Use --purge-data to remove %s (settings, history, lessons, models, runtimes).\n' "$HOME/.gathm"
            printf 'The source checkout, including its .env, is kept.\n'
            exit 0 ;;
        *) printf 'Unknown option: %s (use --help)\n' "$arg" >&2; exit 2 ;;
    esac
done

LOCAL_BIN="$HOME/.local/bin"
DATA_DIR="$HOME/.gathm"
SHORTCUTS=(gathm gathm-agent gathm-api audiocpp_cli)
TARGETS=("$SCRIPT_DIR/gathm" "$SCRIPT_DIR/agent/orchestrator.sh" "$SCRIPT_DIR/api/server.py" "")
REMOVE=()
KEEP_PATH=0
for i in 0 1 2 3; do
    shortcut="$LOCAL_BIN/${SHORTCUTS[$i]}"
    [[ -e "$shortcut" || -L "$shortcut" ]] || continue
    if { [[ "$i" == 3 ]] && gathm_audio_owned "$shortcut"; } \
            || { [[ "$i" != 3 ]] && gathm_shortcut_owned "$shortcut" "${TARGETS[$i]}"; }; then
        REMOVE+=("$shortcut")
    else
        printf 'Keeping command not owned by this checkout: %s\n' "$shortcut"
        KEEP_PATH=1
    fi
done
# Another checkout may use the shared state too. Do not remove its models.
if (( KEEP_PATH )); then
    KEEP_DATA=1
fi
for venv in "$SCRIPT_DIR/pilot/venv" "$SCRIPT_DIR/engineer/venv"; do
    if [[ -L "$venv" ]]; then
        REMOVE+=("$venv") # rm removes the link, never its external target.
    elif [[ -d "$venv" && -f "$venv/pyvenv.cfg" ]]; then
        REMOVE+=("$venv")
    elif [[ -e "$venv" ]]; then
        printf 'Keeping unrecognized environment directory: %s\n' "$venv"
    fi
done
if (( ! KEEP_DATA )) && [[ -e "$DATA_DIR" || -L "$DATA_DIR" ]]; then
    REMOVE+=("$DATA_DIR")
fi

# Only remove the exact two-line block the installer adds. Writing back into
# the original file preserves its mode and any symlink used by dotfile tools.
_strip_path_entry() {
    local rc="$1" tmp
    tmp=$(mktemp) || return 1
    if ! awk '
        function flush() { if (held) { print "# Gathm Framework"; held=0 } }
        held && $0 == "export PATH=\"$HOME/.local/bin:$PATH\"" { held=0; next }
        { flush() }
        $0 == "# Gathm Framework" { held=1; next }
        { print }
        END { flush() }
    ' "$rc" > "$tmp"; then
        rm -f "$tmp"; return 1
    fi
    if ! cmp -s "$tmp" "$rc"; then
        if ! cat "$tmp" > "$rc"; then rm -f "$tmp"; return 1; fi
        printf 'Cleaned Gathm PATH block: %s\n' "$rc"
    fi
    rm -f "$tmp"
}

printf '\nGathm uninstaller (%s)\n' "$(gathm_detect_platform)"
printf 'Files to remove:\n'
# Bash 3.2 with nounset cannot expand an empty array using the usual form.
for path in ${REMOVE[@]+"${REMOVE[@]}"}; do printf '  %s\n' "$path"; done
if (( KEEP_DATA )); then
    printf 'Keeping %s (settings, history, models, runtimes, recovery files).\n' "$DATA_DIR"
else
    printf 'Data removal includes downloaded models, history, and recovery files.\n'
fi
(( KEEP_PATH )) || printf 'The marked Gathm PATH block will be removed from shell startup files.\n'
printf 'Keeping source checkout, external runtimes/models, and ~/.cache/gathm.\n'
if (( DRY_RUN )); then printf 'Dry run: no files or processes changed.\n'; exit 0; fi
if (( ! YES )); then
    if [[ "${GATHM_NON_INTERACTIVE:-0}" == 1 || ! -t 0 ]]; then
        printf 'No confirmation received; use --yes for unattended removal.\n' >&2
        exit 1
    fi
    answer=""
    read -r -p 'Proceed with uninstallation? [y/N]: ' answer || answer=n
    case "$answer" in y|Y|yes|YES) ;; *) printf 'Uninstallation cancelled.\n'; exit 0 ;; esac
fi

# Avoid trusting stale PID files as authority to kill an arbitrary process.
# Only stop a process recorded by this checkout at the same creation time.
_stop_owned_process() {
    local file="$1" pid n=0
    [[ -f "$file" ]] || return 0
    pid=$(cat "$file")
    case "$pid" in ''|*[!0-9]*) return 0 ;; esac
    (( pid > 1 )) || return 0
    kill -0 "$pid" 2>/dev/null || return 0
    if ! gathm_process_owned "$file" "$pid" "$SCRIPT_DIR"; then
        printf 'Process %s has no matching creation record; stop the old Gathm runtime manually.\n' "$pid" >&2
        return 1
    fi
    kill "$pid" 2>/dev/null || return 1
    while kill -0 "$pid" 2>/dev/null && (( n < 5 )); do sleep 1; n=$((n + 1)); done
    if kill -0 "$pid" 2>/dev/null; then
        printf 'Process %s is still stopping; retry uninstall shortly.\n' "$pid" >&2
        return 1
    fi
}
if (( ! KEEP_PATH )) && [[ ! -L "$DATA_DIR" ]]; then
    _stop_owned_process "$DATA_DIR/gui.pid" || exit 1
    _stop_owned_process "$DATA_DIR/ollama.pid" || exit 1
    if [[ -f "$DATA_DIR/llamacpp.pid" ]]; then
        python_cmd=""
        for candidate in "$SCRIPT_DIR/pilot/venv/bin/python3" "$SCRIPT_DIR/pilot/venv/bin/python" \
                "$SCRIPT_DIR/pilot/venv/Scripts/python.exe" python3 python; do
            if command -v "$candidate" >/dev/null 2>&1; then python_cmd="$candidate"; break; fi
        done
        if [[ -n "$python_cmd" && -f "$SCRIPT_DIR/lib/llamacpp.py" ]]; then
            "$python_cmd" "$SCRIPT_DIR/lib/llamacpp.py" stop || exit 1
        else
            _stop_owned_process "$DATA_DIR/llamacpp.pid" || exit 1
        fi
    fi
fi

errors=0
for path in ${REMOVE[@]+"${REMOVE[@]}"}; do
    if rm -rf -- "$path"; then printf 'Removed %s\n' "$path"
    else printf 'Could not remove %s\n' "$path" >&2; errors=$((errors + 1)); fi
done
if (( ! KEEP_PATH )); then
    for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile"; do
        [[ -f "$rc" ]] || continue
        _strip_path_entry "$rc" || errors=$((errors + 1))
    done
fi
if (( errors )); then
    printf 'Uninstall incomplete: %s removal(s) failed.\n' "$errors" >&2
    exit 1
fi
printf '\nUninstall complete. Source checkout retained: %s\n' "$SCRIPT_DIR"
printf 'Open a new terminal to refresh command lookup.\n'
