#!/usr/bin/env bash
## Author: Hakxcore https://github.com/hakxcore
## Gathm Uninstaller — supports Termux, macOS, Linux (all distros), WSL, Git Bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

# ── Colors ────────────────────────────────────────────────────────────
if [[ "${TERM:-dumb}" != "dumb" ]]; then
    RED="\033[31m"; GREEN="\033[32m"; YELLOW="\033[33m"
    BLUE="\033[34m"; BOLD="\033[1m"; RESET="\033[0m"
else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; BOLD=""; RESET=""
fi

info()  { echo -e "${BLUE}[*]${RESET} $1"; }
ok()    { echo -e "${GREEN}[+]${RESET} $1"; }
warn()  { echo -e "${YELLOW}[!]${RESET} $1"; }
fail()  { echo -e "${RED}[-]${RESET} $1"; }

# ── Platform detection ────────────────────────────────────────────────
detect_platform() {
    # Termux (Android)
    if [[ "$OSTYPE" == linux-android* ]] || command -v termux-setup-storage &>/dev/null; then
        echo "termux"; return
    fi
    case "$(uname -s 2>/dev/null)" in
        Darwin) echo "macos"; return ;;
        MINGW*|MSYS*|CYGWIN*) echo "windows"; return ;;
    esac
    if [[ -f /proc/version ]] && grep -qi microsoft /proc/version 2>/dev/null; then
        echo "wsl"; return
    fi
    echo "linux"
}

PLATFORM=$(detect_platform)

# ── What install actually puts on disk ───────────────────────────────
LOCAL_BIN="$HOME/.local/bin"
DATA_DIR="$HOME/.gathm"
PILOT_VENV="$SCRIPT_DIR/pilot/venv"

SHORTCUTS=("$LOCAL_BIN/gathm" "$LOCAL_BIN/gathm-agent" "$LOCAL_BIN/gathm-api" "$LOCAL_BIN/audiocpp_cli")

# audio.cpp speech runtime source tree. install clones it into ~/.gathm by
# default (so it goes with DATA_DIR below), but reuses an existing ~/audio.cpp
# checkout if one is there. Only the copy we created is removed — a checkout
# the user made themselves is left alone.
if [[ -n "${GATHM_AUDIOCPP_SRC:-}" ]]; then
    AUDIOCPP_SRC="$GATHM_AUDIOCPP_SRC"
elif [[ -d "$HOME/audio.cpp/.git" ]]; then
    AUDIOCPP_SRC="$HOME/audio.cpp"
else
    AUDIOCPP_SRC="$DATA_DIR/audio.cpp"
fi

# Shell RC files that may contain the PATH entry added by install
RC_FILES=(
    "$HOME/.zshrc"
    "$HOME/.bashrc"
    "$HOME/.bash_profile"
    "$HOME/.profile"
)

# ── Preview what will be removed ─────────────────────────────────────
echo ""
echo -e "${BOLD}Gathm Uninstaller${RESET}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "  Platform : ${GREEN}${PLATFORM}${RESET}"
echo ""
echo "  The following will be removed:"
for s in "${SHORTCUTS[@]}"; do
    [[ -f "$s" ]] && echo "    • $s" || echo "    • $s  (not found — skip)"
done
[[ -d "$DATA_DIR"    ]] && echo "    • $DATA_DIR  (config & logs)"   || echo "    • $DATA_DIR  (not found — skip)"
[[ -d "$PILOT_VENV"  ]] && echo "    • $PILOT_VENV  (Python venv)"  || echo "    • $PILOT_VENV  (not found — skip)"
echo "    • PATH entry from shell RC files"

# Call out the llama.cpp runtime and the model weights for the same reason as
# audio.cpp below: both live inside DATA_DIR, and a GGUF can be twenty
# gigabytes that took an hour to download. Nobody should discover that after
# answering "y".
LLAMACPP_DIR="${GATHM_LLAMACPP_DIR:-$DATA_DIR/llamacpp}"
MODELS_DIR="${GATHM_LLAMACPP_MODEL_DIR:-$DATA_DIR/models}"
_dir_size() { du -sh "$1" 2>/dev/null | awk '{print $1}'; }
if [[ -d "$MODELS_DIR" ]]; then
    if [[ "$MODELS_DIR" == "$DATA_DIR/"* ]]; then
        echo -e "    • $MODELS_DIR  ${YELLOW}(model weights, $(_dir_size "$MODELS_DIR") — goes with $DATA_DIR)${RESET}"
    else
        echo -e "    ${GREEN}Kept:${RESET} $MODELS_DIR  (your own model directory)"
    fi
fi
if [[ -d "$LLAMACPP_DIR" && "$LLAMACPP_DIR" == "$DATA_DIR/"* ]]; then
    echo -e "    • $LLAMACPP_DIR  ${YELLOW}(llama.cpp runtime — goes with $DATA_DIR)${RESET}"
fi
# A llama.cpp installed by Homebrew or a package manager is the system's, not
# ours; say so rather than leaving the user to wonder.
if command -v llama-server &>/dev/null; then
    echo -e "    ${GREEN}Kept:${RESET} $(command -v llama-server)  (installed outside Gathm)"
fi

# Call out the audio.cpp build explicitly: it is removed only as part of
# DATA_DIR, and rebuilding it costs 20-60 min on a phone.
if [[ -d "$AUDIOCPP_SRC" ]]; then
    if [[ "$AUDIOCPP_SRC" == "$DATA_DIR/"* ]]; then
        echo -e "    • $AUDIOCPP_SRC  ${YELLOW}(audio.cpp build — goes with $DATA_DIR)${RESET}"
    else
        echo -e "    ${GREEN}Kept:${RESET} $AUDIOCPP_SRC  (your own audio.cpp checkout)"
    fi
fi
echo ""

read -r -p "$(echo -e "${YELLOW}> Proceed with uninstallation? [y/N]: ${RESET}")" answer </dev/tty || answer="n"
if [[ ! "$answer" =~ ^[Yy]$ ]]; then
    echo -e "${GREEN}> Uninstallation cancelled.${RESET}"
    exit 0
fi

echo ""

# ── Remove command shortcuts ──────────────────────────────────────────
for s in "${SHORTCUTS[@]}"; do
    if [[ -f "$s" || -L "$s" ]]; then
        rm -f "$s" && ok "Removed $s" || warn "Could not remove $s"
    else
        info "Skipping $s (not found)"
    fi
done

# ── Stop the model server before its weights disappear ────────────────
# Deleting the GGUF out from under a running llama-server leaves a process
# holding a deleted file and a port nothing explains.
if [[ -f "$SCRIPT_DIR/lib/llamacpp.py" ]] && command -v python3 &>/dev/null; then
    python3 "$SCRIPT_DIR/lib/llamacpp.py" stop >/dev/null 2>&1 \
        && info "Stopped the llama.cpp server" || true
fi

# ── Remove data directory ─────────────────────────────────────────────
if [[ -d "$DATA_DIR" ]]; then
    rm -rf "$DATA_DIR" && ok "Removed $DATA_DIR" || warn "Could not remove $DATA_DIR"
else
    info "Skipping $DATA_DIR (not found)"
fi

# ── Remove pilot venv ─────────────────────────────────────────────────
if [[ -d "$PILOT_VENV" ]]; then
    rm -rf "$PILOT_VENV" && ok "Removed $PILOT_VENV" || warn "Could not remove $PILOT_VENV"
else
    info "Skipping $PILOT_VENV (not found)"
fi

# ── Remove PATH entry from shell RC files ────────────────────────────
_strip_path_entry() {
    local rc="$1"
    [[ ! -f "$rc" ]] && return
    # Remove the two lines install adds:
    #   # Gathm Framework
    #   export PATH="$HOME/.local/bin:$PATH"
    local tmp
    tmp=$(mktemp)
    # Use grep -v to strip both the comment and the PATH export line
    grep -v '# Gathm Framework' "$rc" \
        | grep -v 'export PATH="$HOME/.local/bin:$PATH"' \
        > "$tmp" && mv "$tmp" "$rc" || { rm -f "$tmp"; return 1; }
}

for rc in "${RC_FILES[@]}"; do
    if [[ -f "$rc" ]] && grep -q 'Gathm Framework\|\.local/bin.*PATH' "$rc" 2>/dev/null; then
        _strip_path_entry "$rc" && ok "Cleaned PATH entry from $rc" || warn "Could not clean $rc"
    fi
done

# ── Done ─────────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}${GREEN}━━━━━━━━━━ UNINSTALLED ━━━━━━━━━━${RESET}"
echo "  Gathm shortcuts and data have been removed."
echo "  The source directory was NOT deleted: $SCRIPT_DIR"
echo ""
echo -e "  ${YELLOW}Note:${RESET} Open a new terminal (or run ${BOLD}source ~/.zshrc${RESET}) to"
echo "  refresh your PATH."
echo ""
